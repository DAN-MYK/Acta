{
  "name": "acta-tauri-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 1420",
    "dev:guard": "node scripts/ensure-vite-dev.mjs",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:encoding": "node scripts/check-text-encoding.mjs",
    "test:frontend": "vitest run --config vitest.config.mjs",
    "test:e2e": "npm --prefix e2e-tests test",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "svelte": "^4.2.18"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@tauri-apps/cli": "^2.0.0",
    "@tsconfig/svelte": "^5.0.4",
    "jsdom": "^24.1.3",
    "svelte-check": "^3.8.6",
    "typescript": "^5.9.3",
    "vite": "^5.4.0",
    "vitest": "^3.2.4"
  }
}
