{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowJs": false,
    "checkJs": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["svelte", "node", "vitest/globals"]
  },
  "include": ["frontend/src/**/*.ts", "frontend/src/**/*.svelte", "vite.config.ts"]
}
