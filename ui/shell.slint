// Acta — App Shell: Sidebar navigation + top header + command palette
// Aesthetic: hairline border between sidebar and main, flat avatar, no gradients.

import { AppTheme } from "design-tokens.slint";
import { NavScreen, PaletteItemData, CompanySwitcherItem } from "types.slint";
import { Card, VDivider, HDivider, IconButton, KbdHint, SearchInput, Avatar, GhostButton, SecondaryButton, InlineIcon } from "components.slint";

// ── Skip Navigation ───────────────────────────────────────────────────────────
component SkipNav inherits Rectangle {
    callback activated;

    height: scope.has-focus ? 36px : 1px;
    width: scope.has-focus ? 260px : 1px;
    clip: true;
    z: 200;
    background: transparent;

    scope := FocusScope {
        width: parent.width;
        height: 36px;
        accessible-role: button;
        accessible-label: "Перейти до основного контенту";
        key-pressed(e) => {
            if e.text == "\n" || e.text == " " {
                root.activated();
                accept
            } else {
                reject
            }
        }
    }

    Rectangle {
        visible: scope.has-focus;
        background: AppTheme.accent;
        border-radius: AppTheme.radius-md;
        border-width: 2px;
        border-color: AppTheme.accent-hover;
        width: 220px;
        height: 36px;
        x: AppTheme.sp-2;
        y: 0;

        Text {
            text: "Перейти до основного контенту";
            color: #ffffff;
            font-size: 12px;
            font-family: AppTheme.font-sans;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

// ── Sidebar navigation item ───────────────────────────────────────────────────
component NavItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> active: false;
    in property <int> badge-count: 0;
    callback clicked;

    accessible-role: button;
    accessible-label: root.label;

    height: 36px;
    border-radius: AppTheme.radius-lg;
    background: active ? AppTheme.bg-elevated : (nav-touch.has-hover ? AppTheme.bg-hover : transparent);
    border-width: active ? 1px : 0px;
    border-color: AppTheme.border;

    HorizontalLayout {
        padding-top: 4px;
        padding-bottom: 4px;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        alignment: stretch;

        InlineIcon {
            icon: root.icon;
            icon-size: 15px;
            tint: active ? AppTheme.text : AppTheme.text-faint;
        }

        Text {
            text: root.label;
            color: active ? AppTheme.text : AppTheme.text-muted;
            font-size: AppTheme.font-body;
            font-family: AppTheme.font-sans;
            font-weight: active ? 500 : 400;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        if badge-count > 0 : Rectangle {
            width: max(18px, badge-label.preferred-width + 12px);
            height: 17px;
            border-radius: 4px;
            background: AppTheme.bg-subtle;

            badge-label := Text {
                text: badge-count;
                color: AppTheme.text-muted;
                font-size: 10.5px;
                font-family: AppTheme.font-mono;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
    }

    nav-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ── Saved views item ──────────────────────────────────────────────────────────
component SavedViewItem inherits Rectangle {
    in property <string> label;
    in property <int> count;
    in property <image> star-icon;
    callback clicked;

    height: 24px;
    border-radius: AppTheme.radius-sm;
    background: svi-touch.has-hover ? AppTheme.bg-hover : transparent;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        alignment: stretch;

        InlineIcon {
            icon: root.star-icon;
            icon-size: 11px;
            tint: AppTheme.text-faint;
        }

        Text {
            text: root.label;
            color: svi-touch.has-hover ? AppTheme.text : AppTheme.text-muted;
            font-size: 12px;
            font-family: AppTheme.font-sans;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        Text {
            text: root.count;
            color: AppTheme.text-faint;
            font-size: 10.5px;
            font-family: AppTheme.font-mono;
            vertical-alignment: center;
            horizontal-alignment: right;
            width: 20px;
        }
    }

    svi-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component CompanySwitcherRow inherits Rectangle {
    in property <CompanySwitcherItem> company;
    callback selected(string);

    accessible-role: button;
    accessible-label: root.company.name;

    height: 46px;
    border-radius: AppTheme.radius-lg;
    background:
        root.company.active ? AppTheme.accent-soft :
        (company-row-hover.has-hover ? AppTheme.bg-hover : transparent);
    border-width: root.company.active ? 1px : 0px;
    border-color: root.company.active ? AppTheme.accent.with-alpha(0.35) : transparent;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        alignment: stretch;

        Rectangle {
            width: 30px;
            height: 30px;
            border-radius: 8px;
            background: root.company.active ? AppTheme.accent : AppTheme.bg-subtle;

            Text {
                text: root.company.initials;
                color: root.company.active ? #ffffff : AppTheme.text;
                font-size: 11px;
                font-family: AppTheme.font-sans;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;

            Text {
                text: root.company.name;
                color: AppTheme.text;
                font-size: 12.5px;
                font-family: AppTheme.font-sans;
                font-weight: root.company.active ? 600 : 500;
                overflow: elide;
            }

            Text {
                text: root.company.subtitle;
                color: AppTheme.text-faint;
                font-size: 10.5px;
                font-family: AppTheme.font-sans;
                overflow: elide;
            }
        }

        if root.company.badge != "" : Rectangle {
            height: 18px;
            border-radius: 9px;
            background: root.company.active ? AppTheme.accent : AppTheme.bg-subtle;
            min-width: badge-label.preferred-width + 14px;

            badge-label := Text {
                text: root.company.badge;
                color: root.company.active ? #ffffff : AppTheme.text-muted;
                font-size: 10px;
                font-family: AppTheme.font-sans;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
    }

    company-row-hover := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.selected(root.company.id); }
    }
}

// ── Palette item ──────────────────────────────────────────────────────────────
component PaletteItem inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <string> kbd: "";
    in property <string> meta: "";
    callback clicked;

    height: 36px;
    background: pi-touch.has-hover ? AppTheme.bg-subtle : transparent;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 10px;
        alignment: stretch;

        InlineIcon {
            icon: root.icon;
            icon-size: 14px;
            tint: pi-touch.has-hover ? AppTheme.text : AppTheme.text-muted;
        }

        Text {
            text: root.label;
            color: AppTheme.text;
            font-size: 13px;
            font-family: AppTheme.font-sans;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        if meta != "" : Text {
            text: root.meta;
            color: AppTheme.text-faint;
            font-size: 11.5px;
            font-family: AppTheme.font-mono;
            vertical-alignment: center;
        }

        if kbd != "" : Rectangle {
            height: 18px;
            min-width: kbd-text.preferred-width + 10px;
            border-width: 1px;
            border-color: AppTheme.border;
            border-radius: 3px;
            background: AppTheme.bg-subtle;

            kbd-text := Text {
                text: root.kbd;
                color: AppTheme.text-faint;
                font-size: 10px;
                font-family: AppTheme.font-mono;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    pi-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ── Command Palette ────────────────────────────────────────────────────────────
export component CommandPalette inherits Rectangle {
    in-out property <bool> open: false;
    in-out property <string> query: "";
    in property <[PaletteItemData]> items;
    in property <image> search-icon;
    in property <image> close-icon;
    in property <image> enter-icon;
    callback closed;
    callback navigated(NavScreen);
    callback query-changed(string);
    callback item-activated(string);

    visible: open;
    x: 0;
    y: 0;
    width: 100%;
    height: 100%;
    background: #0a0b0d.with-alpha(0.35);

    // Backdrop click to close
    TouchArea {
        clicked => { root.closed(); }
    }

    // Palette box — centered horizontally, near top
    palette := Rectangle {
        x: (root.width - self.width) / 2;
        y: 120px;
        width: 620px;
        max-height: 480px;
        background: AppTheme.bg-elevated;
        border-width: 1px;
        border-color: AppTheme.border;
        border-radius: 12px;
        // Floating surface — shadow allowed here
        drop-shadow-blur: 24px;
        drop-shadow-color: #1e1e1e.with-alpha(0.08);

        // Prevent backdrop click from closing when clicking inside
        TouchArea { }

        VerticalLayout {
            // Search input row
            HorizontalLayout {
                padding: 14px;
                padding-top: 14px;
                padding-bottom: 14px;
                spacing: 10px;
                height: 52px;

                InlineIcon {
                    icon: root.search-icon;
                    icon-size: 16px;
                    tint: AppTheme.text-faint;
                }

                search-field := TextInput {
                    text: root.query;
                    color: AppTheme.text;
                    font-size: 14px;
                    font-family: AppTheme.font-sans;
                    single-line: true;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    accessible-label: "Пошук команд";
                    init => { self.focus(); }
                    edited => { root.query = self.text; root.query-changed(self.text); }
                    key-pressed(e) => {
                        if e.text == Key.Escape {
                            root.closed();
                            accept
                        } else {
                            reject
                        }
                    }
                }

                // Placeholder overlay shown when field is empty
                if root.query == "" : Text {
                    text: "Пошук команди, документа, контрагента…";
                    color: AppTheme.text-faint;
                    font-size: 14px;
                    font-family: AppTheme.font-sans;
                    vertical-alignment: center;
                    accessible-role: none;
                }

                Rectangle {
                    width: 30px;
                    height: 16px;
                    border-width: 1px;
                    border-color: AppTheme.border;
                    border-radius: 3px;
                    background: transparent;

                    Text {
                        text: "esc";
                        color: AppTheme.text-faint;
                        font-size: 10px;
                        font-family: AppTheme.font-mono;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }
            }

            HDivider { }

            if root.items.length > 0 : VerticalLayout {
                padding-top: 6px;
                padding-bottom: 6px;

                for item in root.items : Rectangle {
                    height: item.kind == "header" ? 28px : 46px;
                    background: row-touch.has-hover && item.kind != "header" ? AppTheme.bg-hover : transparent;

                    if item.kind == "header" : Text {
                        text: item.title;
                        x: 16px;
                        width: parent.width - 32px;
                        height: parent.height;
                        color: AppTheme.text-faint;
                        font-size: 10px;
                        font-family: AppTheme.font-sans;
                        font-weight: 600;
                        letter-spacing: 1.2px;
                        vertical-alignment: center;
                    }

                    if item.kind != "header" : HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 10px;

                        InlineIcon {
                            icon: root.enter-icon;
                            icon-size: 15px;
                            tint: AppTheme.text-faint;
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;

                            Text {
                                text: item.title;
                                color: AppTheme.text;
                                font-size: 13px;
                                font-family: AppTheme.font-sans;
                                overflow: elide;
                            }

                            if item.subtitle != "" : Text {
                                text: item.subtitle;
                                color: AppTheme.text-faint;
                                font-size: 11px;
                                font-family: AppTheme.font-sans;
                                overflow: elide;
                            }
                        }

                        if item.shortcut != "" : KbdHint { key: item.shortcut; }
                    }

                    row-touch := TouchArea {
                        mouse-cursor: item.kind == "header" ? default : pointer;
                        clicked => {
                            if item.kind != "header" {
                                root.item-activated(item.payload);
                                root.closed();
                            }
                        }
                    }
                }
            }

            // Navigation shortcuts section
            if root.items.length == 0 : VerticalLayout {
                padding-top: 6px;
                padding-bottom: 6px;

                // Section label
                Text {
                    text: "ПЕРЕХІД";
                    color: AppTheme.text-faint;
                    font-size: 10px;
                    font-family: AppTheme.font-sans;
                    font-weight: 600;
                    letter-spacing: 1.2px;
                    x: 16px;
                    width: parent.width - 16px;
                    height: 28px;
                    vertical-alignment: center;
                }

                // Nav items
                palette-nav-home := PaletteItem {
                    icon: root.enter-icon;
                    label: "Головна";
                    kbd: "G H";
                    clicked => { root.navigated(NavScreen.Dashboard); root.closed(); }
                }
                palette-nav-docs := PaletteItem {
                    icon: root.enter-icon;
                    label: "Документи";
                    kbd: "G D";
                    clicked => { root.navigated(NavScreen.Documents); root.closed(); }
                }
                palette-nav-cp := PaletteItem {
                    icon: root.enter-icon;
                    label: "Контрагенти";
                    kbd: "G C";
                    clicked => { root.navigated(NavScreen.Counterparties); root.closed(); }
                }
                palette-nav-pay := PaletteItem {
                    icon: root.enter-icon;
                    label: "Платежі";
                    kbd: "G P";
                    clicked => { root.navigated(NavScreen.Payments); root.closed(); }
                }
                palette-nav-rep := PaletteItem {
                    icon: root.enter-icon;
                    label: "Звіти";
                    kbd: "G R";
                    clicked => { root.navigated(NavScreen.Reports); root.closed(); }
                }
                palette-nav-tasks := PaletteItem {
                    icon: root.enter-icon;
                    label: "Задачі";
                    kbd: "G T";
                    clicked => { root.navigated(NavScreen.Tasks); root.closed(); }
                }
            }

            HDivider { }

            // Footer hints
            Rectangle {
                height: 34px;
                background: AppTheme.bg-subtle;
                border-radius: 12px;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 12px;
                    alignment: center;

                    HorizontalLayout {
                        spacing: 4px;
                        KbdHint { key: "↑"; }
                        KbdHint { key: "↓"; }
                        Text {
                            text: "навігація";
                            color: AppTheme.text-faint;
                            font-size: 11px;
                            font-family: AppTheme.font-sans;
                            vertical-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        spacing: 4px;
                        KbdHint { key: "↵"; }
                        Text {
                            text: "вибрати";
                            color: AppTheme.text-faint;
                            font-size: 11px;
                            font-family: AppTheme.font-sans;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}

// ── Keyboard Help Overlay ─────────────────────────────────────────────────────
// Shows keyboard shortcuts cheatsheet. Triggered by Ctrl+/.
component KeyboardHelp {
    callback closed;

    x: 0; y: 0;
    width: 100%;
    height: 100%;

    // backdrop
    Rectangle {
        background: #0a0b0d.with-alpha(0.35);
    }

    // Backdrop click to close
    TouchArea {
        clicked => { root.closed(); }
    }

    // Focus trap — grabs focus when open, Escape closes
    help-scope := FocusScope {
        width: parent.width;
        height: parent.height;
        accessible-role: none;
        accessible-label: "Гарячі клавіші — натисніть Escape для закриття";
        init => { self.focus(); }
        key-pressed(e) => {
            if e.text == Key.Escape {
                root.closed();
                accept
            } else {
                reject
            }
        }
    }

    // Dialog box
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 560px;
        background: AppTheme.bg-elevated;
        border-width: 1px;
        border-color: AppTheme.border;
        border-radius: 12px;
        drop-shadow-blur: 24px;
        drop-shadow-color: #1e1e1e.with-alpha(0.08);

        // prevent backdrop click when clicking inside dialog
        TouchArea { }

        VerticalLayout {
            padding: 24px;
            spacing: 16px;

            // ── Header ────────────────────────────────────────────────────
            HorizontalLayout {
                alignment: stretch;
                height: 24px;

                Text {
                    text: "Гарячі клавіші";
                    font-size: 15px;
                    font-family: AppTheme.font-sans;
                    font-weight: 600;
                    color: AppTheme.text;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                // Esc badge
                Rectangle {
                    width: 28px;
                    height: 18px;
                    border-radius: 3px;
                    border-width: 1px;
                    border-color: AppTheme.border;
                    background: AppTheme.bg-subtle;

                    Text {
                        text: "esc";
                        font-size: 10px;
                        font-family: AppTheme.font-mono;
                        color: AppTheme.text-faint;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }
            }

            HDivider { }

            // ── Two-column layout ─────────────────────────────────────────
            HorizontalLayout {
                spacing: 24px;

                // ── Column 1: Navigation ──────────────────────────────────
                VerticalLayout {
                    spacing: 6px;
                    horizontal-stretch: 1;

                    Text {
                        text: "НАВІГАЦІЯ";
                        color: AppTheme.text-faint;
                        font-size: 10px;
                        font-family: AppTheme.font-sans;
                        font-weight: 600;
                        letter-spacing: 1.2px;
                        height: 22px;
                        vertical-alignment: center;
                    }

                    for row in [
                        { k: "Ctrl+1", d: "Головна" },
                        { k: "Ctrl+2", d: "Документи" },
                        { k: "Ctrl+3", d: "Контрагенти" },
                        { k: "Ctrl+4", d: "Платежі" },
                        { k: "Ctrl+5", d: "Звіти" },
                        { k: "Ctrl+6", d: "Задачі" },
                        { k: "Ctrl+7", d: "Налаштування" },
                    ] : HorizontalLayout {
                        spacing: 10px;
                        height: 24px;
                        alignment: stretch;

                        KbdHint { key: row.k; }

                        Text {
                            text: row.d;
                            color: AppTheme.text-muted;
                            font-size: 12px;
                            font-family: AppTheme.font-sans;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                }

                // ── Column 2: Actions ─────────────────────────────────────
                VerticalLayout {
                    spacing: 6px;
                    horizontal-stretch: 1;

                    Text {
                        text: "ДІЇ";
                        color: AppTheme.text-faint;
                        font-size: 10px;
                        font-family: AppTheme.font-sans;
                        font-weight: 600;
                        letter-spacing: 1.2px;
                        height: 22px;
                        vertical-alignment: center;
                    }

                    for row in [
                        { k: "Ctrl+K", d: "Командна палітра" },
                        { k: "Ctrl+/", d: "Гарячі клавіші" },
                        { k: "Tab",    d: "Наступний елемент" },
                        { k: "Shift+Tab", d: "Попередній елемент" },
                        { k: "Enter",  d: "Підтвердити / відкрити" },
                        { k: "Esc",    d: "Закрити / скасувати" },
                        { k: "G H",    d: "Палітра → Головна" },
                    ] : HorizontalLayout {
                        spacing: 10px;
                        height: 24px;
                        alignment: stretch;

                        KbdHint { key: row.k; }

                        Text {
                            text: row.d;
                            color: AppTheme.text-muted;
                            font-size: 12px;
                            font-family: AppTheme.font-sans;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
        }
    }
}

// ── Shell ─────────────────────────────────────────────────────────────────────
export component Shell inherits Rectangle {
    // Navigation state — set by Rust
    in-out property <NavScreen> current-screen: NavScreen.Dashboard;

    private property <string> screen-title:
        current-screen == NavScreen.Dashboard      ? "Головна" :
        current-screen == NavScreen.Documents      ? "Документи" :
        current-screen == NavScreen.Counterparties ? "Контрагенти" :
        current-screen == NavScreen.Payments       ? "Платежі" :
        current-screen == NavScreen.Reports        ? "Звіти" :
        current-screen == NavScreen.Tasks          ? "Задачі" :
        current-screen == NavScreen.Settings       ? "Налаштування" :
        "Головна";

    private property <string> screen-subtitle:
        current-screen == NavScreen.Dashboard      ? "Огляд фінансового стану компанії" :
        current-screen == NavScreen.Documents      ? "Акти, накладні та рахунки" :
        current-screen == NavScreen.Counterparties ? "Клієнти та постачальники" :
        current-screen == NavScreen.Payments       ? "Надходження та витрати" :
        current-screen == NavScreen.Reports        ? "Аналіз доходів і витрат" :
        current-screen == NavScreen.Tasks          ? "Завдання та нагадування" :
        current-screen == NavScreen.Settings       ? "Налаштування системи" :
        "";

    // Theme
    in-out property <bool> is-dark: AppTheme.is-dark;

    // Company info
    in property <string> company-name: "";
    in property <string> app-subtitle: "Acta · упр. облік";
    in property <[CompanySwitcherItem]> company-items;
    in property <string> user-name: "";
    in property <string> user-role: "";
    in property <string> user-initials: "";

    // Notification badge counts
    in property <int> documents-badge: 0;
    in property <int> tasks-badge: 0;

    // Command palette
    in-out property <bool> cmd-palette-open: false;
    in-out property <string> cmd-palette-query: "";
    in property <[PaletteItemData]> cmd-palette-items;

    // Keyboard shortcuts help overlay
    private property <bool> shortcuts-open: false;
    private property <bool> company-switcher-open: false;
    changed shortcuts-open => {
        if !root.shortcuts-open { nav-scope.focus(); }
    }
    changed cmd-palette-open => {
        if !root.cmd-palette-open { nav-scope.focus(); }
    }

    // Icon assets — loaded from project/ui/assets/icons/
    in property <image> icon-home;
    in property <image> icon-documents;
    in property <image> icon-counterparties;
    in property <image> icon-payments;
    in property <image> icon-reports;
    in property <image> icon-tasks;
    in property <image> icon-settings;
    in property <image> icon-search;
    in property <image> icon-bell;
    in property <image> icon-sun;
    in property <image> icon-moon;
    in property <image> icon-chevron-down;
    in property <image> icon-plus;
    in property <image> icon-star;
    in property <image> icon-more;
    in property <image> icon-close;
    in property <image> icon-enter;
    in property <image> logo;

    // Callbacks to Rust
    callback navigate(NavScreen);
    callback company-selected(string);
    callback company-manage-requested;
    callback toggle-theme;
    callback open-cmd-palette;
    callback close-cmd-palette;
    callback cmd-palette-query-changed(string);
    callback cmd-palette-item-activated(string);

    background: AppTheme.bg;

    skip-nav := SkipNav {
        x: 0;
        y: 12px;
        activated => { content-area.focus(); }
    }

    HorizontalLayout {
        spacing: 0px;

        // ── Sidebar ────────────────────────────────────────────────────────
        sidebar := Rectangle {
            width: 252px;
            background: AppTheme.bg-sidebar;

            // Right hairline border
            Rectangle {
                x: parent.width - 1px;
                y: 0;
                width: 1px;
                height: parent.height;
                background: AppTheme.border;
            }

            VerticalLayout {
                padding: 14px;
                padding-top: 24px;
                padding-bottom: 18px;
                spacing: 0px;

                // ── Company switcher ───────────────────────────────────────
                company-btn := Rectangle {
                    height: 56px;
                    border-radius: AppTheme.radius-xl;
                    background: company-hover.has-hover ? AppTheme.bg-elevated : AppTheme.bg.with-alpha(0.32);
                    border-width: 1px;
                    border-color: company-hover.has-hover ? AppTheme.border-strong : AppTheme.border;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 12px;
                        alignment: stretch;

                        // Brand mark — accent square with "A" glyph
                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 8px;
                            background: AppTheme.accent;

                            Text {
                                text: "A";
                                color: #ffffff;
                                font-size: 15px;
                                font-family: AppTheme.font-sans;
                                font-weight: 700;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;

                            Text {
                                text: root.company-name;
                                color: AppTheme.text;
                                font-size: 13px;
                                font-family: AppTheme.font-sans;
                                font-weight: 500;
                                overflow: elide;
                            }

                            Text {
                                text: root.app-subtitle;
                                color: AppTheme.text-faint;
                                font-size: 10.5px;
                                font-family: AppTheme.font-sans;
                            }
                        }

                        InlineIcon {
                            icon: root.icon-chevron-down;
                            icon-size: 13px;
                            tint: AppTheme.text-faint;
                        }
                    }

                    company-hover := TouchArea {
                        mouse-cursor: pointer;
                        accessible-role: button;
                        accessible-label: "Компанія: \{root.company-name}";
                        clicked => { root.company-switcher-open = !root.company-switcher-open; }
                    }
                }

                Rectangle { height: 14px; }

                // ── Search trigger ─────────────────────────────────────────
                search-btn := Rectangle {
                    height: 38px;
                    border-radius: AppTheme.radius-lg;
                    background: AppTheme.bg-elevated;
                    border-width: 1px;
                    border-color: AppTheme.border;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 10px;
                        spacing: 10px;
                        alignment: stretch;

                        InlineIcon {
                            icon: root.icon-search;
                            icon-size: 14px;
                            tint: AppTheme.text-faint;
                        }

                        Text {
                            text: "Пошук…";
                            color: AppTheme.text-faint;
                            font-size: 12.5px;
                            font-family: AppTheme.font-sans;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        HorizontalLayout {
                            spacing: 2px;
                            KbdHint { key: "⌘"; }
                            KbdHint { key: "K"; }
                        }
                    }

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.open-cmd-palette(); }
                    }
                }

                Rectangle { height: 18px; }

                // ── Primary navigation ─────────────────────────────────────
                // Epic 10: Keyboard shortcuts — Alt+1..6 для навігації
                VerticalLayout {
                    spacing: 6px;

                    nav-home := NavItem {
                        label: "Головна";
                        icon: root.icon-home;
                        active: root.current-screen == NavScreen.Dashboard;
                        clicked => { root.navigate(NavScreen.Dashboard); }
                    }

                    nav-docs := NavItem {
                        label: "Документи";
                        icon: root.icon-documents;
                        active: root.current-screen == NavScreen.Documents;
                        badge-count: root.documents-badge;
                        clicked => { root.navigate(NavScreen.Documents); }
                    }

                    nav-cp := NavItem {
                        label: "Контрагенти";
                        icon: root.icon-counterparties;
                        active: root.current-screen == NavScreen.Counterparties;
                        clicked => { root.navigate(NavScreen.Counterparties); }
                    }

                    nav-pay := NavItem {
                        label: "Платежі";
                        icon: root.icon-payments;
                        active: root.current-screen == NavScreen.Payments;
                        clicked => { root.navigate(NavScreen.Payments); }
                    }

                    nav-rep := NavItem {
                        label: "Звіти";
                        icon: root.icon-reports;
                        active: root.current-screen == NavScreen.Reports;
                        clicked => { root.navigate(NavScreen.Reports); }
                    }

                    nav-tasks := NavItem {
                        label: "Задачі";
                        icon: root.icon-tasks;
                        active: root.current-screen == NavScreen.Tasks;
                        badge-count: root.tasks-badge;
                        clicked => { root.navigate(NavScreen.Tasks); }
                    }
                }

                // Epic 10: Keyboard navigation hotkeys
                nav-scope := FocusScope {
                    init => { self.focus(); }
                    key-pressed(e) => {
                        if (e.text == Key.Escape && root.company-switcher-open) {
                            root.company-switcher-open = false;
                            return accept;
                        }
                        if (e.text == "1" && e.modifiers.control) {
                            root.navigate(NavScreen.Dashboard);
                            return accept;
                        }
                        if (e.text == "2" && e.modifiers.control) {
                            root.navigate(NavScreen.Documents);
                            return accept;
                        }
                        if (e.text == "3" && e.modifiers.control) {
                            root.navigate(NavScreen.Counterparties);
                            return accept;
                        }
                        if (e.text == "4" && e.modifiers.control) {
                            root.navigate(NavScreen.Payments);
                            return accept;
                        }
                        if (e.text == "5" && e.modifiers.control) {
                            root.navigate(NavScreen.Reports);
                            return accept;
                        }
                        if (e.text == "6" && e.modifiers.control) {
                            root.navigate(NavScreen.Tasks);
                            return accept;
                        }
                        if (e.text == "7" && e.modifiers.control) {
                            root.navigate(NavScreen.Settings);
                            return accept;
                        }
                        // Cmd/Ctrl+K — відкрити Command Palette
                        if (e.text == "k" && e.modifiers.control) {
                            root.open-cmd-palette();
                            return accept;
                        }
                        // Ctrl+/ — відкрити/закрити підказку гарячих клавіш
                        if (e.text == "/" && e.modifiers.control) {
                            root.shortcuts-open = !root.shortcuts-open;
                            return accept;
                        }
                        reject
                    }
                }

                // ── Saved views / filters ──────────────────────────────────
                Rectangle { height: 18px; }

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 6px;
                    height: 24px;
                    alignment: stretch;

                    Text {
                        text: "ЗБЕРЕЖЕНІ ФІЛЬТРИ";
                        color: AppTheme.text-faint;
                        font-size: 10px;
                        font-family: AppTheme.font-sans;
                        font-weight: 600;
                        letter-spacing: 1.4px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    Rectangle {
                        width: 18px;
                        height: 18px;
                        border-radius: AppTheme.radius-sm;
                        background: plus-hover.has-hover ? AppTheme.bg-hover : transparent;

                        Image {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            source: root.icon-plus;
                            width: 10px;
                            height: 10px;
                            colorize: AppTheme.text-faint;
                            image-fit: contain;
                        }
                        plus-hover := TouchArea { mouse-cursor: pointer; }
                    }
                }

                Rectangle { height: 6px; }

                SavedViewItem {
                    label: "Прострочені рахунки";
                    count: 1;
                    star-icon: root.icon-star;
                }
                SavedViewItem {
                    label: "Акти без підпису";
                    count: 2;
                    star-icon: root.icon-star;
                }
                SavedViewItem {
                    label: "Неприв'язані платежі";
                    count: 2;
                    star-icon: root.icon-star;
                }
                SavedViewItem {
                    label: "Цей тиждень";
                    count: 7;
                    star-icon: root.icon-star;
                }

                // ── Spacer ─────────────────────────────────────────────────
                Rectangle { vertical-stretch: 1; }

                // ── Settings nav item ──────────────────────────────────────
                NavItem {
                    label: "Налаштування";
                    icon: root.icon-settings;
                    active: root.current-screen == NavScreen.Settings;
                    clicked => { root.navigate(NavScreen.Settings); }
                }

                Rectangle { height: 10px; }

                // ── User card ──────────────────────────────────────────────
                Rectangle {
                    height: 68px;
                    border-radius: AppTheme.radius-xl;
                    background: AppTheme.bg.with-alpha(0.34);
                    border-width: 1px;
                    border-color: AppTheme.border;

                    HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 8px;
                    spacing: 10px;
                    alignment: stretch;
                    height: 100%;

                    Avatar {
                        initials: root.user-initials;
                        size: 32;
                        tone: "accent";
                    }

                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;

                        Text {
                            text: root.user-name;
                            color: AppTheme.text;
                            font-size: 13px;
                            font-family: AppTheme.font-sans;
                            font-weight: 500;
                            overflow: elide;
                        }

                        Text {
                            text: root.user-role;
                            color: AppTheme.text-faint;
                            font-size: 11px;
                            font-family: AppTheme.font-sans;
                        }
                    }

                    Rectangle {
                        width: 22px;
                        height: 22px;
                        border-radius: AppTheme.radius-md;
                        background: more-hover.has-hover ? AppTheme.bg-hover : transparent;

                        Image {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            source: root.icon-more;
                            width: 12px;
                            height: 12px;
                            colorize: AppTheme.text-muted;
                            image-fit: contain;
                        }
                        more-hover := TouchArea { mouse-cursor: pointer; }
                    }
                }
                }
            }

            if root.company-switcher-open : Rectangle {
                x: 14px;
                y: 84px;
                width: parent.width - 28px;
                background: AppTheme.bg-elevated;
                border-width: 1px;
                border-color: AppTheme.border;
                border-radius: AppTheme.radius-xl;
                drop-shadow-blur: 18px;
                drop-shadow-color: #1e1e1e.with-alpha(0.08);
                z: 200;
                height: company-switcher-popup-content.preferred-height + 20px;

                VerticalLayout {
                    padding: 10px;
                    spacing: 10px;

                    company-switcher-popup-content := VerticalLayout {
                        spacing: 6px;

                        Text {
                            text: "Активна компанія";
                            color: AppTheme.text-faint;
                            font-size: 10px;
                            font-family: AppTheme.font-sans;
                            font-weight: 600;
                            letter-spacing: 1.2px;
                        }

                        if root.company-items.length == 0 : Rectangle {
                            height: 42px;
                            border-radius: AppTheme.radius-lg;
                            background: AppTheme.bg-subtle;

                            Text {
                                text: "Ще немає компаній для вибору";
                                color: AppTheme.text-muted;
                                font-size: 12px;
                                font-family: AppTheme.font-sans;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }

                        for company in root.company-items : CompanySwitcherRow {
                            company: company;
                            selected(id) => {
                                root.company-switcher-open = false;
                                root.company-selected(id);
                            }
                        }

                        HDivider { }

                        SecondaryButton {
                            text: "Налаштувати компанію";
                            clicked => {
                                root.company-switcher-open = false;
                                root.company-manage-requested();
                            }
                        }
                    }
                }
            }
        }

        // ── Main content area ──────────────────────────────────────────────
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 0px;

            // ── Top header bar ─────────────────────────────────────────────
            header := Rectangle {
                height: 72px;
                background: AppTheme.bg;
                border-radius: 0px;

                // Bottom hairline
                Rectangle {
                    x: 0;
                    y: parent.height - 1px;
                    width: parent.width;
                    height: 1px;
                    background: AppTheme.border;
                }

                HorizontalLayout {
                    padding-left: 28px;
                    padding-right: 24px;
                    padding-top: 14px;
                    padding-bottom: 14px;
                    spacing: 14px;
                    alignment: stretch;

                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;

                        HeadingMd-inner := Text {
                            text: root.screen-title;
                            color: AppTheme.text;
                            font-family: AppTheme.font-serif;
                            font-size: 24px;
                            font-weight: 500;
                        }

                        if root.screen-subtitle != "" : Text {
                            text: root.screen-subtitle;
                            color: AppTheme.text-faint;
                            font-size: 12px;
                            font-family: AppTheme.font-sans;
                        }
                    }

                    // Bell icon
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: AppTheme.radius-md;
                        background: bell-hover.has-hover ? AppTheme.bg-subtle : transparent;
                        Image {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            source: root.icon-bell;
                            width: 15px;
                            height: 15px;
                            colorize: AppTheme.text-muted;
                            image-fit: contain;
                        }
                        bell-hover := TouchArea { mouse-cursor: pointer; }
                    }

                    // Theme toggle
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: AppTheme.radius-md;
                        background: theme-hover.has-hover ? AppTheme.bg-subtle : transparent;
                        Image {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            source: root.is-dark ? root.icon-sun : root.icon-moon;
                            width: 15px;
                            height: 15px;
                            colorize: AppTheme.text-muted;
                            image-fit: contain;
                        }
                        theme-hover := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.toggle-theme(); }
                        }
                    }
                }
            }

            // ── Screen content (injected by App) ───────────────────────────
            content := Rectangle {
                vertical-stretch: 1;
                clip: true;
                background: AppTheme.bg-stripe;

                content-area := FocusScope {
                    width: parent.width;
                    height: parent.height;
                    // Якір фокусу: Tab з цього FocusScope переходить до першого елементу екрану нижче
                }

                @children
            }
        }
    }

    // ── Command Palette overlay ────────────────────────────────────────────
    if cmd-palette-open : CommandPalette {
        open: root.cmd-palette-open;
        query: root.cmd-palette-query;
        items: root.cmd-palette-items;
        search-icon: root.icon-search;
        close-icon: root.icon-close;
        enter-icon: root.icon-enter;
        closed => { root.close-cmd-palette(); }
        navigated(screen) => { root.navigate(screen); }
        query-changed(value) => { root.cmd-palette-query = value; root.cmd-palette-query-changed(value); }
        item-activated(payload) => { root.cmd-palette-item-activated(payload); }
    }

    // ── Keyboard Help overlay ──────────────────────────────────────────────
    if shortcuts-open : KeyboardHelp {
        closed => { root.shortcuts-open = false; }
    }
}
