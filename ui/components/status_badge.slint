// Уніфікований кольоровий бейдж статусу (таблетка).
//
// Використовується:
//   - acts/act_list.slint — 4 статуси актів (Чернетка/Виставлено/Підписано/Оплачено)
//   - invoices/invoice_list.slint — ті самі 4 статуси
//   - counterparties/counterparty_list.slint — Активний / Архів
//
// Кольори передаються ззовні — компонент не знає про домен,
// лише відображає передані badge-color і badge-bg.

import { Theme } from "../theme.slint";

export component StatusBadge inherits Rectangle {
    in property <string> label;
    in property <color>  badge-color: Theme.text-muted;
    in property <color>  badge-bg:    Theme.bg-gray-soft;
    in property <image>  icon;

    width: 84px;
    height: Theme.badge-height;
    border-radius: Theme.radius-lg;
    background: root.badge-bg;

    HorizontalLayout {
        alignment: center;
        spacing: Theme.space-1;
        padding-left: 6px;
        padding-right: 6px;

        if root.icon.width > 0 : Image {
            width: 11px;
            height: 11px;
            source: root.icon;
            image-fit: contain;
            colorize: root.badge-color;
            vertical-alignment: center;
        }

        Text {
            text: root.label;
            color: root.badge-color;
            font-size: Theme.font-sm;
            font-weight: 500;
            vertical-alignment: center;
        }
    }
}
