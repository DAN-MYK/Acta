import { Theme } from "../theme.slint";

export component PageHeader inherits Rectangle {
    in property <string> title;
    in property <string> subtitle: "";
    in property <string> button-text;
    callback button-clicked();

    height: Theme.topbar-height;
    vertical-stretch: 0;
    background: Theme.bg-page;

    HorizontalLayout {
        padding-left: Theme.space-8;
        padding-right: Theme.space-8;
        spacing: Theme.space-4;
        alignment: center;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: Theme.space-1;

            Text {
                text: root.title;
                font-size: Theme.font-2xl;
                font-weight: 600;
                color: Theme.text-primary;
            }

            if root.subtitle != "" : Text {
                text: root.subtitle;
                font-size: Theme.font-md;
                font-weight: 400;
                color: Theme.text-muted;
            }
        }

        Rectangle {
            background: Theme.primary;
            border-radius: Theme.radius-md;
            height: Theme.btn-md-height;
            width: 160px;

            Text {
                text: root.button-text;
                color: Theme.text-white;
                font-size: Theme.font-md;
                font-weight: 500;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.button-clicked(); }
            }
        }
    }

    // нижня межа
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }
}
