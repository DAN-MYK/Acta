// Плоска горизонтальна смуга метрик з роздільниками між елементами.
// Замінює KpiCard у header-секціях списків та дашборду.
//
// Використання:
//   MetricStrip {
//       items: [
//           { label: "Виручка", value: root.kpi-revenue, subtext: "місяць", accent: Theme.success },
//           { label: "Неоплачено", value: root.kpi-unpaid, subtext: "", accent: Theme.warning },
//       ];
//   }

import { Theme } from "../theme.slint";

export struct MetricItem {
    label:   string,
    value:   string,
    subtext: string,
    accent:  color,
}

export component MetricStrip inherits Rectangle {
    in property <[MetricItem]> items;

    height: 64px;
    background: Theme.bg-card;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: Theme.radius-md;

    HorizontalLayout {
        for item[i] in root.items : Rectangle {
            horizontal-stretch: 1;
            background: transparent;

            // Вертикальний роздільник зліва (крім першого елементу)
            if i > 0 : Rectangle {
                x: 0;
                y: (parent.height - 32px) / 2;
                width: 1px;
                height: 32px;
                background: Theme.border;
            }

            VerticalLayout {
                alignment: center;
                spacing: Theme.space-1;
                padding-left: i > 0 ? 20px : 16px;
                padding-right: 16px;

                Text {
                    text: item.label;
                    font-size: Theme.font-xs;
                    font-weight: 500;
                    color: Theme.text-muted;
                    overflow: elide;
                }
                Text {
                    text: item.value;
                    font-size: Theme.font-xl;
                    font-weight: 700;
                    color: item.accent;
                    overflow: elide;
                }
                if item.subtext != "" : Text {
                    text: item.subtext;
                    font-size: Theme.font-xs;
                    color: Theme.text-muted;
                    overflow: elide;
                }
            }
        }
    }
}
