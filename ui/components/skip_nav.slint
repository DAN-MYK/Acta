// Компонент "Перейти до контенту" для навігації з клавіатури.
// Прихований (1px) за замовчуванням, з'являється (36px) при отриманні фокусу.
import { Theme } from "../theme.slint";

export component SkipNav {
    callback activated;

    height: scope.has-focus ? 36px : 1px;
    clip: true;
    z: 200;

    scope := FocusScope {
        width: parent.width;
        height: 36px;
        accessible-role: button;
        accessible-label: "Перейти до основного контенту";
        key-pressed(e) => {
            if e.text == "\n" || e.text == " " {
                root.activated();
                accept
            } else {
                reject
            }
        }
    }

    Rectangle {
        visible: scope.has-focus;
        background: Theme.primary;
        border-radius: Theme.radius-md;
        border-width: 2px;
        border-color: Theme.border-focus;
        width: 200px;
        height: 36px;
        x: Theme.space-2;
        y: 0;

        Text {
            text: "Перейти до основного контенту";
            color: Theme.text-white;
            font-size: Theme.font-base;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}
