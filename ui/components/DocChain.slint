// Ланцюжок документів: Рахунок → Акт → Видаткова накладна
//
// Використання:
//   DocChain {
//       steps: [
//           { doc-type: "invoice", doc-number: "РАХ-2025-01", amount: "₴ 24 500",
//             status: "Видано", exists: true },
//           { doc-type: "act",     doc-number: "АКТ-2025-01", amount: "₴ 24 500",
//             status: "Підписано", exists: true },
//           { doc-type: "waybill", doc-number: "",             amount: "",
//             status: "", exists: false },
//       ];
//       create-next(doc-type) => { ... }
//   }

import { Theme } from "../theme.slint";
import { ChainStep } from "../structs.slint";

export component DocChain inherits Rectangle {
    in property <[ChainStep]> steps;
    callback create-next(string);

    height: 88px;
    background: transparent;

    HorizontalLayout {
        alignment: start;
        spacing: 0;

        for step[i] in root.steps : HorizontalLayout {
            spacing: 0;
            alignment: start;

            // Стрілка між кроками (крім першого)
            if i > 0 : Rectangle {
                width: 32px;
                height: 88px;
                background: transparent;

                // Горизонтальна лінія
                Rectangle {
                    x: 0;
                    y: (parent.height - 2px) / 2;
                    width: parent.width - 10px;
                    height: 2px;
                    background: step.exists ? Theme.primary : Theme.border;
                }
                // Наконечник стрілки
                Rectangle {
                    x: parent.width - 14px;
                    y: (parent.height - 8px) / 2;
                    width: 8px; height: 8px;
                    border-radius: 4px;
                    background: step.exists ? Theme.primary : Theme.border;
                }
            }

            // Картка кроку
            Rectangle {
                width: 140px;
                height: 88px;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: step.exists ? Theme.border : Theme.bg-gray;
                background: step.exists ? Theme.bg-card : Theme.bg-gray-soft;

                // Акцентна смужка зверху для наявного документа
                if step.exists : Rectangle {
                    x: 0; y: 0;
                    width: parent.width; height: 3px;
                    border-top-left-radius: Theme.radius-md;
                    border-top-right-radius: Theme.radius-md;
                    background:
                        step.doc-type == "invoice" ? Theme.purple  :
                        step.doc-type == "act"     ? Theme.primary :
                        Theme.success;
                }

                VerticalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: step.exists ? 10px : 16px;
                    padding-bottom: 8px;
                    spacing: 3px;
                    alignment: start;

                    // Тип документа
                    Text {
                        text:
                            step.doc-type == "invoice" ? "Рахунок" :
                            step.doc-type == "act"     ? "Акт"     :
                            "Накладна";
                        font-size: Theme.font-xs;
                        font-weight: 500;
                        color: Theme.text-muted;
                    }

                    if step.exists : Text {
                        text: step.doc-number;
                        font-size: Theme.font-base;
                        font-weight: 600;
                        color: Theme.text-primary;
                        overflow: elide;
                    }

                    if step.exists : Text {
                        text: step.amount;
                        font-size: Theme.font-sm;
                        color: Theme.text-second;
                        overflow: elide;
                    }

                    if step.exists : Text {
                        text: step.status;
                        font-size: Theme.font-xs;
                        color:
                            step.status == "Оплачено"  ? Theme.success :
                            step.status == "Підписано" ? Theme.primary :
                            step.status == "Видано"    ? Theme.warning :
                            Theme.text-muted;
                    }

                    if !step.exists : Text {
                        text: "очікується";
                        font-size: Theme.font-sm;
                        color: Theme.text-muted;
                    }

                    // Кнопка "Створити" для відсутнього документа
                    if !step.exists : Rectangle {
                        height: 22px;
                        width: 80px;
                        border-radius: Theme.radius-sm;
                        background: create-ta.has-hover ? Theme.btn-action-bg : Theme.bg-primary;

                        Text {
                            x: 0; y: 0;
                            width: parent.width; height: parent.height;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            text: "Створити";
                            font-size: Theme.font-xs;
                            font-weight: 600;
                            color: Theme.primary;
                        }

                        create-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.create-next(step.doc-type); }
                        }
                    }
                }

                // Hover ефект для наявного документа
                if step.exists : TouchArea {
                    mouse-cursor: pointer;
                }
            }
        }
    }
}
