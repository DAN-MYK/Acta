// Уніфікована KPI картка з акцентом, іконкою та трендом.
//
// Відрізняється від StatCard:
//   - опційний іконний круг (prop icon)
//   - drop-shadow
//   - prop subtitle-color для кольору підпису (warning/danger/muted)
//
// Використання:
//   import { Icons } from "../components/icons.slint";
//   KpiCard {
//       accent: Theme.primary; icon: Icons.documents;
//       value: "42"; title: "Актів"; subtitle: "цього місяця";
//   }

import { Theme } from "../theme.slint";

export component KpiCard inherits Rectangle {
    in property <color>  accent;
    in property <image>  icon;
    in property <string> value;
    in property <string> title;
    in property <string> subtitle:       "";
    in property <color>  subtitle-color: Theme.text-muted;

    height: 96px;
    horizontal-stretch: 1;
    background: Theme.bg-card;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;

    // Акцентна смужка зверху
    Rectangle {
        x: 0; y: 0;
        width: parent.width;
        height: 4px;
        background: root.accent;
    }

    HorizontalLayout {
        padding-top: 14px;
        padding-left: Theme.space-4;
        padding-right: Theme.space-4;
        padding-bottom: Theme.space-3;
        spacing: Theme.space-3;
        alignment: start;

        // Іконний круг (опційний)
        if root.icon.width > 0 : Rectangle {
            width: 44px;
            height: 44px;
            border-radius: 22px;
            background: root.accent.with-alpha(12%);
            vertical-stretch: 0;

            Image {
                x: 12px; y: 12px;
                width: 20px;
                height: 20px;
                source: root.icon;
                image-fit: contain;
                colorize: root.accent;
            }
        }

        VerticalLayout {
            spacing: Theme.space-1;
            alignment: center;

            Text {
                text: root.value;
                font-size: Theme.font-stat;
                font-weight: 700;
                color: Theme.text-primary;
                overflow: elide;
            }

            Text {
                text: root.title;
                font-size: Theme.font-sm;
                font-weight: 500;
                color: Theme.text-second;
                overflow: elide;
            }

            if root.subtitle != "" : Text {
                text: root.subtitle;
                font-size: Theme.font-xs;
                color: root.subtitle-color;
                overflow: elide;
            }
        }
    }
}
