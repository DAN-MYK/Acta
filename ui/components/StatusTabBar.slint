// Уніфікований таббар зі статусами та лічильниками-бейджами.
//
// Замінює вбудований таббар в ActList та InvoiceList.
//
// Використання:
//   StatusTabBar {
//       tab-names: ["Всі", "Чернетка", "Виставлені", "Оплачені"];
//       tab-counts: [12, 3, 5, 4];
//       active-tab <=> root.active-tab;
//       tab-changed(i) => { root.status-filter-changed(i); }
//   }
//
// Лічильник відображається як кольоровий пілюльний бейдж поруч з назвою.
// Якщо tab-counts коротший за tab-names — решта вкладок отримують 0.

import { Theme } from "../theme.slint";

export component StatusTabBar inherits Rectangle {
    in property <[string]> tab-names;
    in property <[int]>    tab-counts:    [];
    in-out property <int>  active-tab:    0;
    in property <length>   padding-start: Theme.page-padding-x;
    callback tab-changed(int);

    height: 44px;
    vertical-stretch: 0;
    background: Theme.bg-page;

    HorizontalLayout {
        alignment: start;
        padding-left: root.padding-start;
        spacing: 0;

        for tab-name[ti] in root.tab-names : Rectangle {
            property <bool> is-active:  root.active-tab == ti;
            property <int>  tab-count:  ti < root.tab-counts.length
                                        ? root.tab-counts[ti] : 0;

            background: tab-ta.has-hover && !self.is-active
                ? Theme.bg-hover
                : transparent;
            animate background { duration: 80ms; easing: ease; }

            // Акцентна лінія знизу для активної вкладки
            if is-active : Rectangle {
                y: parent.height - 2px;
                height: 2px;
                background: Theme.primary;
            }

            HorizontalLayout {
                alignment: center;
                spacing: Theme.space-2;
                padding-left: 14px;
                padding-right: 14px;

                Text {
                    text: tab-name;
                    font-size: Theme.font-md;
                    font-weight: is-active ? 600 : 400;
                    color: is-active ? Theme.primary : Theme.text-second;
                    vertical-alignment: center;
                }

                // Бейдж лічильника (відображається тільки коли count > 0)
                if tab-count > 0 : Rectangle {
                    height: Theme.badge-sm-height;
                    width: tab-count > 99 ? Theme.space-6 + Theme.space-1
                         : (tab-count > 9 ? Theme.badge-height
                                          : Theme.badge-sm-height);
                    border-radius: self.height / 2;
                    background: is-active ? Theme.primary : Theme.bg-gray;

                    Text {
                        x: 0; y: 0;
                        width: parent.width;
                        height: parent.height;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        text: tab-count > 99 ? "99+" : tab-count + "";
                        font-size: Theme.font-xs;
                        font-weight: 600;
                        color: is-active ? Theme.text-white : Theme.text-muted;
                    }
                }
            }

            tab-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.active-tab = ti;
                    root.tab-changed(ti);
                }
            }
        }
    }

    // Нижня рамка
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }
}
