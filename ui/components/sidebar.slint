import { Theme } from "../theme.slint";

global SidebarIcons {
    out property <image> dashboard:      @image-url("../assets/icons/Home.svg");
    out property <image> documents:      @image-url("../assets/icons/Documents.svg");
    out property <image> counterparties: @image-url("../assets/icons/Counterparties.svg");
    out property <image> payments:       @image-url("../assets/icons/Payments.svg");
    out property <image> reports:        @image-url("../assets/icons/Chart-Bar.svg");
    out property <image> todo:           @image-url("../assets/icons/To-Do.svg");
    out property <image> calendar:       @image-url("../assets/icons/Calendar.svg");
    out property <image> settings:       @image-url("../assets/icons/Settings.svg");
    out property <image> companies:      @image-url("../assets/icons/Chart-Line.svg");
    out property <image> chevron-down:   @image-url("../assets/icons/Chevron-Down.svg");
}

component NavItem {
    in property <string> label;
    in property <image> icon;
    in property <bool> active: false;
    in property <bool> disabled: false;
    in property <int> badge: 0;
    callback clicked;

    height: 36px;
    min-width: 0;

    Rectangle {
        border-radius: Theme.radius-md;
        background: root.active
            ? Theme.sidebar-active
            : (ta.has-hover && !root.disabled ? Theme.sidebar-hover : transparent);
        animate background { duration: 120ms; easing: ease; }

        if root.active : Rectangle {
            x: -3px;
            y: (parent.height - 22px) / 2;
            width: 3px;
            height: 22px;
            border-radius: 2px;
            background: Theme.sidebar-active-bar;
        }

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 12px;
            spacing: 8px;
            alignment: start;

            Rectangle {
                width: 18px;
                height: 18px;
                y: (parent.height - self.height) / 2;
                background: transparent;
                opacity: root.disabled ? 0.45 : 1.0;

                Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.icon;
                    image-fit: contain;
                    colorize: root.active ? Theme.sidebar-active-icon : Theme.sidebar-icon;
                }
            }

            Text {
                text: root.label;
                font-size: Theme.font-md;
                font-weight: root.active ? 600 : 400;
                color: root.active ? Theme.text-white
                    : (root.disabled ? Theme.sidebar-label : Theme.sidebar-text);
                vertical-alignment: center;
                horizontal-stretch: 1;
                animate color { duration: 150ms; easing: ease; }
            }

            if root.badge > 0 : Rectangle {
                width: max(20px, badge-text.preferred-width + 10px);
                height: 18px;
                border-radius: 9px;
                background: Theme.danger;
                y: (parent.height - self.height) / 2;

                badge-text := Text {
                    text: root.badge > 99 ? "99+" : "\{root.badge}";
                    color: Theme.text-white;
                    font-size: Theme.font-xs;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
            }
        }

        ta := TouchArea {
            enabled: !root.disabled;
            mouse-cursor: self.enabled ? pointer : default;
            clicked => { root.clicked(); }
        }
    }
}

component SectionLabel {
    in property <string> text;
    height: 22px;

    HorizontalLayout {
        padding-left: 20px;
        alignment: start;

        Text {
            text: root.text;
            font-size: Theme.font-xs;
            font-weight: 600;
            color: Theme.sidebar-label;
            vertical-alignment: center;
        }
    }
}

export component Sidebar {
    in property <int> current-page: 8;
    in property <int> open-tasks-count: 0;
    in property <string> active-company-name: "Оберіть компанію";
    in property <string> active-company-subtitle: "";

    callback navigate(string, int);
    callback switch-company();

    width: 220px;

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: Theme.sidebar-bg;
        border-width: 1px;
        border-color: Theme.sidebar-border;

        VerticalLayout {
            spacing: 0;
            padding: 0;

            Rectangle {
                height: 56px;

                Rectangle {
                    x: 14px;
                    y: 12px;
                    width: 32px;
                    height: 32px;
                    border-radius: Theme.radius-md;
                    background: Theme.primary;

                    Text {
                        x: 0;
                        y: 6px;
                        width: 32px;
                        horizontal-alignment: center;
                        text: "A";
                        font-size: 16px;
                        font-weight: 700;
                        color: Theme.text-white;
                    }
                }

                Text {
                    x: 54px;
                    y: 18px;
                    text: "Acta";
                    font-size: Theme.font-xl;
                    font-weight: 700;
                    color: Theme.text-white;
                }
            }

            Rectangle {
                height: 44px;
                vertical-stretch: 0;
                background: switch-touch.has-hover ? Theme.sidebar-switcher-hover : transparent;
                animate background { duration: 120ms; easing: ease; }

                switch-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.switch-company(); }

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 36px;
                        spacing: 8px;
                        alignment: start;

                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: Theme.primary;
                            y: (parent.height - self.height) / 2;
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            alignment: center;

                            Text {
                                text: root.active-company-name;
                                font-size: 12px;
                                font-weight: 500;
                                color: #D8E4FF;
                                overflow: elide;
                            }

                            Text {
                                text: root.active-company-subtitle;
                                font-size: 10px;
                                color: Theme.sidebar-text-muted;
                                overflow: elide;
                            }
                        }
                    }

                    Image {
                        width: 14px;
                        height: 14px;
                        source: SidebarIcons.chevron-down;
                        colorize: Theme.sidebar-text-muted;
                        x: parent.width - 24px;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }

            Rectangle {
                height: 1px;
                x: 20px;
                width: 180px;
                background: Theme.sidebar-divider;
                vertical-stretch: 0;
            }

            SectionLabel { text: "МЕНЮ"; }

            VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 6px;
                vertical-stretch: 0;

                NavItem {
                    label: "Головна";
                    icon: SidebarIcons.dashboard;
                    active: root.current-page == 8;
                    clicked => { root.navigate("dashboard", 8); }
                }
                NavItem {
                    label: "Документи";
                    icon: SidebarIcons.documents;
                    active: root.current-page == 1;
                    clicked => { root.navigate("documents", 1); }
                }
                NavItem {
                    label: "Контрагенти";
                    icon: SidebarIcons.counterparties;
                    active: root.current-page == 0;
                    clicked => { root.navigate("counterparties", 0); }
                }
                NavItem {
                    label: "Платежі";
                    icon: SidebarIcons.payments;
                    active: root.current-page == 3;
                    clicked => { root.navigate("payments", 3); }
                }
                NavItem {
                    label: "Звіти";
                    icon: SidebarIcons.reports;
                    active: root.current-page == 4;
                    clicked => { root.navigate("reports", 4); }
                }
            }

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                height: 1px;

                Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.sidebar-divider;
                }
            }

            SectionLabel { text: "УТИЛІТИ"; }

            VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 6px;
                vertical-stretch: 0;

                NavItem {
                    label: "To-Do";
                    icon: SidebarIcons.todo;
                    active: root.current-page == 5;
                    badge: root.open-tasks-count;
                    clicked => { root.navigate("tasks", 5); }
                }
                NavItem {
                    label: "Компанії";
                    icon: SidebarIcons.companies;
                    active: root.current-page == 6;
                    clicked => { root.navigate("companies", 6); }
                }
                NavItem {
                    label: "Календар платежів";
                    icon: SidebarIcons.calendar;
                    active: root.current-page == 7;
                    clicked => { root.navigate("calendar", 7); }
                }
            }

            Rectangle { vertical-stretch: 1; }

            HorizontalLayout {
                height: 1px;
                padding-left: 20px;
                padding-right: 20px;
                vertical-stretch: 0;

                Rectangle {
                    background: Theme.sidebar-divider;
                }
            }

            Rectangle {
                height: 40px;
                vertical-stretch: 0;

                NavItem {
                    x: 12px;
                    width: parent.width - 24px;
                    label: "Налаштування";
                    icon: SidebarIcons.settings;
                    active: root.current-page == 9;
                    clicked => { root.navigate("settings", 9); }
                }
            }

            Rectangle {
                height: 12px;
                vertical-stretch: 0;
            }
        }
    }
}
