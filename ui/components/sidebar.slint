import { Theme } from "../theme.slint";
import { Icons } from "icons.slint";

component NavItem {
    in property <string> label;
    in property <image> icon;
    in property <bool> active: false;
    in property <bool> disabled: false;
    in property <int> badge: 0;
    in property <length> indent: 0px;
    callback clicked;

    height: Theme.nav-item-height;
    min-width: 0;

    Rectangle {
        border-radius: Theme.radius-md;
        border-width: root.active ? 1px : 0px;
        border-color: Theme.border;
        background: root.active
            ? Theme.sidebar-active
            : (ta.has-hover && !root.disabled ? Theme.sidebar-hover : transparent);
        animate background { duration: 100ms; easing: ease; }

        // accent bar on left edge when active
        if root.active : Rectangle {
            x: 0px;
            y: (parent.height - (Theme.nav-item-height - Theme.space-4)) / 2;
            width: Theme.nav-item-accent-bar-width;
            height: Theme.nav-item-height - Theme.space-4;
            border-radius: 2px;
            background: Theme.sidebar-active-bar;
        }

        HorizontalLayout {
            padding-left: Theme.nav-item-padding-x + root.indent;
            padding-right: Theme.nav-item-padding-x;
            spacing: Theme.space-2;
            alignment: start;

            Rectangle {
                width: Theme.icon-sm;
                height: Theme.icon-sm;
                y: (parent.height - self.height) / 2;
                background: transparent;
                opacity: root.disabled ? 0.4 : 1.0;

                Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.icon;
                    image-fit: contain;
                    colorize: root.active ? Theme.sidebar-active-icon : Theme.sidebar-icon;
                }
            }

            Text {
                text: root.label;
                font-size: Theme.font-md;
                font-weight: root.active ? 600 : 400;
                color: root.active ? Theme.text-primary
                    : (root.disabled ? Theme.sidebar-label : Theme.sidebar-text);
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
                animate color { duration: 100ms; easing: ease; }
            }

            if root.badge > 0 : Rectangle {
                width: max(Theme.space-5, badge-text.preferred-width + Theme.space-2);
                height: Theme.badge-sm-height;
                border-radius: Theme.radius-sm;
                background: Theme.bg-primary;
                y: (parent.height - self.height) / 2;

                badge-text := Text {
                    text: root.badge > 99 ? "99+" : "\{root.badge}";
                    color: Theme.primary;
                    font-size: Theme.font-xs;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
            }
        }

        ta := TouchArea {
            enabled: !root.disabled;
            mouse-cursor: self.enabled ? pointer : default;
            clicked => { root.clicked(); }
        }
    }
}

component SectionLabel {
    in property <string> text;
    height: Theme.space-6;

    HorizontalLayout {
        padding-left: Theme.space-2;
        padding-right: Theme.space-2;
        alignment: start;

        Text {
            text: root.text;
            font-size: Theme.font-xs;
            font-weight: 600;
            letter-spacing: 1.2px;
            color: Theme.sidebar-label;
            vertical-alignment: center;
        }
    }
}

export component Sidebar {
    in property <string> current-feature: "dashboard";
    in property <int> open-tasks-count: 0;
    in property <string> active-company-name: "Оберіть компанію";
    in property <string> active-company-subtitle: "";
    in-out property <bool> docs-expanded: true;

    callback navigate(string);
    callback switch-company();

    width: Theme.sidebar-width;

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: Theme.sidebar-bg;

        // right border
        Rectangle {
            x: parent.width - Theme.divider-height;
            y: 0;
            width: Theme.divider-height;
            height: parent.height;
            background: Theme.border;
        }

        VerticalLayout {
            spacing: 0;
            padding: 0;

            // ── Company switcher ─────────────────────────────────────────────
            Rectangle {
                height: Theme.company-switcher-height;
                vertical-stretch: 0;
                background: switch-touch.has-hover ? Theme.sidebar-switcher-hover : transparent;
                animate background { duration: 100ms; easing: ease; }

                switch-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.switch-company(); }

                    HorizontalLayout {
                        padding-left: Theme.space-3;
                        padding-right: Theme.space-3;
                        padding-top: Theme.space-2;
                        padding-bottom: Theme.space-2;
                        spacing: Theme.space-2;
                        alignment: start;

                        // Acta logo square
                        Rectangle {
                            width: Theme.logo-size;
                            height: Theme.logo-size;
                            border-radius: Theme.radius-md;
                            background: Theme.primary;
                            y: (parent.height - self.height) / 2;

                            Image {
                                x: (parent.width - Theme.logo-icon-size) / 2;
                                y: (parent.height - Theme.logo-icon-size) / 2;
                                width: Theme.logo-icon-size;
                                height: Theme.logo-icon-size;
                                source: Icons.sidebar-logo;
                                image-fit: contain;
                                colorize: Theme.text-white;
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: Theme.space-1;
                            alignment: center;

                            Text {
                                text: root.active-company-name;
                                font-size: Theme.font-md;
                                font-weight: 500;
                                color: Theme.text-primary;
                                overflow: elide;
                            }

                            Text {
                                text: root.active-company-subtitle != "" ? root.active-company-subtitle : "Acta · упр. облік";
                                font-size: Theme.font-xs;
                                color: Theme.text-muted;
                                overflow: elide;
                            }
                        }

                        Image {
                            width: Theme.chevron-size;
                            height: Theme.chevron-size;
                            source: Icons.chevron-down;
                            colorize: Theme.text-muted;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }
            }

            // ── Divider ──────────────────────────────────────────────────────
            Rectangle {
                height: Theme.divider-height;
                background: Theme.sidebar-divider;
                vertical-stretch: 0;
            }

            // ── Nav ──────────────────────────────────────────────────────────
            Rectangle { height: Theme.space-2; vertical-stretch: 0; }

            VerticalLayout {
                padding-left: Theme.space-2;
                padding-right: Theme.space-2;
                spacing: Theme.space-1 / 2;
                vertical-stretch: 0;

                NavItem {
                    label: "Головна";
                    icon: Icons.home;
                    active: root.current-feature == "dashboard";
                    clicked => { root.navigate("dashboard"); }
                }

                // Documents group with expand toggle
                Rectangle {
                    height: Theme.nav-item-height;
                    vertical-stretch: 0;
                    border-radius: Theme.radius-md;
                    background: docs-ta.has-hover ? Theme.sidebar-hover : transparent;
                    animate background { duration: 100ms; easing: ease; }

                    HorizontalLayout {
                        padding-left: Theme.nav-item-padding-x;
                        padding-right: Theme.nav-item-padding-x;
                        spacing: Theme.space-2;
                        alignment: start;

                        Rectangle {
                            width: Theme.icon-sm;
                            height: Theme.icon-sm;
                            y: (parent.height - self.height) / 2;
                            Image {
                                width: parent.width;
                                height: parent.height;
                                source: Icons.documents;
                                image-fit: contain;
                                colorize: Theme.sidebar-icon;
                            }
                        }

                        Text {
                            text: "Документи";
                            font-size: Theme.font-md;
                            font-weight: 400;
                            color: Theme.sidebar-text;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        Image {
                            width: Theme.chevron-size;
                            height: Theme.chevron-size;
                            source: Icons.chevron-down;
                            colorize: Theme.sidebar-icon;
                            y: (parent.height - self.height) / 2;
                            transform-rotation: root.docs-expanded ? 0deg : -90deg;
                            animate transform-rotation { duration: 150ms; easing: ease-in-out; }
                        }
                    }

                    docs-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.docs-expanded = !root.docs-expanded; }
                    }
                }

                if root.docs-expanded : NavItem {
                    label: "Акти виконаних робіт";
                    icon: Icons.documents;
                    active: root.current-feature == "acts";
                    indent: 8px;
                    clicked => { root.navigate("acts"); }
                }
                if root.docs-expanded : NavItem {
                    label: "Рахунки";
                    icon: Icons.documents;
                    active: root.current-feature == "invoices";
                    indent: 8px;
                    clicked => { root.navigate("invoices"); }
                }
                if root.docs-expanded : NavItem {
                    label: "Видаткові накладні";
                    icon: Icons.documents;
                    active: root.current-feature == "waybills";
                    indent: 8px;
                    clicked => { root.navigate("waybills"); }
                }

                NavItem {
                    label: "Контрагенти";
                    icon: Icons.counterparties;
                    active: root.current-feature == "counterparties";
                    clicked => { root.navigate("counterparties"); }
                }
                NavItem {
                    label: "Платежі";
                    icon: Icons.payments;
                    active: root.current-feature == "payments";
                    clicked => { root.navigate("payments"); }
                }
                NavItem {
                    label: "Звіти";
                    icon: Icons.reports;
                    active: root.current-feature == "reports";
                    clicked => { root.navigate("reports"); }
                }
            }

            // ── Divider + Utilities ──────────────────────────────────────────
            Rectangle { height: Theme.space-2; vertical-stretch: 0; }

            Rectangle {
                height: Theme.divider-height;
                background: Theme.sidebar-divider;
                vertical-stretch: 0;
            }

            Rectangle { height: Theme.space-2; vertical-stretch: 0; }

            SectionLabel { text: "УТИЛІТИ"; }

            VerticalLayout {
                padding-left: Theme.space-2;
                padding-right: Theme.space-2;
                spacing: Theme.space-1 / 2;
                vertical-stretch: 0;

                NavItem {
                    label: "Задачі";
                    icon: Icons.tasks;
                    active: root.current-feature == "tasks";
                    badge: root.open-tasks-count;
                    clicked => { root.navigate("tasks"); }
                }
                NavItem {
                    label: "Компанії";
                    icon: Icons.companies;
                    active: root.current-feature == "companies";
                    clicked => { root.navigate("companies"); }
                }
                NavItem {
                    label: "Календар платежів";
                    icon: Icons.calendar;
                    active: root.current-feature == "calendar";
                    clicked => { root.navigate("calendar"); }
                }
            }

            Rectangle { vertical-stretch: 1; }

            // ── Divider + Settings ───────────────────────────────────────────
            Rectangle {
                height: Theme.divider-height;
                background: Theme.sidebar-divider;
                vertical-stretch: 0;
            }

            Rectangle { height: Theme.space-2; vertical-stretch: 0; }

            VerticalLayout {
                padding-left: Theme.space-2;
                padding-right: Theme.space-2;
                vertical-stretch: 0;

                NavItem {
                    label: "Налаштування";
                    icon: Icons.settings;
                    active: root.current-feature == "settings";
                    clicked => { root.navigate("settings"); }
                }
            }

            Rectangle { height: Theme.space-2; vertical-stretch: 0; }
        }
    }
}
