// ============================================================
// components/shared.slint — Спільні компоненти Acta UI
// StatusBadge, DocTypeBadge, SecondaryButton, DangerButton,
// PageFade, ConfirmDeleteDialog
// ============================================================

import { Theme } from "../theme.slint";

// ── STATUS BADGE ─────────────────────────────────────────────
// Автоматичний колір за назвою статусу
export component StatusBadge inherits Rectangle {
    in property <string> status;

    property <color> badge-bg:
        status == "Оплачений"    ? Theme.bg-success  :
        status == "Виставлений"  ? Theme.bg-warning  :
        status == "Підписаний"   ? Theme.bg-primary  :
        status == "Прострочений" ? Theme.bg-danger   :
        status == "Очікується"   ? Theme.bg-warning  :
        status == "Проведено"    ? Theme.bg-success  :
        status == "Активний"     ? Theme.bg-success  :
        status == "Незабаром"    ? Theme.bg-purple   :
        status == "Архів"        ? Theme.bg-gray-soft :
        Theme.bg-gray-soft;

    property <color> badge-color:
        status == "Оплачений"    ? Theme.success    :
        status == "Виставлений"  ? Theme.warning    :
        status == "Підписаний"   ? Theme.primary    :
        status == "Прострочений" ? Theme.danger     :
        status == "Очікується"   ? Theme.warning    :
        status == "Проведено"    ? Theme.success    :
        status == "Активний"     ? Theme.success    :
        status == "Незабаром"    ? Theme.purple     :
        status == "Архів"        ? Theme.text-muted :
        Theme.text-second;

    height: Theme.badge-height;
    border-radius: Theme.radius-lg;
    background: badge-bg;

    HorizontalLayout {
        padding-left: Theme.space-2;
        padding-right: Theme.space-2;
        alignment: center;
        Text {
            text: status;
            font-size: Theme.font-sm;
            font-weight: 500;
            color: badge-color;
            vertical-alignment: center;
        }
    }
}

// ── DOC TYPE BADGE ───────────────────────────────────────────
export component DocTypeBadge inherits Rectangle {
    in property <string> doc-type;

    property <color> type-bg:
        doc-type == "АКТ" ? Theme.bg-primary   :
        doc-type == "РАХ" ? Theme.bg-purple    :
        doc-type == "НАК" ? Theme.bg-warning   :
        Theme.bg-gray-soft;

    property <color> type-color:
        doc-type == "АКТ" ? Theme.primary  :
        doc-type == "РАХ" ? Theme.purple   :
        doc-type == "НАК" ? Theme.warning  :
        Theme.text-second;

    width: 44px;
    height: Theme.badge-height;
    border-radius: Theme.radius-sm;
    background: type-bg;

    Text {
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: doc-type;
        font-size: Theme.font-xs;
        font-weight: 600;
        color: type-color;
    }
}

// ── SECONDARY BUTTON ─────────────────────────────────────────
export component SecondaryButton inherits Rectangle {
    in property <string> label;
    callback clicked;

    height: Theme.btn-md-height;
    border-radius: Theme.radius-md;
    background: sec-touch.has-hover ? Theme.bg-hover : Theme.bg-gray;
    border-width: 1px;
    border-color: Theme.border;
    animate background { duration: 120ms; easing: ease; }

    Text {
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: label;
        font-size: Theme.font-md;
        font-weight: 400;
        color: Theme.text-second;
    }

    sec-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ── DANGER BUTTON ────────────────────────────────────────────
export component DangerButton inherits Rectangle {
    in property <string> label;
    callback clicked;

    height: Theme.btn-lg-height;
    border-radius: Theme.radius-lg;
    background: Theme.danger;

    Text {
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: label;
        font-size: Theme.font-lg;
        font-weight: 600;
        color: Theme.text-white;
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ── PAGE FADE ────────────────────────────────────────────────
// Обгортка сторінки з плавним fade-in при появі.
export component PageFade {
    width: 100%;
    height: 100%;
    opacity: 0;
    animate opacity { duration: 180ms; easing: ease-out; }
    states [ s when true : { opacity: 1; } ]
    @children
}

// ── CONFIRM DELETE DIALOG ────────────────────────────────────
export component ConfirmDeleteDialog inherits Rectangle {
    in property <string> title:         "Видалити?";
    in property <string> message:       "Цю дію не можна скасувати.";
    in property <string> confirm-label: "Так, видалити";
    callback confirmed;
    callback cancelled;

    width: 100%; height: 100%;
    background: Theme.overlay;

    // Клік по затемненню — закриття
    TouchArea { clicked => { cancelled(); } }

    // Діалогова картка (по центру оверлею)
    Rectangle {
        width: 440px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: Theme.radius-xl;
        background: Theme.bg-card;
        drop-shadow-blur: 40px;
        drop-shadow-color: Theme.shadow-xl;
        drop-shadow-offset-y: 16px;
        clip: true;

        // Червона акцентна смужка (вгорі картки)
        Rectangle {
            y: 0;
            height: Theme.space-1;
            background: Theme.danger;
        }

        VerticalLayout {
            padding-top: Theme.space-8;
            padding-bottom: Theme.space-5;
            padding-left: Theme.space-8;
            padding-right: Theme.space-8;
            spacing: Theme.space-4;
            alignment: start;

            // Іконка попередження
            Rectangle {
                width: 56px;
                height: 56px;
                border-radius: self.height / 2;
                background: Theme.bg-danger;
                horizontal-stretch: 0;
                // центруємо по горизонталі
                x: (parent.width - self.width) / 2;

                Text {
                    width: parent.width;
                    height: parent.height;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    text: "!";
                    font-size: Theme.font-display;
                    font-weight: 700;
                    color: Theme.danger;
                }
            }

            Text {
                text: root.title;
                font-size: Theme.font-2xl;
                font-weight: 700;
                color: Theme.text-primary;
                horizontal-alignment: center;
            }

            Text {
                text: root.message;
                font-size: Theme.font-md;
                color: Theme.text-second;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            Rectangle { height: Theme.space-1; background: Theme.border; }

            HorizontalLayout {
                spacing: Theme.space-3;
                padding-top: Theme.space-2;

                SecondaryButton {
                    horizontal-stretch: 1;
                    label: "Скасувати";
                    clicked => { root.cancelled(); }
                }

                DangerButton {
                    horizontal-stretch: 1;
                    label: root.confirm-label;
                    clicked => { root.confirmed(); }
                }
            }
        }
    }
}
