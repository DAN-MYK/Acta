// components/status_option.slint — Радіо-стиль вибору статусу
//
// Використовується у: ActForm, InvoiceForm (та інших формах документів)
//
// Приклад використання:
//   import { StatusOption } from "../components/status_option.slint";
//
//   StatusOption {
//       title: "Виставлений";
//       subtitle: "Очікує підпису";
//       selected: root.status == 1;
//       accent: Theme.warning;
//       clicked => { root.status = 1; }
//   }

import { Theme } from "../theme.slint";

export component StatusOption inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <bool>   selected: false;
    in property <color>  accent: Theme.warning;
    callback clicked();

    height: 48px;
    border-radius: Theme.radius-md;
    border-width: selected ? 2px : 1px;
    border-color: selected ? accent : Theme.border;
    background: selected
        ? accent.with-alpha(8%)
        : (opt-touch.has-hover ? Theme.bg-hover : Theme.bg-card);
    animate background   { duration: 80ms; easing: ease; }
    animate border-color { duration: 80ms; easing: ease; }

    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        spacing: Theme.space-2;
        alignment: start;

        // Коло радіо-кнопки (геометрія: 16×16 → radius=8, внутрішня крапка 6×6)
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: self.width / 2;
                border-width: 2px;
                border-color: root.selected ? root.accent : Theme.border;
                background: root.selected ? root.accent : transparent;

                if root.selected : Rectangle {
                    width: 6px;
                    height: 6px;
                    border-radius: self.width / 2;
                    background: white;
                }
            }
        }

        // Текстовий блок: назва + підпис
        VerticalLayout {
            alignment: center;
            spacing: Theme.space-1;
            horizontal-stretch: 1;

            Text {
                text: root.title;
                font-size: Theme.font-md;
                font-weight: 600;
                color: root.selected ? root.accent : Theme.text-primary;
            }

            Text {
                text: root.subtitle;
                font-size: Theme.font-sm;
                color: Theme.text-second;
            }
        }
    }

    opt-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
