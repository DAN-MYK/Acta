// Acta — Counterparties screen
// Master-detail layout: list (380px) + detail panel with tabbed content.
// No gradient avatars, flat metric strip matching Dashboard pattern.

import { AppTheme } from "design-tokens.slint";
import { CounterpartyItem, CounterpartyDetails, DocumentItem, PaymentItem, DocumentKind, DocumentStatus, ChainStep, DocChainGroup } from "types.slint";
import {
    Card, HDivider, VDivider, Badge, StatusDot,
    GhostButton, SecondaryButton, PrimaryButton, IconButton,
    SearchInput, HeadingSm, HeadingLg, Avatar, SectionLabel,
    DocChain
} from "components.slint";

// ── Counterparty list item ────────────────────────────────────────────────────
component CpListItem inherits Rectangle {
    in property <CounterpartyItem> cp;
    in property <bool> active: false;
    callback clicked(string);

    property <bool> hovered: false;

    height: 58px;
    background:
        active  ? AppTheme.accent-soft :
        hovered ? AppTheme.bg-hover    :
        transparent;
    accessible-role: list-item;
    accessible-label: cp.name + ", " + cp.kind + ", ЄДРПОУ " + cp.edrpou;

    // Left accent bar when active
    if active : Rectangle {
        x: 0;
        y: 0;
        width: 2px;
        height: root.height;
        background: AppTheme.accent;
    }

    // Bottom divider
    Rectangle {
        y: root.height - 1px;
        width: root.width;
        height: 1px;
        background: AppTheme.border;
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 6px;
        alignment: stretch;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 4px;

            HorizontalLayout {
                alignment: stretch;

                Text {
                    text: root.cp.name;
                    color: AppTheme.text;
                    font-size: 13px;
                    font-family: AppTheme.font-sans;
                    font-weight: active ? 500 : 400;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                Text {
                    text: root.cp.balance-str != "" ? root.cp.balance-str : "—";
                    color:
                        root.cp.balance-str != "" ? AppTheme.text :
                        AppTheme.text-faint;
                    font-family: AppTheme.font-mono;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }

            HorizontalLayout {
                spacing: 8px;

                Text {
                    text: root.cp.kind;
                    color: AppTheme.text-faint;
                    font-size: 11px;
                    font-family: AppTheme.font-mono;
                }
                Text { text: "·"; color: AppTheme.text-faint; font-size: 11px; }
                Text {
                    text: root.cp.edrpou;
                    color: AppTheme.text-faint;
                    font-size: 11px;
                    font-family: AppTheme.font-mono;
                }

                if cp.overdue-count > 0 : Text { text: "·"; color: AppTheme.text-faint; font-size: 11px; }
                if cp.overdue-count > 0 : Text {
                    text: root.cp.overdue-count + " простр.";
                    color: AppTheme.danger;
                    font-size: 11px;
                    font-family: AppTheme.font-mono;
                }
            }
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.move) { root.hovered = self.has-hover; }
        }
        clicked => { root.clicked(root.cp.id); }
    }
}

// ── Detail metric strip ───────────────────────────────────────────────────────
component CpMetric inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <string> sub: "";
    in property <bool> danger: false;

    horizontal-stretch: 1;
    padding-right: 20px;
    spacing: 4px;

    Text {
        text: root.label;
        color: AppTheme.text-faint;
        font-size: 10.5px;
        font-family: AppTheme.font-sans;
        font-weight: 600;
        letter-spacing: 1.2px;
    }

    Text {
        text: root.value;
        color: root.danger ? AppTheme.danger : AppTheme.text;
        font-family: AppTheme.font-serif;
        font-size: 22px;
        font-weight: 500;
        letter-spacing: -0.3px;
    }

    if sub != "" : Text {
        text: root.sub;
        color: AppTheme.text-muted;
        font-size: 11px;
        font-family: AppTheme.font-mono;
    }
}

// ── Detail tab ────────────────────────────────────────────────────────────────
component DetailTab inherits Rectangle {
    in property <string> label;
    in property <int> count: -1;   // -1 = no count shown
    in property <bool> active: false;
    callback clicked;

    height: 42px;
    background: transparent;

    if active : Rectangle {
        x: 0;
        y: root.height - 2px;
        width: root.width;
        height: 2px;
        background: AppTheme.accent;
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        alignment: center;

        Text {
            text: root.label;
            color: active ? AppTheme.text : AppTheme.text-muted;
            font-size: 13px;
            font-family: AppTheme.font-sans;
            font-weight: active ? 500 : 400;
            vertical-alignment: center;
        }

        if count >= 0 : Text {
            text: root.count;
            color: AppTheme.text-faint;
            font-size: 11px;
            font-family: AppTheme.font-mono;
            vertical-alignment: center;
        }
    }

    TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// ── Counterparties screen ─────────────────────────────────────────────────────
export component Counterparties inherits Rectangle {
    // Data
    in property <[CounterpartyItem]> list;
    in property <CounterpartyDetails> detail;
    in property <[DocumentItem]> detail-docs;
    in property <[PaymentItem]> detail-payments;

    // Pre-formatted detail values
    in property <string> detail-balance-str;
    in property <bool> detail-balance-is-negative: false;
    in property <string> detail-overdue-str;

    // Icons
    in property <image> icon-search;
    in property <image> icon-plus;
    in property <image> icon-edit;
    in property <image> icon-more;

    // Callbacks
    callback select(string);
    callback create-doc(string);
    callback edit-cp(string);
    callback search-changed(string);
    callback tab-changed(string);

    in property <[DocChainGroup]> doc-chains;
    callback chain-create(string, string);

    // Internal state
    in-out property <string> selected-id: "";
    in-out property <string> active-tab: "docs";
    in-out property <string> search-query: "";

    background: AppTheme.bg;

    HorizontalLayout {
        padding: 20px;
        spacing: 16px;

        // ── List column ────────────────────────────────────────────────────
        Card {
            width: 380px;
            padded: false;

            VerticalLayout {
                // Search
                HorizontalLayout {
                    padding: 12px;
                    spacing: 6px;
                    height: 54px;

                    SearchInput {
                        search-icon: root.icon-search;
                        placeholder: "Пошук контрагента…";
                        value: root.search-query;
                        horizontal-stretch: 1;
                        edited(v) => { root.search-changed(v); }
                    }

                    Rectangle {
                        width: 30px;
                        height: 30px;
                        border-radius: AppTheme.radius-md;
                        background: add-hover.has-hover ? AppTheme.bg-hover : transparent;
                        border-width: add-hover.has-hover ? 1px : 0px;
                        border-color: AppTheme.border;

                        Image { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; source: root.icon-plus; width: 15px; height: 15px; colorize: AppTheme.text-muted; image-fit: contain; }
                        add-hover := TouchArea { mouse-cursor: pointer; }
                    }
                }

                // List items
                for cp in list : CpListItem {
                    cp: cp;
                    active: root.selected-id == cp.id;
                    clicked(id) => { root.select(id); }
                }
            }
        }

        // ── Detail column ──────────────────────────────────────────────────
        Card {
            horizontal-stretch: 1;
            padded: false;

            Flickable {
                viewport-height: detail-content.preferred-height + 20px;

                detail-content := VerticalLayout {

                    // ── Detail header ──────────────────────────────────────
                    Rectangle {
                        VerticalLayout {
                            padding: 28px;
                            padding-bottom: 20px;
                            spacing: 0px;

                            // Name row
                            HorizontalLayout {
                                alignment: stretch;
                                spacing: 20px;

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 6px;

                                    Text {
                                        text: detail.kind == "ФОП" ? "ФІЗИЧНА ОСОБА-ПІДПРИЄМЕЦЬ" : "ЮРИДИЧНА ОСОБА";
                                        color: AppTheme.text-faint;
                                        font-size: 10.5px;
                                        font-family: AppTheme.font-sans;
                                        font-weight: 600;
                                        letter-spacing: 1.2px;
                                    }

                                    HeadingLg { text: detail.name; }

                                    HorizontalLayout {
                                        spacing: 20px;

                                        Text {
                                            text: "ЄДРПОУ " + detail.edrpou;
                                            color: AppTheme.text-muted;
                                            font-size: 12.5px;
                                            font-family: AppTheme.font-mono;
                                        }

                                        Text {
                                            text: "Клієнт з " + detail.client-since;
                                            color: AppTheme.text-muted;
                                            font-size: 12.5px;
                                            font-family: AppTheme.font-sans;
                                        }
                                    }
                                }

                                // Action buttons
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: center;

                                    Rectangle {
                                        width: 28px;
                                        height: 28px;
                                        border-radius: AppTheme.radius-md;
                                        background: more-h.has-hover ? AppTheme.bg-hover : transparent;
                                        Image { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; source: root.icon-more; width: 15px; height: 15px; colorize: AppTheme.text-muted; image-fit: contain; }
                                        more-h := TouchArea { mouse-cursor: pointer; }
                                    }

                                    SecondaryButton { text: "Редагувати"; small: true; }
                                    PrimaryButton { text: "Створити документ"; }
                                }
                            }

                            // ── Metric strip ───────────────────────────────
                            HDivider { }

                            HorizontalLayout {
                                alignment: stretch;

                                CpMetric {
                                    label: "Баланс";
                                    value: root.detail-balance-str;
                                    danger: root.detail-balance-is-negative;
                                }
                                VDivider { }
                                CpMetric {
                                    label: "Документів";
                                    value: detail.doc-count;
                                    sub: "документів";
                                }
                                VDivider { }
                                CpMetric {
                                    label: "Прострочено";
                                    value: detail.overdue-count;
                                    sub: detail.overdue-amount-str;
                                    danger: detail.overdue-count > 0;
                                }
                                VDivider { }
                                CpMetric {
                                    label: "Останній контакт";
                                    value: detail.last-contact-days + " дн.";
                                    sub: detail.last-contact-date;
                                }
                            }
                        }
                    }

                    HDivider { }

                    // ── Tabs ───────────────────────────────────────────────
                    HorizontalLayout {
                        padding-left: 28px;
                        spacing: 4px;
                        height: 42px;

                        DetailTab {
                            label: "Документи";
                            count: root.detail-docs.length;
                            active: root.active-tab == "docs";
                            clicked => { root.active-tab = "docs"; root.tab-changed("docs"); }
                        }
                        DetailTab {
                            label: "Платежі";
                            count: root.detail-payments.length;
                            active: root.active-tab == "payments";
                            clicked => { root.active-tab = "payments"; root.tab-changed("payments"); }
                        }
                        DetailTab {
                            label: "Договори";
                            count: 2;
                            active: root.active-tab == "contracts";
                            clicked => { root.active-tab = "contracts"; root.tab-changed("contracts"); }
                        }
                        DetailTab {
                            label: "Реквізити";
                            active: root.active-tab == "details";
                            clicked => { root.active-tab = "details"; root.tab-changed("details"); }
                        }
                        DetailTab {
                            label: "Історія";
                            active: root.active-tab == "activity";
                            clicked => { root.active-tab = "activity"; root.tab-changed("activity"); }
                        }
                    }

                    HDivider { }

                    // ── Documents tab ──────────────────────────────────────
                    if active-tab == "docs" : VerticalLayout {
                        // Table header
                        Rectangle {
                            height: 36px;
                            background: AppTheme.bg-subtle;

                            HorizontalLayout {
                                padding-left: 28px;
                                padding-right: 28px;
                                alignment: stretch;

                                Text { text: "ID"; color: AppTheme.text-faint; font-size: 10.5px; font-family: AppTheme.font-sans; font-weight: 600; letter-spacing: 1.2px; vertical-alignment: center; width: 130px; }
                                Text { text: "ТИП"; color: AppTheme.text-faint; font-size: 10.5px; font-family: AppTheme.font-sans; font-weight: 600; letter-spacing: 1.2px; vertical-alignment: center; horizontal-stretch: 1; }
                                Text { text: "ДАТА"; color: AppTheme.text-faint; font-size: 10.5px; font-family: AppTheme.font-sans; font-weight: 600; letter-spacing: 1.2px; vertical-alignment: center; width: 100px; }
                                Text { text: "СТАТУС"; color: AppTheme.text-faint; font-size: 10.5px; font-family: AppTheme.font-sans; font-weight: 600; letter-spacing: 1.2px; vertical-alignment: center; width: 120px; }
                                Text { text: "СУМА"; color: AppTheme.text-faint; font-size: 10.5px; font-family: AppTheme.font-sans; font-weight: 600; letter-spacing: 1.2px; vertical-alignment: center; horizontal-alignment: right; width: 130px; }
                            }
                        }

                        for doc in detail-docs : Rectangle {
                            height: 44px;

                            Rectangle { y: root.height - 1px; width: root.width; height: 1px; background: AppTheme.border; }

                            HorizontalLayout {
                                padding-left: 28px;
                                padding-right: 28px;
                                alignment: stretch;

                                Text { text: doc.id; color: AppTheme.accent-text; font-family: AppTheme.font-mono; font-size: 11.5px; vertical-alignment: center; width: 130px; }
                                Text {
                                    text:
                                        doc.kind == DocumentKind.Invoice ? "Рахунок" :
                                        doc.kind == DocumentKind.Act     ? "Акт вик. робіт" :
                                        "Видаткова накладна";
                                    color: AppTheme.text;
                                    font-size: 13px;
                                    font-family: AppTheme.font-sans;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                Text { text: doc.date; color: AppTheme.text-muted; font-family: AppTheme.font-mono; font-size: 11.5px; vertical-alignment: center; width: 100px; }
                                HorizontalLayout {
                                    spacing: 6px;
                                    width: 120px;
                                    StatusDot {
                                        tone:
                                            doc.status == DocumentStatus.Signed  ? "success" :
                                            doc.status == DocumentStatus.Paid    ? "success" :
                                            doc.status == DocumentStatus.Overdue ? "danger"  :
                                            doc.status == DocumentStatus.Issued  ? "info"    :
                                            "muted";
                                    }
                                    Text {
                                        text:
                                            doc.status == DocumentStatus.Draft   ? "Чернетка"   :
                                            doc.status == DocumentStatus.Issued  ? "Виставлено" :
                                            doc.status == DocumentStatus.Signed  ? "Підписано"  :
                                            doc.status == DocumentStatus.Paid    ? "Оплачено"   :
                                            doc.status == DocumentStatus.Overdue ? "Прострочено":
                                            "Частково";
                                        color:
                                            doc.status == DocumentStatus.Signed  ? AppTheme.success :
                                            doc.status == DocumentStatus.Paid    ? AppTheme.success :
                                            doc.status == DocumentStatus.Overdue ? AppTheme.danger  :
                                            doc.status == DocumentStatus.Issued  ? AppTheme.info    :
                                            AppTheme.text-muted;
                                        font-size: 12px;
                                        font-family: AppTheme.font-sans;
                                        vertical-alignment: center;
                                    }
                                }
                                Text { text: doc.amount-str; color: AppTheme.text; font-family: AppTheme.font-mono; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; width: 130px; }
                            }
                        }

                        if detail-docs.length == 0 : Rectangle {
                            height: 80px;
                            Text {
                                text: "Немає документів";
                                color: AppTheme.text-faint;
                                font-size: 13px;
                                font-family: AppTheme.font-sans;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }

                        if root.doc-chains.length > 0 : VerticalLayout {
                            padding-top: 16px;
                            spacing: 12px;

                            HorizontalLayout {
                                padding-left: 28px;

                                Text {
                                    text: "ЛАНЦЮЖКИ ДОКУМЕНТІВ";
                                    color: AppTheme.text-faint;
                                    font-size: 10.5px;
                                    font-family: AppTheme.font-sans;
                                    font-weight: 600;
                                }
                            }

                            HDivider { }

                            for group in root.doc-chains : Rectangle {
                                height: 100px;

                                HorizontalLayout {
                                    padding-left: 28px;
                                    padding-right: 28px;
                                    alignment: start;

                                    DocChain {
                                        steps: group.steps;
                                        create-next(t) => { root.chain-create(t, group.doc-id); }
                                    }
                                }
                            }
                        }
                    }

                    // ── Details tab ────────────────────────────────────────
                    if active-tab == "details" : Rectangle {
                        GridLayout {
                            padding: 28px;
                            spacing: 14px;
                            Row {
                                Text { text: "Повна назва"; color: AppTheme.text-faint; font-size: 11.5px; }
                                Text { text: detail.name; color: AppTheme.text; font-size: 13px; font-family: AppTheme.font-sans; }
                            }
                            Row {
                                Text { text: "ЄДРПОУ"; color: AppTheme.text-faint; font-size: 11.5px; }
                                Text { text: detail.edrpou; color: AppTheme.text; font-size: 13px; font-family: AppTheme.font-mono; }
                            }
                            Row {
                                Text { text: "ІПН"; color: AppTheme.text-faint; font-size: 11.5px; }
                                Text { text: detail.ipn; color: AppTheme.text; font-size: 13px; font-family: AppTheme.font-mono; }
                            }
                            Row {
                                Text { text: "IBAN"; color: AppTheme.text-faint; font-size: 11.5px; }
                                Text { text: detail.iban; color: AppTheme.text; font-size: 13px; font-family: AppTheme.font-mono; }
                            }
                            Row {
                                Text { text: "Банк"; color: AppTheme.text-faint; font-size: 11.5px; }
                                Text { text: detail.bank; color: AppTheme.text; font-size: 13px; font-family: AppTheme.font-sans; }
                            }
                            Row {
                                Text { text: "Юр. адреса"; color: AppTheme.text-faint; font-size: 11.5px; }
                                Text { text: detail.address; color: AppTheme.text; font-size: 13px; font-family: AppTheme.font-sans; }
                            }
                            Row {
                                Text { text: "Директор"; color: AppTheme.text-faint; font-size: 11.5px; }
                                Text { text: detail.director; color: AppTheme.text; font-size: 13px; font-family: AppTheme.font-sans; }
                            }
                            Row {
                                Text { text: "Телефон"; color: AppTheme.text-faint; font-size: 11.5px; }
                                Text { text: detail.phone; color: AppTheme.text; font-size: 13px; font-family: AppTheme.font-mono; }
                            }
                            Row {
                                Text { text: "Email"; color: AppTheme.text-faint; font-size: 11.5px; }
                                Text { text: detail.email; color: AppTheme.text; font-size: 13px; font-family: AppTheme.font-mono; }
                            }
                        }
                    }
                }
            }
        }
    }
}
