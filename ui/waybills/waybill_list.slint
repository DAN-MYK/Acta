// Компонент: список видаткових накладних
//
// Структура аналогічна InvoiceList:
//   - Topbar 64px (заголовок + кнопка створення)
//   - Вкладки статусів (44px) з лічильниками
//   - KPI картки (84px) — цього місяця, доставлено, непідписано, прострочено
//   - Рядок пошуку
//   - Таблиця зі status badge та панеллю дій

import { Theme } from "../theme.slint";
import { ProgressIndicator, ListView } from "std-widgets.slint";
import { StatCard } from "../components/stat_card.slint";
import { StatusBadge } from "../components/status_badge.slint";
import { WaybillRow } from "../structs.slint";

component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> disabled: false;
    callback clicked();

    height: 36px;
    border-radius: 8px;
    background: disabled
        ? Theme.border
        : (primary ? Theme.primary : Theme.bg-card);
    border-width: primary ? 0px : 1px;
    border-color: Theme.border;

    Text {
        text: root.text;
        color: disabled ? Theme.text-muted : (primary ? Theme.text-white : Theme.text-primary);
        font-size: 13px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        mouse-cursor: disabled ? default : pointer;
        clicked => { if (!root.disabled) { root.clicked(); } }
    }
}

export component WaybillList {

    // ── Вхідні дані ────────────────────────────────────────────────────────
    in property <[WaybillRow]> rows;
    in property <bool>         loading: false;
    in property <[int]>        status-counts: [0, 0, 0, 0, 0];

    // ── KPI дані ─────────────────────────────────────────────────────────────
    in property <int>    kpi-month: 0;
    in property <string> kpi-delivered: "0 ₴";
    in property <string> kpi-unsigned: "0 ₴";
    in property <int>    kpi-overdue: 0;

    // ── Колбеки ─────────────────────────────────────────────────────────────
    // 0=Усі, 1=Чернетки, 2=Виставлені, 3=Підписані, 4=Доставлені
    callback status-filter-changed(int);
    callback search-changed(string);
    callback row-selected(string);
    callback create-clicked();
    callback advance-status-clicked(string);
    callback edit-clicked(string);
    callback pdf-clicked(string);

    // ── Внутрішній стан ─────────────────────────────────────────────────────
    private property <int>    selected-row: -1;
    private property <string> selected-id: "";
    private property <string> selected-status: "";
    private property <string> selected-number: "";
    private property <int>    active-tab: 0;

    min-width: 600px;
    min-height: 400px;

    VerticalLayout {
        spacing: 0;
        padding: 0;

        // ── Topbar ─────────────────────────────────────────────────────────
        Rectangle {
            height: 64px;
            vertical-stretch: 0;
            background: Theme.bg-card;

            HorizontalLayout {
                padding-left: 32px;
                padding-right: 32px;
                spacing: 16px;
                alignment: center;

                Text {
                    text: "Накладні";
                    font-size: 18px;
                    font-weight: 600;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                new-btn := Rectangle {
                    background: Theme.primary;
                    border-radius: 8px;
                    height: 36px;
                    width: 165px;

                    Text {
                        text: "+ Нова накладна";
                        color: Theme.text-white;
                        font-size: 13px;
                        font-weight: 500;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.create-clicked(); }
                    }
                }
            }

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }
        }

        // ── Вкладки статусів (44px) ──────────────────────────────────────────
        Rectangle {
            height: 44px;
            vertical-stretch: 0;
            background: Theme.bg-card;

            private property <[string]> tab-names: ["Всі", "Чернетки", "Виставлені", "Підписані", "Доставлені"];

            HorizontalLayout {
                alignment: start;
                padding-left: 32px;
                spacing: 0;

                for tab-name[ti] in tab-names : Rectangle {
                    property <bool> is-active: root.active-tab == ti;
                    property <int>  tab-count: ti < root.status-counts.length
                        ? root.status-counts[ti] : 0;

                    if is-active : Rectangle {
                        y: parent.height - 2px;
                        height: 2px;
                        background: Theme.primary;
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 4px;
                        padding-left: 12px;
                        padding-right: 12px;

                        Text {
                            text: tab-count > 0
                                ? tab-name + " (" + tab-count + ")"
                                : tab-name;
                            font-size: 13px;
                            font-weight: is-active ? 600 : 400;
                            color: is-active ? Theme.primary : Theme.text-second;
                            vertical-alignment: center;
                        }
                    }

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.active-tab = ti;
                            root.status-filter-changed(ti);
                        }
                    }
                }
            }

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }
        }

        // ── Основний контент ─────────────────────────────────────────────────
        Rectangle {
            background: Theme.bg-page;
            vertical-stretch: 1;

            VerticalLayout {
                padding-top: 24px;
                padding-left: 32px;
                padding-right: 32px;
                padding-bottom: 24px;
                spacing: 16px;

                // ── KPI картки ───────────────────────────────────────────────
                HorizontalLayout {
                    height: 84px;
                    spacing: 12px;
                    vertical-stretch: 0;

                    StatCard {
                        accent: Theme.primary;
                        value: root.kpi-month + "";
                        label: "Накладних за місяць";
                        secondary: "поточний місяць";
                    }

                    StatCard {
                        accent: Theme.success;
                        value: root.kpi-delivered;
                        label: "Відвантажено";
                        secondary: "доставлені цього місяця";
                    }

                    StatCard {
                        accent: Theme.warning;
                        value: root.kpi-unsigned;
                        label: "Непідписаних";
                        secondary: "виставлені та підписані";
                    }

                    StatCard {
                        accent: root.kpi-overdue > 0 ? Theme.danger : Theme.text-muted;
                        value: root.kpi-overdue + "";
                        label: "Прострочено";
                        secondary: "більше 30 днів";
                    }
                }

                // ── Пошук ────────────────────────────────────────────────────
                HorizontalLayout {
                    height: 40px;
                    vertical-stretch: 0;

                    search-rect := Rectangle {
                        background: Theme.bg-card;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.border;
                        horizontal-stretch: 1;
                        clip: true;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;

                            search-input := TextInput {
                                vertical-alignment: center;
                                font-size: 13px;
                                color: Theme.text-primary;
                                edited => { root.search-changed(search-input.text); }
                            }
                        }

                        if search-input.text == "" : Text {
                            x: 12px;
                            height: parent.height;
                            width: parent.width - 24px;
                            text: "🔎  Пошук за номером або контрагентом...";
                            color: Theme.text-muted;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                    }
                }

                if root.loading : ProgressIndicator {
                    indeterminate: true;
                    vertical-stretch: 0;
                }

                // ── Таблиця ──────────────────────────────────────────────────
                Rectangle {
                    vertical-stretch: 1;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.border;
                    clip: true;

                    VerticalLayout {
                        spacing: 0;

                        // Заголовок
                        Rectangle {
                            height: 40px;
                            vertical-stretch: 0;
                            background: Theme.table-header;

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;

                                Text { text: "Номер";      color: Theme.text-second; font-size: 12px; font-weight: 500; horizontal-stretch: 2; vertical-alignment: center; }
                                Text { text: "Дата";       color: Theme.text-second; font-size: 12px; font-weight: 500; horizontal-stretch: 1; vertical-alignment: center; }
                                Text { text: "Контрагент"; color: Theme.text-second; font-size: 12px; font-weight: 500; horizontal-stretch: 3; vertical-alignment: center; }
                                Text { text: "Сума, ₴";    color: Theme.text-second; font-size: 12px; font-weight: 500; horizontal-stretch: 1; vertical-alignment: center; }
                                Text { text: "Статус";     color: Theme.text-second; font-size: 12px; font-weight: 500; width: 110px; vertical-alignment: center; }
                            }
                        }

                        // Порожній стан
                        if !root.loading && root.rows.length == 0 : Rectangle {
                            vertical-stretch: 1;
                            background: Theme.bg-card;

                            VerticalLayout {
                                alignment: center;
                                spacing: 8px;

                                Text {
                                    text: "📦";
                                    font-size: 32px;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "Накладних ще немає";
                                    font-size: 15px;
                                    font-weight: 500;
                                    color: Theme.text-second;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "Натисніть «+ Нова накладна» щоб створити першу";
                                    font-size: 13px;
                                    color: Theme.text-muted;
                                    horizontal-alignment: center;
                                }
                            }
                        }

                        // Рядки
                        ListView {
                            vertical-stretch: 1;

                            for row[i] in root.rows : Rectangle {
                                property <string> raw-status: row.status;
                                property <color> badge-color:
                                    raw-status == "delivered" ? Theme.success  :
                                    raw-status == "signed"    ? Theme.primary  :
                                    raw-status == "issued"    ? Theme.warning  :
                                    Theme.text-muted;
                                property <color> badge-bg:
                                    raw-status == "delivered" ? #1EB16E1F :
                                    raw-status == "signed"    ? #3D75F41A :
                                    raw-status == "issued"    ? #F4A31E1F :
                                    #ABABB71F;

                                height: 52px;
                                background: root.selected-row == i
                                    ? Theme.row-selected
                                    : (row-touch.has-hover
                                        ? Theme.row-hover
                                        : (Math.mod(i, 2) == 0 ? Theme.bg-card : Theme.row-stripe));
                                border-width: 1px;
                                border-color: Theme.border;
                                animate background { duration: 80ms; easing: ease; }

                                HorizontalLayout {
                                    padding-left: 15px;
                                    padding-right: 15px;

                                    Text {
                                        text: row.num;
                                        color: Theme.text-primary;
                                        font-size: 13px;
                                        font-weight: 500;
                                        horizontal-stretch: 2;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: row.date;
                                        color: Theme.text-second;
                                        font-size: 13px;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: row.counterparty;
                                        color: Theme.text-second;
                                        font-size: 13px;
                                        horizontal-stretch: 3;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: row.amount;
                                        color: Theme.text-primary;
                                        font-size: 13px;
                                        font-weight: 600;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    Rectangle {
                                        width: 110px;
                                        StatusBadge {
                                            y: (parent.height - self.height) / 2;
                                            label: row.status-label;
                                            badge-color: badge-color;
                                            badge-bg: badge-bg;
                                        }
                                    }
                                }

                                row-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.selected-row    = i;
                                        root.selected-id     = row.id;
                                        root.selected-status = row.status;
                                        root.selected-number = row.num;
                                        root.row-selected(row.id);
                                    }
                                }
                            }
                        }
                    }
                }

                // ── Панель дій ──────────────────────────────────────────────
                if root.selected-row >= 0 : HorizontalLayout {
                    height: 48px;
                    spacing: 8px;
                    vertical-stretch: 0;

                    Text {
                        text: root.selected-number;
                        color: Theme.text-second;
                        font-size: 13px;
                        font-weight: 500;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    ActionButton {
                        text: "✎  Редагувати";
                        width: 130px;
                        clicked => {
                            if (root.selected-id != "") {
                                root.edit-clicked(root.selected-id);
                            }
                        }
                    }

                    ActionButton {
                        text: "PDF";
                        width: 80px;
                        clicked => {
                            if (root.selected-id != "") {
                                root.pdf-clicked(root.selected-id);
                            }
                        }
                    }

                    ActionButton {
                        text: "Наступний статус ▶";
                        width: 180px;
                        primary: root.selected-status != "delivered";
                        disabled: root.selected-status == "delivered";
                        clicked => {
                            if (root.selected-id != "" && root.selected-status != "delivered") {
                                root.advance-status-clicked(root.selected-id);
                                root.selected-row    = -1;
                                root.selected-id     = "";
                                root.selected-status = "";
                                root.selected-number = "";
                            }
                        }
                    }
                }
            }
        }
    }
}
