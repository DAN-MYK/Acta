import { Theme } from "../theme.slint";
import { ProgressIndicator, ListView } from "std-widgets.slint";
import { PageHeader } from "../components/page_header.slint";
import { MetricStrip } from "../components/MetricStrip.slint";
import { EmptyState } from "../components/EmptyState.slint";
import { StatusTabBar } from "../components/StatusTabBar.slint";
import { StatusBadge } from "../components/status_badge.slint";
import { ActionButton } from "../components/action_button.slint";
import { Icons } from "../components/icons.slint";
import { WaybillRow, WaybillStatus } from "../structs.slint";

export component WaybillList {

    // ── Вхідні дані (Rust → Slint) ─────────────────────────────────────────
    in property <[WaybillRow]> rows;
    in property <bool>         loading:       false;
    in property <[int]>        status-counts: [0, 0, 0, 0, 0];

    // ── KPI ─────────────────────────────────────────────────────────────────
    in property <int>    kpi-waybills-month: 0;
    in property <string> kpi-delivered: "0 ₴";
    in property <string> kpi-unsigned:  "0 ₴";
    in property <int>    kpi-overdue:   0;

    // ── Колбеки (Slint → Rust) ──────────────────────────────────────────────
    // 0=Усі, 1=Чернетки, 2=Виставлені, 3=Підписані, 4=Доставлені
    callback status-filter-changed(int);
    callback search-changed(string);
    callback row-selected(string);
    callback create-clicked();
    callback advance-status-clicked(string);
    callback edit-clicked(string);
    callback pdf-clicked(string);

    // ── Внутрішній стан ─────────────────────────────────────────────────────
    private property <int>           selected-row:    -1;
    private property <string>        selected-id:     "";
    private property <WaybillStatus> selected-status: WaybillStatus.draft;
    private property <string>        selected-number: "";
    property <int>                   active-tab:      0;

    min-width: Theme.list-min-width;
    min-height: Theme.list-min-height;

    VerticalLayout {
        spacing: 0;
        padding: 0;

        PageHeader {
            title: "Накладні";
            button-text: "+ Нова накладна";
            button-clicked => { root.create-clicked(); }
        }

        StatusTabBar {
            tab-names: ["Всі", "Чернетки", "Виставлені", "Підписані", "Доставлені"];
            tab-counts: root.status-counts;
            active-tab <=> root.active-tab;
            tab-changed(i) => { root.status-filter-changed(i); }
        }

        Rectangle {
            background: Theme.bg-page;
            vertical-stretch: 1;

            VerticalLayout {
                padding-top: Theme.space-6;
                padding-left: Theme.space-8;
                padding-right: Theme.space-8;
                padding-bottom: Theme.space-6;
                spacing: Theme.space-4;

                // ── MetricStrip ──────────────────────────────────────────────
                MetricStrip {
                    vertical-stretch: 0;
                    items: [
                        { label: "Накладних за місяць", value: root.kpi-waybills-month + "", subtext: "поточний місяць",        accent: Theme.primary },
                        { label: "Відвантажено",         value: root.kpi-delivered,            subtext: "доставлені цього місяця", accent: Theme.success },
                        { label: "Непідписаних",         value: root.kpi-unsigned,             subtext: "виставлені та підписані",accent: Theme.warning },
                        { label: "Прострочено",          value: root.kpi-overdue + "",         subtext: "більше 30 днів",         accent: root.kpi-overdue > 0 ? Theme.danger : Theme.text-muted },
                    ];
                }

                // ── Пошук ────────────────────────────────────────────────────
                Rectangle {
                    height: Theme.input-height;
                    vertical-stretch: 0;
                    background: Theme.bg-card;
                    border-radius: Theme.radius-md;
                    border-width: 1px;
                    border-color: Theme.border;
                    clip: true;

                    Image {
                        x: 12px;
                        y: (parent.height - 16px) / 2;
                        width: 16px;
                        height: 16px;
                        source: Icons.search;
                        image-fit: contain;
                        colorize: Theme.text-muted;
                    }

                    HorizontalLayout {
                        padding-left: 36px;
                        padding-right: Theme.space-3;

                        search-input := TextInput {
                            accessible-label: "Пошук накладних за номером або контрагентом";
                            vertical-alignment: center;
                            font-size: Theme.font-md;
                            color: Theme.text-primary;
                            edited => { root.search-changed(search-input.text); }
                        }
                    }

                    if search-input.text == "" : Text {
                        x: 36px;
                        height: parent.height;
                        width: parent.width - 44px;
                        text: "Пошук за номером або контрагентом...";
                        color: Theme.text-muted;
                        font-size: Theme.font-md;
                        vertical-alignment: center;
                    }
                }

                if root.loading : ProgressIndicator {
                    indeterminate: true;
                    vertical-stretch: 0;
                }

                // ── Таблиця ──────────────────────────────────────────────────
                Rectangle {
                    vertical-stretch: 1;
                    border-radius: Theme.radius-md;
                    border-width: 1px;
                    border-color: Theme.border;
                    clip: true;

                    VerticalLayout {
                        spacing: 0;

                        // Заголовок таблиці
                        Rectangle {
                            height: 40px;
                            vertical-stretch: 0;
                            background: Theme.table-header;

                            HorizontalLayout {
                                padding-left: Theme.space-4;
                                padding-right: Theme.space-4;

                                Text { text: "Номер";      color: Theme.text-second; font-size: Theme.font-base; font-weight: 500; horizontal-stretch: 2; vertical-alignment: center; }
                                Text { text: "Дата";       color: Theme.text-second; font-size: Theme.font-base; font-weight: 500; horizontal-stretch: 1; vertical-alignment: center; }
                                Text { text: "Контрагент"; color: Theme.text-second; font-size: Theme.font-base; font-weight: 500; horizontal-stretch: 3; vertical-alignment: center; }
                                Text { text: "Сума, ₴";    color: Theme.text-second; font-size: Theme.font-base; font-weight: 500; horizontal-stretch: 1; vertical-alignment: center; }
                                Text { text: "Статус";     color: Theme.text-second; font-size: Theme.font-base; font-weight: 500; width: 110px;           vertical-alignment: center; }
                            }
                        }

                        if !root.loading && root.rows.length == 0 : EmptyState {
                            icon: Icons.documents;
                            title: "Накладних ще немає";
                            description: "Натисніть «+ Нова накладна» щоб створити першу";
                        }

                        // Рядки керуються через Rc<VecModel<WaybillRow>> на стороні Rust.
                        // search-changed / status-filter-changed → Rust фільтрує і замінює VecModel.
                        ListView {
                            vertical-stretch: 1;

                            for row[i] in root.rows : Rectangle {
                                accessible-role: list-item;
                                accessible-label: "Накладна \{row.num}, \{row.date}, \{row.counterparty}, \{row.amount}, \{row.status-label}";

                                property <color> badge-color:
                                    row.status == WaybillStatus.delivered ? Theme.success :
                                    row.status == WaybillStatus.signed    ? Theme.primary :
                                    row.status == WaybillStatus.issued    ? Theme.warning :
                                    Theme.text-muted;
                                property <color> badge-bg:
                                    row.status == WaybillStatus.delivered ? Theme.success.with-alpha(12%) :
                                    row.status == WaybillStatus.signed    ? Theme.primary.with-alpha(10%) :
                                    row.status == WaybillStatus.issued    ? Theme.warning.with-alpha(12%) :
                                    Theme.text-muted.with-alpha(12%);
                                property <image> badge-icon:
                                    row.status == WaybillStatus.delivered ? Icons.paid   :
                                    row.status == WaybillStatus.signed    ? Icons.signed :
                                    row.status == WaybillStatus.issued    ? Icons.issued :
                                    Icons.draft;

                                height: Theme.row-height;
                                background: root.selected-row == i
                                    ? Theme.row-selected
                                    : (row-touch.has-hover
                                        ? Theme.row-hover
                                        : (Math.mod(i, 2) == 0 ? Theme.bg-card : Theme.row-stripe));
                                border-width: 1px;
                                border-color: Theme.border;
                                animate background { duration: 80ms; easing: ease; }

                                HorizontalLayout {
                                    padding-left: Theme.space-4;
                                    padding-right: Theme.space-4;

                                    Text {
                                        text: row.num;
                                        color: Theme.text-primary;
                                        font-size: Theme.font-md;
                                        font-weight: 500;
                                        horizontal-stretch: 2;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: row.date;
                                        color: Theme.text-second;
                                        font-size: Theme.font-md;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: row.counterparty;
                                        color: Theme.text-second;
                                        font-size: Theme.font-md;
                                        horizontal-stretch: 3;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: row.amount;
                                        color: Theme.text-primary;
                                        font-size: Theme.font-md;
                                        font-weight: 600;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    Rectangle {
                                        width: 110px;
                                        StatusBadge {
                                            label: row.status-label;
                                            badge-color: badge-color;
                                            badge-bg: badge-bg;
                                            icon: badge-icon;
                                        }
                                    }
                                }

                                row-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.selected-row    = i;
                                        root.selected-id     = row.id;
                                        root.selected-status = row.status;
                                        root.selected-number = row.num;
                                        root.row-selected(row.id);
                                    }
                                }
                            }
                        }
                    }
                }

                // ── Панель дій (з'являється при виборі рядка) ───────────────
                if root.selected-row >= 0 : HorizontalLayout {
                    height: 48px;
                    spacing: Theme.space-2;
                    vertical-stretch: 0;
                    alignment: center;

                    Text {
                        text: root.selected-number;
                        color: Theme.text-second;
                        font-size: Theme.font-md;
                        font-weight: 500;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    ActionButton {
                        width: 130px;
                        icon: Icons.edit;
                        text: "Редагувати";
                        clicked => {
                            if (root.selected-id != "") {
                                root.edit-clicked(root.selected-id);
                            }
                        }
                    }

                    ActionButton {
                        width: 80px;
                        icon: Icons.pdf;
                        text: "PDF";
                        clicked => {
                            if (root.selected-id != "") {
                                root.pdf-clicked(root.selected-id);
                            }
                        }
                    }

                    ActionButton {
                        width: 180px;
                        icon: Icons.arrow-right;
                        text: "Наступний статус";
                        primary: true;
                        disabled: root.selected-status == WaybillStatus.delivered;
                        clicked => {
                            if (root.selected-id != "") {
                                root.advance-status-clicked(root.selected-id);
                                root.selected-row    = -1;
                                root.selected-id     = "";
                                root.selected-status = WaybillStatus.draft;
                                root.selected-number = "";
                            }
                        }
                    }
                }
            }
        }
    }
}
