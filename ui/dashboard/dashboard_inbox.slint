// dashboard_inbox.slint — Режим "Вхідні" на дашборді
//
// Layout:
//   ┌──────────────────────┬────────────────────────────────────┐
//   │  Черга уваги (260px) │  Деталі вибраного елементу        │
//   │                      │                                    │
//   │  ⚠ Прострочено (N)   │  № РАХ-2025-042                    │
//   │  ≡ Непідписано (N)   │  ТОВ "Альфа-Бізнес"               │
//   │  ⊙ Без акту (N)      │  ₴ 24 500  •  15 днів тому        │
//   │  ✉ Непоєднано (N)    │                                    │
//   │                      │  [Дія]                             │
//   └──────────────────────┴────────────────────────────────────┘

import { Theme } from "../theme.slint";
import { ListView } from "std-widgets.slint";
import { Icons } from "../components/icons.slint";
import { InboxItem } from "../structs.slint";

export component DashboardInbox inherits Rectangle {
    in property <[InboxItem]> items;

    // KPI для смуги метрик у режимі Вхідні
    in property <string> kpi-overdue-amount: "0 ₴";
    in property <int>    kpi-overdue-count:  0;
    in property <int>    kpi-unsigned-count: 0;
    in property <int>    kpi-act-needed:     0;
    in property <int>    kpi-unmatched:      0;

    callback action-clicked(/* id */ string, /* item-type */ string);
    callback navigate-to(/* feature */ string, /* id */ string);

    private property <int>    selected-idx: -1;
    private property <string> selected-id:  "";

    background: Theme.bg-page;

    // Заголовок виробничої черги
    if root.items.length == 0 : Rectangle {
        background: Theme.bg-card;
        border-width: 1px;
        border-color: Theme.border;
        border-radius: Theme.radius-md;
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;

        VerticalLayout {
            alignment: center;
            spacing: Theme.space-3;
            padding: Theme.space-8;

            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 64px; height: 64px;
                    border-radius: 32px;
                    background: Theme.bg-success;
                    Image {
                        x: 18px; y: 18px;
                        width: 28px; height: 28px;
                        source: Icons.check;
                        image-fit: contain;
                        colorize: Theme.success;
                    }
                }
            }
            Text {
                text: "Все виконано!";
                font-size: Theme.font-xl;
                font-weight: 600;
                color: Theme.text-second;
                horizontal-alignment: center;
            }
            Text {
                text: "Немає документів, що потребують уваги";
                font-size: Theme.font-md;
                color: Theme.text-muted;
                horizontal-alignment: center;
            }
        }
    }

    if root.items.length > 0 : HorizontalLayout {
        spacing: Theme.space-4;

        // ── Ліва панель: список уваги ─────────────────────────────────────────
        Rectangle {
            width: 260px;
            background: Theme.bg-card;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: Theme.radius-md;
            clip: true;

            VerticalLayout {
                spacing: 0;

                // Заголовок
                Rectangle {
                    height: 44px;
                    background: Theme.table-header;
                    vertical-stretch: 0;

                    Text {
                        x: Theme.space-4;
                        y: (parent.height - self.preferred-height) / 2;
                        text: "Потребують уваги";
                        font-size: Theme.font-base;
                        font-weight: 600;
                        color: Theme.text-second;
                    }

                    Rectangle {
                        x: 0; y: parent.height - 1px;
                        width: parent.width; height: 1px;
                        background: Theme.border;
                    }
                }

                ListView {
                    vertical-stretch: 1;

                    for item[i] in root.items : Rectangle {
                        height: 64px;
                        background: root.selected-idx == i
                            ? Theme.row-selected
                            : (item-ta.has-hover ? Theme.row-hover : Theme.bg-card);
                        border-width: 1px;
                        border-color: Theme.border;
                        animate background { duration: 80ms; easing: ease; }

                        // Індикатор типу
                        Rectangle {
                            x: 0; y: 0; width: 3px; height: parent.height;
                            background:
                                item.item-type == "overdue"       ? Theme.danger   :
                                item.item-type == "unsigned"      ? Theme.warning  :
                                item.item-type == "act_needed"    ? Theme.primary  :
                                item.item-type == "unmatched"     ? Theme.purple   :
                                item.item-type == "waybill_needed"? Theme.primary  :
                                Theme.text-muted;
                        }

                        VerticalLayout {
                            padding-left: 16px;
                            padding-right: 12px;
                            spacing: 3px;
                            alignment: center;

                            Text {
                                text: item.doc-number != "" ? item.doc-number : item.action-label;
                                font-size: Theme.font-md;
                                font-weight: 600;
                                color: Theme.text-primary;
                                overflow: elide;
                            }
                            Text {
                                text: item.counterparty;
                                font-size: Theme.font-sm;
                                color: Theme.text-second;
                                overflow: elide;
                            }
                            Text {
                                text: item.days-ago;
                                font-size: Theme.font-xs;
                                color:
                                    item.item-type == "overdue" ? Theme.danger : Theme.text-muted;
                            }
                        }

                        item-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.selected-idx = i;
                                root.selected-id  = item.id;
                            }
                        }
                    }
                }
            }
        }

        // ── Права панель: деталі вибраного ────────────────────────────────────
        Rectangle {
            horizontal-stretch: 1;
            background: Theme.bg-card;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: Theme.radius-md;

            if root.selected-idx < 0 : VerticalLayout {
                alignment: center;
                spacing: Theme.space-3;
                padding: Theme.space-8;

                Text {
                    text: "Оберіть елемент зі списку";
                    font-size: Theme.font-lg;
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                }
            }

            if root.selected-idx >= 0 : VerticalLayout {
                padding: Theme.space-8;
                spacing: Theme.space-4;
                alignment: start;

                // Тип + номер
                HorizontalLayout {
                    spacing: Theme.space-3;
                    alignment: start;

                    Rectangle {
                        height: Theme.badge-height;
                        width: max(80px, type-label.preferred-width + 16px);
                        border-radius: Theme.radius-sm;
                        background:
                            root.items[root.selected-idx].item-type == "overdue"
                                ? Theme.bg-danger  :
                            root.items[root.selected-idx].item-type == "unsigned"
                                ? Theme.bg-warning :
                            Theme.bg-primary;

                        type-label := Text {
                            x: 0; y: 0;
                            width: parent.width;
                            height: parent.height;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            text:
                                root.items[root.selected-idx].item-type == "overdue"       ? "Прострочено"   :
                                root.items[root.selected-idx].item-type == "unsigned"      ? "Непідписано"   :
                                root.items[root.selected-idx].item-type == "act_needed"    ? "Без акту"      :
                                root.items[root.selected-idx].item-type == "unmatched"     ? "Непоєднано"    :
                                root.items[root.selected-idx].item-type == "draft"         ? "Чернетка"      :
                                root.items[root.selected-idx].item-type == "waybill_needed"? "Без накладної" :
                                "Увага";
                            font-size: Theme.font-sm;
                            font-weight: 600;
                            color:
                                root.items[root.selected-idx].item-type == "overdue"  ? Theme.danger  :
                                root.items[root.selected-idx].item-type == "unsigned" ? Theme.warning :
                                Theme.primary;
                        }
                    }
                }

                // Номер документа
                Text {
                    text: root.items[root.selected-idx].doc-number;
                    font-size: Theme.font-2xl;
                    font-weight: 700;
                    color: Theme.text-primary;
                }

                // Контрагент
                Text {
                    text: root.items[root.selected-idx].counterparty;
                    font-size: Theme.font-lg;
                    color: Theme.text-second;
                }

                // Сума + давність
                HorizontalLayout {
                    spacing: Theme.space-2;
                    alignment: start;

                    Text {
                        text: root.items[root.selected-idx].amount;
                        font-size: Theme.font-lg;
                        font-weight: 700;
                        color: Theme.text-primary;
                    }
                    Text {
                        text: "•";
                        color: Theme.text-muted;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.items[root.selected-idx].days-ago;
                        font-size: Theme.font-md;
                        color: root.items[root.selected-idx].item-type == "overdue"
                            ? Theme.danger : Theme.text-muted;
                        vertical-alignment: center;
                    }
                }

                Rectangle { height: 1px; background: Theme.border; }

                // Кнопка дії
                Rectangle {
                    height: Theme.btn-md-height;
                    width: max(160px, action-text.preferred-width + 48px);
                    border-radius: Theme.radius-md;
                    background: action-ta.has-hover ? Theme.primary-hover : Theme.primary;
                    animate background { duration: 120ms; easing: ease; }

                    action-text := Text {
                        x: 0; y: 0;
                        width: parent.width;
                        height: parent.height;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        text: root.items[root.selected-idx].action-label;
                        font-size: Theme.font-md;
                        font-weight: 600;
                        color: Theme.text-white;
                    }

                    action-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.action-clicked(
                                root.items[root.selected-idx].id,
                                root.items[root.selected-idx].item-type
                            );
                        }
                    }
                }
            }
        }
    }
}
