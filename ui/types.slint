// Acta — Data structure definitions
// These mirror the Rust model structs. Populated by Rust, consumed by Slint UI.
//
// MONEY CONTRACT RULE:
//   - Грошові суми ТІЛЬКИ як `string` (pre-formatted у Rust)
//   - `float` дозволено ТІЛЬКИ для: ChartBar (normalized 0.0–1.0)
//   - Ніколи не використовуй float для сум, балансів, чи грошових відображень

export enum NavScreen {
    Dashboard,
    Documents,
    Counterparties,
    Payments,
    Reports,
    Tasks,
    Settings,
}

// ── Document / Status enums ──────────────────────────────────────────────────

export enum DocumentKind {
    Invoice,   // Рахунок
    Act,       // Акт виконаних робіт
    Waybill,   // Видаткова накладна
}

export enum DocumentStatus {
    Draft,    // Чернетка
    Issued,   // Виставлено
    Signed,   // Підписано
    Paid,     // Оплачено
    Overdue,  // Прострочено
    Partial,  // Частково
}

export enum Priority {
    High,
    Medium,
    Low,
}

export enum Direction {
    In,   // Надходження
    Out,  // Списання
}

export struct PaletteItemData {
    kind: string,
    title: string,
    subtitle: string,
    shortcut: string,
    payload: string,
}

export struct CompanySwitcherItem {
    id: string,
    name: string,
    subtitle: string,
    initials: string,
    badge: string,
    active: bool,
}

export enum DocumentDirection {
    outgoing,
    incoming,
}

export enum CategoryKind {
    income,
    expense,
}

// ── Shared item structs ──────────────────────────────────────────────────────

export struct DocumentItem {
    id: string,
    kind: DocumentKind,
    number: string,
    date: string,          // "dd.mm.yyyy"
    counterparty: string,
    amount-str: string,    // pre-formatted by Rust
    status: DocumentStatus,
    linked-id: string,     // linked document id or ""
    selected: bool,        // true if document is currently selected
}

export struct DocumentDraftForm {
    id: string,
    kind: string,              // "invoice" | "act" | "waybill"
    counterparty-id: string,
    counterparty-name: string,
    title: string,
    number: string,
    date: string,              // "dd.mm.yyyy"
    notes: string,
}

export struct DocumentDraftItem {
    description: string,
    unit: string,
    quantity: string,
    price: string,
}

export struct CounterpartyDraftForm {
    id: string,
    title: string,
    name: string,
    edrpou: string,
    ipn: string,
    iban: string,
    address: string,
    phone: string,
    email: string,
    notes: string,
}

export struct CounterpartyItem {
    id: string,
    name: string,
    edrpou: string,
    kind: string,          // "ЮО" | "ФОП"
    balance-str: string,   // pre-formatted by Rust
    doc-count: int,
    overdue-count: int,
}

export struct PaymentItem {
    id: string,
    date: string,
    counterparty: string,
    amount-str: string,    // pre-formatted by Rust
    direction: Direction,
    matched-doc: string,   // document id or ""
    account: string,
}

export struct Act {
    id: string,
    number: string,
    direction: DocumentDirection,
    date: string,          // "dd.mm.yyyy"
    counterparty: string,
    amount-str: string,    // pre-formatted by Rust
    status: DocumentStatus,
}

export struct ActListRow {
    id: string,
    number: string,
    direction: DocumentDirection,
    date: string,          // "dd.mm.yyyy"
    counterparty-name: string,
    total-amount-str: string,  // pre-formatted by Rust
    status: DocumentStatus,
}

export struct Invoice {
    id: string,
    number: string,
    direction: DocumentDirection,
    date: string,          // "dd.mm.yyyy"
    counterparty: string,
    amount-str: string,    // pre-formatted by Rust
    status: DocumentStatus,
}

export struct InvoiceListRow {
    id: string,
    number: string,
    direction: DocumentDirection,
    date: string,          // "dd.mm.yyyy"
    counterparty-name: string,
    total-amount-str: string,  // pre-formatted by Rust
    status: DocumentStatus,
}

export struct TaskItem {
    id: string,
    title: string,
    description: string,
    due-date: string,      // "dd.mm.yyyy" or ""
    reminder-at: string,   // "dd.mm.yyyy" or ""
    done: bool,
    status-label: string,
    status-code: string,   // "open" | "in_progress" | "done" | "cancelled"
    priority: Priority,
    linked-doc: string,    // document id or ""
}

export struct AccountItem {
    bank-name: string,
    account-number: string,
    balance-str: string,    // pre-formatted by Rust
}

// ── Shell chrome model ──────────────────────────────────────────────────────

export struct ShellChrome {
    company-name: string,
    user-name: string,
    user-initials: string,
    user-role: string,
    documents-badge: int,
    tasks-badge: int,
}

// ── Dashboard model ──────────────────────────────────────────────────────────

export struct DashboardMetrics {
    revenue-month: string,  // pre-formatted by Rust
    expenses-month: string,
    net-month: string,
    outstanding: string,
    overdue: string,
    delta-revenue: string,  // e.g. "+13.4%"
    delta-expenses: string,
    delta-net: string,
}

export struct JournalRow {
    date: string,
    id: string,
    operation: string,
    counterparty: string,
    debit-str: string,      // "" if credit side
    credit-str: string,     // "" if debit side
    is-credit: bool,        // true = credit side
    status-label: string,
    status-tone: string,    // "success" | "warning" | "danger" | "muted" | "info"
}

export struct ChartBar {
    rev-h: float,    // revenue bar height 0.0–1.0
    exp-h: float,    // expenses bar height 0.0–1.0
    month: string,   // abbreviated label "Січ", "Лют", etc.
}

export struct InboxItem {
    kind: string,          // "overdue" | "unsigned" | "act-needed" | "unmatched"
    doc-id: string,
    doc-number: string,
    counterparty: string,
    amount-str: string,    // pre-formatted Rust
    age-days: int,
    action-label: string,  // "Нагадати" | "Підписати" | "Поєднати"
}

export struct ChainStep {
    doc-type: string,    // "invoice" | "act" | "waybill"
    doc-number: string,  // "" якщо документ відсутній
    amount-str: string,  // pre-formatted Rust
    status: string,      // "draft"|"issued"|"signed"|"paid"|"overdue"|""
    exists: bool,
}

export struct DocChainGroup {
    doc-id: string,      // ID батьківського документа
    steps: [ChainStep],
}

export struct DashboardViewData {
    metrics: DashboardMetrics,
    chart-bars: [ChartBar],
    journal: [JournalRow],
    accounts: [AccountItem],
    accounts-total: string,              // pre-formatted total balance
    tasks: [TaskItem],
    revenue-str: string,
    expenses-str: string,
    net-str: string,
    outstanding-str: string,
    overdue-str: string,
    delta-revenue-str: string,           // e.g. "+13.4%"
    delta-expenses-str: string,
    delta-net-str: string,
    ytd-total-str: string,               // year-to-date total
    ytd-revenue-str: string,
    ytd-expenses-str: string,
    spark-revenue: [float],              // normalized 0.0-1.0 for sparkline
    spark-expenses: [float],             // normalized 0.0-1.0 for sparkline
    inbox: [InboxItem],
}

// ── Counterparty detail model ────────────────────────────────────────────────

export struct CounterpartyDetails {
    id: string,
    name: string,
    kind: string,
    edrpou: string,
    ipn: string,
    vat: string,
    iban: string,
    bank: string,
    address: string,
    director: string,
    phone: string,
    email: string,
    client-since: string,
    balance-str: string,           // pre-formatted by Rust
    balance-is-negative: bool,     // true = we owe them
    doc-count: int,
    overdue-count: int,
    overdue-amount-str: string,    // pre-formatted by Rust
    last-contact-days: int,
    last-contact-date: string,
}

export struct DocumentsViewData {
    items: [DocumentItem],
    invoice-items: [DocumentItem],
    act-items: [DocumentItem],
    waybill-items: [DocumentItem],
    selected-ids: [string],
    total-count: int,
    page-count: int,
    chain-steps: [ChainStep],
    cp-doc-chains: [DocChainGroup],
}

export struct CounterpartiesViewData {
    items: [CounterpartyItem],
}

export struct CounterpartyDetailViewData {
    info: CounterpartyDetails,
    documents: [DocumentItem],
    payments: [PaymentItem],
}

// ── Report model ─────────────────────────────────────────────────────────────

export struct ReportMetrics {
    revenue: string,         // pre-formatted
    expenses: string,
    profit: string,
    margin: string,          // pre-formatted "15.3%"
    delta-revenue: string,   // e.g. "+22.1%"
    delta-expenses: string,
    delta-profit: string,
    delta-margin: string,
}

export struct ExpenseCategory {
    label: string,
    amount-str: string,    // pre-formatted by Rust
    percent: int,
}

export struct DrillRow {
    date: string,
    operation: string,
    counterparty: string,
    doc-id: string,
    amount-str: string,    // pre-formatted by Rust
}

export struct PaymentsViewData {
    items: [PaymentItem],
    incoming-str: string,
    outgoing-str: string,
    net-str: string,
    unmatched-str: string,
    incoming-sub: string,
    outgoing-sub: string,
    unmatched-count: int,
}

export struct ReportsViewData {
    metrics: ReportMetrics,
    chart-bars: [ChartBar],
    categories: [ExpenseCategory],
    drill-rows: [DrillRow],
}

// ── Settings model ───────────────────────────────────────────────────────────

export struct CompanyInfo {
    full-name: string,
    short-name: string,
    edrpou: string,
    ipn: string,
    address: string,
    director: string,
    iban: string,
    bank: string,
    vat-registered: bool,
    vat-cert: string,
}

export struct IntegrationItem {
    label: string,
    description: string,
    tag: string,
    enabled: bool,
}

export struct TeamMember {
    name: string,
    email: string,
    role: string,
    last-active: string,
}

export struct NumberingRow {
    doc-type: string,
    template: string,
    example: string,
    next-number: int,
}

export struct SettingsViewData {
    company-info: CompanyInfo,
    integrations: [IntegrationItem],
    team-members: [TeamMember],
    numbering-rows: [NumberingRow],
    last-backup-label: string,
    last-backup-file: string,
}

// ── Calendar / Day view ──────────────────────────────────────────────────────

export struct DayEvent {
    hour: int,
    title: string,
    subtitle: string,
    is-primary: bool,
}

export struct TasksViewData {
    open: [TaskItem],
    done: [TaskItem],
    all: [TaskItem],
    day-events: [DayEvent],
    open-count: int,
    high-count: int,
    done-count: int,
    today-label: string,
}

// ── Category model ───────────────────────────────────────────────────────────

export struct Category {
    id: string,
    name: string,
    kind: CategoryKind,
    parent-id: string,     // empty if no parent
    is-archived: bool,
}

export struct CategorySelectItem {
    id: string,
    name: string,
    kind: CategoryKind,
    depth: int,            // 0 = top level, 1 = subcategory
}
