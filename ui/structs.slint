// ui/structs.slint — Спільні структури даних для таблиць і форм
//
// Замінюють паралельні масиви (антипатерн):
//   замість `in property <[string]> row-ids; in property <[string]> row-dates; ...`
//   використовується `in property <[PaymentRow]> rows;`

export enum ActStatus {
    draft,
    issued,
    signed,
    paid,
}

export enum InvoiceStatus {
    draft,
    issued,
    signed,
    paid,
}

export enum WaybillStatus {
    draft,
    issued,
    signed,
    delivered,
}

export enum TaskStatus {
    open,
    in_progress,
    done,
    cancelled,
}

export enum TaskPriority {
    critical,
    high,
    normal,
    low,
}

export struct ActRow {
    id: string,
    num: string,
    date: string,
    counterparty: string,
    amount: string,
    status-label: string,
    status: ActStatus,
}

export struct InvoiceRow {
    id: string,
    num: string,
    date: string,
    counterparty: string,
    amount: string,
    status-label: string,
    status: InvoiceStatus,
}

export struct TaskRow {
    id: string,
    title: string,
    priority-label: string,
    due-date: string,
    reminder: string,
    status-label: string,
    status: TaskStatus,
    priority: TaskPriority,
}

export struct PaymentRow {
    id: string,
    date: string,
    counterparty: string,
    description: string,
    bank: string,
    amount: string,
    direction: string,     // "income" | "expense"
    reconciled: bool,
}

export struct WaybillRow {
    id: string,
    num: string,
    date: string,
    counterparty: string,
    amount: string,
    status-label: string,
    status: WaybillStatus,
}

export struct FormItemRow {
    description: string,
    quantity: string,
    unit: string,
    price: string,
    amount: string,
}

// ChainStep — крок ланцюжка документів (Рахунок → Акт → Накладна)
// doc-type: "invoice" | "act" | "waybill"
export struct ChainStep {
    doc-type:   string,
    doc-number: string,  // "" якщо відсутній
    amount:     string,
    status:     string,
    exists:     bool,
}

// CounterpartyActivityItem — подія у хронологічній стрічці контрагента
export struct CounterpartyActivityItem {
    date-label:  string,  // "Сьогодні" | "Вчора" | "23 кві"
    description: string,  // "Виставлено рахунок РАХ-2025-042 — ₴ 24 500"
    doc-type:    string,  // "invoice" | "act" | "payment" | "contract"
}

// InboxItem — елемент черги "Вхідні" на дашборді
// item-type: "overdue" | "unsigned" | "act_needed" | "unmatched" | "draft" | "waybill_needed"
export struct InboxItem {
    id:           string,
    item-type:    string,
    doc-number:   string,
    counterparty: string,
    amount:       string,
    days-ago:     string,
    action-label: string,
}

// CommandPaletteItem — результат глобального пошуку (Ctrl+K)
// kind: "header" = роздільник категорії, "item" = дія
// action: "navigate" | "create" | "open_doc" | "open_cp"
export struct CommandPaletteItem {
    kind:     string,
    action:   string,
    id:       string,
    title:    string,
    subtitle: string,
    shortcut: string,
}
