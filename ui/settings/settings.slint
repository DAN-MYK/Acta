import { Button, LineEdit, ComboBox, TextEdit } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Icons } from "../components/icons.slint";

export struct SettingsCategoryRow {
    name: string,
    kind: string,
    depth: int,
}

export struct SettingsTemplateRow {
    id: string,
    name: string,
    description: string,
    template-type: string,  // "act" | "invoice"
    is-default: bool,
}

export component SettingsPage {
    in property <string> company-name: "";
    in property <string> company-edrpou: "";
    in property <string> company-iban: "";
    in property <string> company-director: "";
    in property <string> company-address: "";
    in property <[SettingsCategoryRow]> category-rows: [];
    in property <[SettingsTemplateRow]> template-rows: [];

    // Template form overlay
    in-out property <bool>    show-template-form: false;
    in-out property <string> template-form-id: "";
    in-out property <string> template-form-name: "";
    in-out property <string> template-form-description: "";
    in-out property <string> template-form-type: "act";  // "act" | "invoice"
    in-out property <string> template-form-path: "";
    in-out property <bool>    template-form-is-default: false;

    callback edit-company-clicked();
    callback template-create-clicked();
    callback template-edit-clicked(string);
    callback template-delete-clicked(string);
    callback template-set-default-clicked(string);
    callback template-form-save(string, string, string, string, bool, string);
    callback template-form-cancel();

    private property <int> active-tab: 0;

    min-width: 600px;
    min-height: 400px;

    VerticalLayout {
        spacing: 0;

        // ── Topbar (64px, білий, з нижньою межею) ───────────────────────────
        Rectangle {
            height: Theme.topbar-height;
            vertical-stretch: 0;
            background: Theme.bg-card;

            HorizontalLayout {
                padding-left: Theme.page-padding-x;
                padding-right: Theme.page-padding-x;
                spacing: Theme.space-4;
                alignment: center;

                Text {
                    text: "Налаштування";
                    font-size: Theme.font-2xl;
                    font-weight: 600;
                    color: Theme.text-primary;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }
        }

        // ── Основний контент ─────────────────────────────────────────────────
        Rectangle {
            background: Theme.bg-page;
            vertical-stretch: 1;

            VerticalLayout {
                padding-top: 24px;
                padding-left: 32px;
                padding-right: 32px;
                padding-bottom: 24px;
                spacing: Theme.space-4;

                // ── Вкладки (underline style) ─────────────────────────────────
                Rectangle {
                    height: 40px;
                    vertical-stretch: 0;
                    background: transparent;

                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px; background: Theme.border;
                    }

                    HorizontalLayout {
                        spacing: Theme.space-1;
                        alignment: start;

                        for label[i] in ["Компанія", "Категорії", "Шаблони", "Вигляд", "Нумерація", "Інтеграції", "Резервне"]: Rectangle {
                            height: 40px;
                            width: max(76px, tab-lbl.preferred-width + 20px);

                            if root.active-tab == i : Rectangle {
                                x: 0; y: parent.height - 2px;
                                width: parent.width; height: 2px;
                                background: Theme.primary;
                            }

                            tab-lbl := Text {
                                x: 0; y: 0;
                                width: parent.width; height: parent.height;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                text: label;
                                font-size: Theme.font-base;
                                font-weight: root.active-tab == i ? 600 : 400;
                                color: root.active-tab == i ? Theme.primary : Theme.text-second;
                            }

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.active-tab = i; }
                            }
                        }
                    }
                }

                // ── Вкладка «Компанія» ────────────────────────────────────────
                if root.active-tab == 0 : Rectangle {
                    background: Theme.bg-card;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: Theme.radius-xl;
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding: Theme.space-6;
                        spacing: Theme.space-3;

                        HorizontalLayout {
                            Text {
                                text: "Реквізити активної компанії";
                                font-size: Theme.font-2xl;
                                font-weight: 700;
                                color: Theme.text-primary;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }

                            Button {
                                text: "Редагувати";
                                primary: true;
                                height: Theme.btn-md-height;
                                clicked => { root.edit-company-clicked(); }
                            }
                        }

                        for item in [
                            { label: "Назва",     value: root.company-name     },
                            { label: "ЄДРПОУ",    value: root.company-edrpou   },
                            { label: "IBAN",      value: root.company-iban     },
                            { label: "Директор",  value: root.company-director },
                            { label: "Адреса",    value: root.company-address  }
                        ]: Rectangle {
                            height: 40px;
                            border-radius: Theme.radius-md;
                            background: Theme.bg-gray;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;

                                Text {
                                    text: item.label;
                                    width: 120px;
                                    font-size: Theme.font-base;
                                    color: Theme.text-muted;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: item.value == "" ? "—" : item.value;
                                    font-size: Theme.font-md;
                                    color: Theme.text-primary;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // ── Вкладка «Категорії» ───────────────────────────────────────
                if root.active-tab == 1 : Rectangle {
                    background: Theme.bg-card;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: Theme.radius-xl;
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding: Theme.space-6;
                        spacing: Theme.space-3;

                        Text {
                            text: "Категорії доходів і витрат";
                            font-size: Theme.font-2xl;
                            font-weight: 700;
                            color: Theme.text-primary;
                        }

                        for row in root.category-rows: Rectangle {
                            height: 40px;
                            border-radius: Theme.radius-md;
                            background: Theme.bg-gray;

                            HorizontalLayout {
                                padding-left: 14px + (row.depth * 18px);
                                padding-right: 14px;
                                spacing: Theme.space-3;

                                Text {
                                    text: row.kind == "income" ? "Дохід" : "Витрата";
                                    width: 70px;
                                    font-size: Theme.font-sm;
                                    color: row.kind == "income" ? Theme.success : Theme.danger;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: row.depth > 0 ? "↳ " + row.name : row.name;
                                    font-size: Theme.font-md;
                                    color: Theme.text-primary;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // ── Вкладка «Шаблони» (tab 2) ────────────────────────────────
                if root.active-tab == 2 : VerticalLayout {
                    spacing: Theme.space-3;

                    // Заголовок + кнопка
                    HorizontalLayout {
                        Text {
                            text: "Шаблони документів";
                            font-size: Theme.font-2xl;
                            font-weight: 700;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Button {
                            text: "+ Створити";
                            primary: true;
                            height: Theme.btn-md-height;
                            clicked => { root.template-create-clicked(); }
                        }
                    }

                    // Список шаблонів
                    VerticalLayout {
                        spacing: Theme.space-2;

                        for row in root.template-rows : Rectangle {
                            height: 52px;
                            border-radius: Theme.radius-md;
                            background: row.is-default ? Theme.bg-success : Theme.bg-gray;
                            border-width: row.is-default ? 1px : 0px;
                            border-color: row.is-default ? Theme.success : Theme.border;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 10px;
                                spacing: Theme.space-3;
                                alignment: center;

                                // Радіо-індикатор дефолтного
                                Rectangle {
                                    width: 16px;
                                    height: 16px;
                                    border-radius: 8px;
                                    border-width: 2px;
                                    border-color: row.is-default ? Theme.success : Theme.border;
                                    background: row.is-default ? Theme.success : transparent;
                                    TouchArea {
                                        clicked => { root.template-set-default-clicked(row.id); }
                                    }
                                }

                                // Бейдж типу
                                Rectangle {
                                    width: 60px;
                                    height: 22px;
                                    border-radius: Theme.radius-sm;
                                    background: row.template-type == "act" ? Theme.bg-primary : Theme.bg-purple;

                                    Text {
                                        text: row.template-type == "act" ? "Акт" : "Накл.";
                                        color: row.template-type == "act" ? Theme.primary : Theme.purple;
                                        font-size: Theme.font-sm;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: Theme.space-1;
                                    alignment: center;

                                    Text {
                                        text: row.name;
                                        font-size: Theme.font-md;
                                        font-weight: 600;
                                        color: Theme.text-primary;
                                    }
                                    Text {
                                        text: row.description == "" ? row.template-type : row.description;
                                        font-size: Theme.font-sm;
                                        color: Theme.text-muted;
                                    }
                                }

                                Rectangle {
                                    width: 32px;
                                    height: Theme.btn-sm-height;
                                    border-radius: Theme.radius-sm;
                                    background: stg-edit-ta.has-hover ? Theme.btn-action-bg : Theme.bg-gray;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    animate background { duration: 80ms; easing: ease; }

                                    Image {
                                        x: 9px; y: 7px;
                                        width: 14px; height: 14px;
                                        source: Icons.edit;
                                        image-fit: contain;
                                        colorize: stg-edit-ta.has-hover ? Theme.primary : Theme.text-second;
                                    }

                                    stg-edit-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.template-edit-clicked(row.id); }
                                    }
                                }
                                Rectangle {
                                    width: 32px;
                                    height: Theme.btn-sm-height;
                                    border-radius: Theme.radius-sm;
                                    background: stg-del-ta.has-hover ? Theme.bg-danger : Theme.bg-gray;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    animate background { duration: 80ms; easing: ease; }

                                    Image {
                                        x: 9px; y: 7px;
                                        width: 14px; height: 14px;
                                        source: Icons.delete;
                                        image-fit: contain;
                                        colorize: stg-del-ta.has-hover ? Theme.danger : Theme.text-second;
                                    }

                                    stg-del-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.template-delete-clicked(row.id); }
                                    }
                                }
                            }
                        }
                    }

                    // Порожній стан
                    if root.template-rows.length == 0 : Rectangle {
                        height: 80px;
                        border-radius: Theme.radius-md;
                        background: Theme.bg-gray;

                        Text {
                            text: "Немає шаблонів. Натисніть «Створити».";
                            font-size: Theme.font-md;
                            color: Theme.text-muted;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                // ── Вкладка «Зовнішній вигляд» (tab 3) ───────────────────────
                if root.active-tab == 3 : VerticalLayout {
                    spacing: Theme.space-4;

                    Text {
                        text: "Зовнішній вигляд";
                        font-size: Theme.font-2xl;
                        font-weight: 700;
                        color: Theme.text-primary;
                    }

                    Rectangle {
                        background: Theme.bg-card;
                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: Theme.radius-md;
                        height: 56px;

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: Theme.space-3;
                            alignment: center;

                            Text {
                                text: "Тема";
                                font-size: Theme.font-base;
                                color: Theme.text-second;
                                width: 120px;
                                vertical-alignment: center;
                            }

                            for lbl[i] in ["Світла", "Темна", "Системна"]: Rectangle {
                                height: 30px;
                                width: 86px;
                                border-radius: Theme.radius-sm;
                                border-width: i == 0 ? 2px : 1px;
                                border-color: i == 0 ? Theme.primary : Theme.border;
                                background: i == 0 ? Theme.bg-primary : Theme.bg-card;

                                Text {
                                    x: 0; y: 0;
                                    width: parent.width; height: parent.height;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    text: lbl;
                                    font-size: Theme.font-sm;
                                    font-weight: i == 0 ? 600 : 400;
                                    color: i == 0 ? Theme.primary : Theme.text-second;
                                }

                                TouchArea { mouse-cursor: pointer; }
                            }
                        }
                    }

                    Rectangle {
                        background: Theme.bg-card;
                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: Theme.radius-md;
                        height: 56px;

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: Theme.space-3;
                            alignment: center;

                            Text {
                                text: "Розмір шрифту";
                                font-size: Theme.font-base;
                                color: Theme.text-second;
                                width: 120px;
                                vertical-alignment: center;
                            }

                            for lbl[i] in ["S", "M", "L"]: Rectangle {
                                height: 30px;
                                width: 48px;
                                border-radius: Theme.radius-sm;
                                border-width: i == 1 ? 2px : 1px;
                                border-color: i == 1 ? Theme.primary : Theme.border;
                                background: i == 1 ? Theme.bg-primary : Theme.bg-card;

                                Text {
                                    x: 0; y: 0;
                                    width: parent.width; height: parent.height;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    text: lbl;
                                    font-size: Theme.font-sm;
                                    font-weight: i == 1 ? 600 : 400;
                                    color: i == 1 ? Theme.primary : Theme.text-second;
                                }

                                TouchArea { mouse-cursor: pointer; }
                            }
                        }
                    }

                    Rectangle {
                        background: Theme.bg-card;
                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: Theme.radius-md;
                        height: 56px;

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: Theme.space-3;
                            alignment: center;

                            Text {
                                text: "Щільність";
                                font-size: Theme.font-base;
                                color: Theme.text-second;
                                width: 120px;
                                vertical-alignment: center;
                            }

                            for lbl[i] in ["Компактна", "Стандартна"]: Rectangle {
                                height: 30px;
                                width: 96px;
                                border-radius: Theme.radius-sm;
                                border-width: i == 1 ? 2px : 1px;
                                border-color: i == 1 ? Theme.primary : Theme.border;
                                background: i == 1 ? Theme.bg-primary : Theme.bg-card;

                                Text {
                                    x: 0; y: 0;
                                    width: parent.width; height: parent.height;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    text: lbl;
                                    font-size: Theme.font-sm;
                                    font-weight: i == 1 ? 600 : 400;
                                    color: i == 1 ? Theme.primary : Theme.text-second;
                                }

                                TouchArea { mouse-cursor: pointer; }
                            }
                        }
                    }

                    Text {
                        text: "Клавіатурні скорочення";
                        font-size: Theme.font-lg;
                        font-weight: 600;
                        color: Theme.text-primary;
                    }

                    Rectangle {
                        background: Theme.bg-card;
                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: Theme.radius-md;
                        vertical-stretch: 1;

                        VerticalLayout {
                            padding: Theme.space-4;
                            spacing: Theme.space-3;

                            for item in [
                                { action: "Новий акт",         shortcut: "Ctrl + N" },
                                { action: "Пошук / Палітра",   shortcut: "Ctrl + K" },
                                { action: "Дашборд",           shortcut: "G потім H" },
                                { action: "Документи",         shortcut: "G потім D" },
                                { action: "Контрагенти",       shortcut: "G потім C" },
                                { action: "Платежі",           shortcut: "G потім P" },
                                { action: "Задачі",            shortcut: "G потім T" },
                                { action: "Налаштування",      shortcut: "G потім S" },
                            ]: Rectangle {
                                height: 34px;
                                border-radius: Theme.radius-sm;

                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    alignment: center;

                                    Text {
                                        text: item.action;
                                        font-size: Theme.font-base;
                                        color: Theme.text-second;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                    }

                                    Rectangle {
                                        height: 22px;
                                        width: shortcut-text.preferred-width + 16px;
                                        border-radius: Theme.radius-sm;
                                        background: Theme.bg-gray;
                                        border-width: 1px;
                                        border-color: Theme.border;

                                        shortcut-text := Text {
                                            x: 0; y: 0;
                                            width: parent.width; height: parent.height;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            text: item.shortcut;
                                            font-size: Theme.font-xs;
                                            font-weight: 500;
                                            color: Theme.text-second;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ── Вкладка «Нумерація» (tab 4) ───────────────────────────
                if root.active-tab == 4 : VerticalLayout {
                    spacing: Theme.space-4;

                    Text {
                        text: "Нумерація документів";
                        font-size: Theme.font-2xl;
                        font-weight: 700;
                        color: Theme.text-primary;
                    }

                    Text {
                        text: "Шаблони формату номерів. Лічильник скидається щороку.";
                        font-size: Theme.font-sm;
                        color: Theme.text-muted;
                    }

                    for tpl in [
                        { doc: "Акт",              pattern: "АКТ-{YYYY}-{NNN}",  example: "АКТ-2026-001", counter: "42" },
                        { doc: "Рахунок",          pattern: "РАХ-{YYYY}-{NNN}",  example: "РАХ-2026-001", counter: "38" },
                        { doc: "Видаткова накладна", pattern: "НАК-{YYYY}-{NNN}", example: "НАК-2026-001", counter: "17" },
                    ]: Rectangle {
                        height: 72px;
                        background: Theme.bg-card;
                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: Theme.radius-md;

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: Theme.space-4;
                            alignment: center;

                            VerticalLayout {
                                width: 160px;
                                alignment: center;
                                spacing: Theme.space-1;
                                Text { text: tpl.doc; font-size: Theme.font-base; font-weight: 600; color: Theme.text-primary; }
                                Text { text: "Приклад: " + tpl.example; font-size: Theme.font-xs; color: Theme.text-muted; }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                height: 36px;
                                border-radius: Theme.radius-sm;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.bg-page;

                                Text {
                                    x: 12px; y: 0;
                                    height: parent.height;
                                    text: tpl.pattern;
                                    font-size: Theme.font-base;
                                    color: Theme.text-primary;
                                    vertical-alignment: center;
                                }
                            }

                            VerticalLayout {
                                width: 80px;
                                alignment: center;
                                spacing: Theme.space-1;
                                Text { text: "Лічильник"; font-size: Theme.font-xs; color: Theme.text-muted; horizontal-alignment: center; }
                                Text { text: tpl.counter; font-size: Theme.font-xl; font-weight: 700; color: Theme.primary; horizontal-alignment: center; }
                            }
                        }
                    }
                }

                // ── Вкладка «Інтеграції» (tab 5) ──────────────────────────
                if root.active-tab == 5 : VerticalLayout {
                    spacing: Theme.space-4;

                    Text {
                        text: "Інтеграції";
                        font-size: Theme.font-2xl;
                        font-weight: 700;
                        color: Theme.text-primary;
                    }

                    for item in [
                        { name: "BAS / M.E.Doc",  status: "Не підключено", connected: false },
                        { name: "Райффайзен",      status: "Не підключено", connected: false },
                        { name: "ПриватБанк",      status: "Не підключено", connected: false },
                        { name: "Monobank",        status: "Не підключено", connected: false },
                        { name: "Typst (PDF)",     status: "Встановлено",   connected: true  },
                        { name: "Дія.Підпис",      status: "Не підключено", connected: false },
                    ]: Rectangle {
                        height: 56px;
                        background: Theme.bg-card;
                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: Theme.radius-md;

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 12px;
                            spacing: Theme.space-3;
                            alignment: center;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: Theme.space-1;
                                Text { text: item.name; font-size: Theme.font-base; font-weight: 600; color: Theme.text-primary; }
                                Text {
                                    text: item.status;
                                    font-size: Theme.font-sm;
                                    color: item.connected ? Theme.success : Theme.text-muted;
                                }
                            }

                            Rectangle {
                                width: 8px; height: 8px;
                                border-radius: 4px;
                                background: item.connected ? Theme.success : Theme.border;
                            }

                            Rectangle {
                                width: 100px;
                                height: 30px;
                                border-radius: Theme.radius-sm;
                                background: Theme.bg-gray;
                                border-width: 1px;
                                border-color: Theme.border;

                                Text {
                                    x: 0; y: 0;
                                    width: parent.width; height: parent.height;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    text: item.connected ? "Налаштувати" : "Підключити";
                                    font-size: Theme.font-sm;
                                    font-weight: 500;
                                    color: item.connected ? Theme.primary : Theme.text-second;
                                }

                                TouchArea { mouse-cursor: pointer; }
                            }
                        }
                    }
                }

                // ── Вкладка «Резервне» (tab 6) ────────────────────────────
                if root.active-tab == 6 : VerticalLayout {
                    spacing: Theme.space-4;

                    Text {
                        text: "Резервне копіювання";
                        font-size: Theme.font-2xl;
                        font-weight: 700;
                        color: Theme.text-primary;
                    }

                    Rectangle {
                        background: Theme.bg-card;
                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: Theme.radius-md;
                        height: 56px;

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 12px;
                            spacing: Theme.space-3;
                            alignment: center;

                            Text {
                                text: "Папка";
                                font-size: Theme.font-base;
                                color: Theme.text-second;
                                width: 80px;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                height: 34px;
                                border-radius: Theme.radius-sm;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.bg-page;

                                Text {
                                    x: 12px; y: 0;
                                    height: parent.height;
                                    text: "~/Documents/Acta/backups";
                                    font-size: Theme.font-sm;
                                    color: Theme.text-second;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle {
                                width: 76px;
                                height: 34px;
                                border-radius: Theme.radius-sm;
                                background: Theme.bg-gray;
                                border-width: 1px;
                                border-color: Theme.border;

                                Text {
                                    x: 0; y: 0;
                                    width: parent.width; height: parent.height;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    text: "Змінити";
                                    font-size: Theme.font-sm;
                                    color: Theme.text-second;
                                }

                                TouchArea { mouse-cursor: pointer; }
                            }
                        }
                    }

                    Rectangle {
                        background: Theme.bg-card;
                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: Theme.radius-md;
                        height: 56px;

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 12px;
                            spacing: Theme.space-3;
                            alignment: center;

                            Text {
                                text: "Частота";
                                font-size: Theme.font-base;
                                color: Theme.text-second;
                                width: 80px;
                                vertical-alignment: center;
                            }

                            for lbl[i] in ["Щоденно", "Щотижнево", "Вручну"]: Rectangle {
                                height: 30px;
                                width: 86px;
                                border-radius: Theme.radius-sm;
                                border-width: i == 0 ? 2px : 1px;
                                border-color: i == 0 ? Theme.primary : Theme.border;
                                background: i == 0 ? Theme.bg-primary : Theme.bg-card;

                                Text {
                                    x: 0; y: 0;
                                    width: parent.width; height: parent.height;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    text: lbl;
                                    font-size: Theme.font-sm;
                                    font-weight: i == 0 ? 600 : 400;
                                    color: i == 0 ? Theme.primary : Theme.text-second;
                                }

                                TouchArea { mouse-cursor: pointer; }
                            }
                        }
                    }

                    HorizontalLayout {
                        Text {
                            text: "Останні резервні копії";
                            font-size: Theme.font-lg;
                            font-weight: 600;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        Rectangle {
                            width: 130px;
                            height: 32px;
                            border-radius: Theme.radius-sm;
                            background: Theme.primary;

                            Text {
                                x: 0; y: 0;
                                width: parent.width; height: parent.height;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                text: "Створити зараз";
                                font-size: Theme.font-sm;
                                font-weight: 600;
                                color: Theme.text-white;
                            }

                            TouchArea { mouse-cursor: pointer; }
                        }
                    }

                    Rectangle {
                        background: Theme.bg-card;
                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: Theme.radius-md;
                        vertical-stretch: 1;

                        VerticalLayout {
                            padding: Theme.space-4;
                            spacing: Theme.space-2;

                            for bk in [
                                { date: "20.04.2026  14:32", size: "2.4 МБ" },
                                { date: "19.04.2026  08:15", size: "2.3 МБ" },
                                { date: "18.04.2026  07:58", size: "2.3 МБ" },
                            ]: Rectangle {
                                height: 36px;
                                border-radius: Theme.radius-sm;
                                background: Theme.bg-gray;

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    alignment: center;
                                    Text {
                                        text: bk.date;
                                        font-size: Theme.font-sm;
                                        color: Theme.text-second;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: bk.size;
                                        font-size: Theme.font-sm;
                                        color: Theme.text-muted;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Modal overlay: Template Form ─────────────────────────────────────────
    if root.show-template-form : Rectangle {
        background: Theme.overlay;

        Rectangle {
            x: (parent.width - 480px) / 2;
            y: (parent.height - 400px) / 2;
            width: 480px;
            background: Theme.bg-card;
            border-radius: Theme.radius-xl;
            drop-shadow-blur: 40px;
            drop-shadow-color: Theme.shadow-lg;
            drop-shadow-offset-y: 12px;

            // Акцентна смужка зверху
            Rectangle {
                x: 0; y: 0; width: 480px; height: 4px;
                border-top-left-radius: Theme.radius-xl;
                border-top-right-radius: Theme.radius-xl;
                background: Theme.primary;
            }

            VerticalLayout {
                padding: Theme.space-6;
                spacing: Theme.space-4;

                Text {
                    text: root.template-form-id == "" ? "Новий шаблон" : "Редагувати шаблон";
                    font-size: Theme.font-2xl;
                    font-weight: 700;
                    color: Theme.text-primary;
                }

                // Назва
                VerticalLayout {
                    spacing: Theme.space-1;
                    Text { text: "Назва"; font-size: Theme.font-base; font-weight: 600; color: Theme.text-second; }
                    Rectangle {
                        height: 40px;
                        border-radius: Theme.radius-md;
                        border-width: 1px;
                        border-color: Theme.border;
                        LineEdit {
                            text: root.template-form-name;
                            placeholder-text: "Мій шаблон акту";
                        }
                    }
                }

                // Тип
                VerticalLayout {
                    spacing: Theme.space-1;
                    Text { text: "Тип документа"; font-size: Theme.font-base; font-weight: 600; color: Theme.text-second; }
                    HorizontalLayout {
                        spacing: Theme.space-2;
                        for label[idx] in ["Акт", "Накладна"]: Rectangle {
                            width: 100px;
                            height: Theme.btn-md-height;
                            border-radius: Theme.radius-md;
                            border-width: 2px;
                            border-color: (root.template-form-type == "act" ? idx == 0 : idx == 1) ? Theme.primary : Theme.border;
                            background: (root.template-form-type == "act" ? idx == 0 : idx == 1) ? Theme.bg-primary : Theme.bg-card;
                            animate background { duration: 100ms; easing: ease; }

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.template-form-type = (idx == 0) ? "act" : "invoice";
                                    root.template-form-path = (idx == 0) ? "templates/act.typ" : "templates/invoice.typ";
                                }
                            }
                            Text {
                                text: label;
                                color: (root.template-form-type == "act" ? idx == 0 : idx == 1) ? Theme.primary : Theme.text-muted;
                                font-size: Theme.font-md;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Шлях до файлу
                VerticalLayout {
                    spacing: Theme.space-1;
                    Text { text: "Шлях до .typ файлу"; font-size: Theme.font-base; font-weight: 600; color: Theme.text-second; }
                    Rectangle {
                        height: 40px;
                        border-radius: Theme.radius-md;
                        border-width: 1px;
                        border-color: Theme.border;
                        LineEdit {
                            text: root.template-form-path;
                            placeholder-text: "templates/act.typ";
                        }
                    }
                }

                // Опис
                VerticalLayout {
                    spacing: Theme.space-1;
                    Text { text: "Опис (необов'язково)"; font-size: Theme.font-base; font-weight: 600; color: Theme.text-second; }
                    Rectangle {
                        height: 60px;
                        border-radius: Theme.radius-md;
                        border-width: 1px;
                        border-color: Theme.border;
                        TextEdit {
                            text: root.template-form-description;
                            placeholder-text: "Опис шаблону...";
                        }
                    }
                }

                // Дефолтний
                HorizontalLayout {
                    spacing: Theme.space-2;
                    alignment: center;

                    Rectangle {
                        width: 20px;
                        height: 20px;
                        border-radius: Theme.radius-sm;
                        border-width: 2px;
                        border-color: Theme.primary;
                        background: root.template-form-is-default ? Theme.primary : transparent;

                        TouchArea {
                            clicked => { root.template-form-is-default = !root.template-form-is-default; }
                        }
                    }
                    Text {
                        text: "Використовувати як дефолтний для цього типу";
                        font-size: Theme.font-md;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                    }
                }

                // Кнопки
                HorizontalLayout {
                    spacing: Theme.space-3;
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: "Скасувати";
                        height: Theme.btn-md-height;
                        clicked => { root.template-form-cancel(); }
                    }
                    Button {
                        text: "Зберегти";
                        primary: true;
                        height: Theme.btn-md-height;
                        clicked => { root.template-form-save(root.template-form-name, root.template-form-description, root.template-form-type, root.template-form-path, root.template-form-is-default, root.template-form-id); }
                    }
                }
            }
        }
    }
}
