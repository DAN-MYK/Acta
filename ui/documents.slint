// Acta — Documents screen (Рахунки / Акти / Видаткові накладні)
// Default view: Tabbed list — clean table with tabs for each document type.
// Features: tab filter, search, bulk select bar, status badges, PDF/Edit/More actions.

import { AppTheme } from "design-tokens.slint";
import { DocumentItem, DocumentKind, DocumentStatus, ChainStep, DocumentDraftForm, DocumentDraftItem } from "types.slint";
import {
    Card, HDivider, VDivider, Badge, StatusDot,
    GhostButton, SecondaryButton, PrimaryButton, IconButton,
    SearchInput, HeadingSm, BulkBar, Checkbox, DocChain, InlineIcon
} from "components.slint";
import { LineEdit } from "std-widgets.slint";

// ── Tab item ──────────────────────────────────────────────────────────────────
component DocTab inherits Rectangle {
    in property <string> label;
    in property <int> count;
    in property <bool> active: false;
    callback clicked;

    property <bool> hovered: false;

    height: 46px;
    background: transparent;

    // Active underline
    if active : Rectangle {
        x: 0;
        y: root.height - 2px;
        width: root.width;
        height: 2px;
        background: AppTheme.accent;
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        alignment: center;

        Text {
            text: root.label;
            color: active ? AppTheme.text : AppTheme.text-muted;
            font-size: 13px;
            font-family: AppTheme.font-sans;
            font-weight: active ? 500 : 400;
            vertical-alignment: center;
        }

        // Count pill
        Rectangle {
            height: 18px;
            min-width: count-text.preferred-width + 12px;
            border-radius: 9999px;
            background: AppTheme.bg-subtle;

            count-text := Text {
                text: root.count;
                color: AppTheme.text-muted;
                font-size: 11px;
                font-family: AppTheme.font-sans;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.move) {
                root.hovered = self.has-hover;
            }
        }
        clicked => { root.clicked(); }
    }
}

// ── Kind icon mapper ──────────────────────────────────────────────────────────
component KindCell inherits HorizontalLayout {
    in property <DocumentKind> kind;
    in property <image> icon-invoice;
    in property <image> icon-act;
    in property <image> icon-waybill;

    spacing: 6px;
    alignment: start;

    InlineIcon {
        icon:
            kind == DocumentKind.Invoice ? root.icon-invoice :
            kind == DocumentKind.Act     ? root.icon-act     :
            root.icon-waybill;
        icon-size: 14px;
        tint: AppTheme.text-muted;
    }

    Text {
        text:
            kind == DocumentKind.Invoice ? "Рахунок"            :
            kind == DocumentKind.Act     ? "Акт вик. робіт"    :
            "Видаткова накладна";
        color: AppTheme.text;
        font-size: 13px;
        font-family: AppTheme.font-sans;
        vertical-alignment: center;
    }
}

// ── Document table row ─────────────────────────────────────────────────────────
component DocRow inherits Rectangle {
    in property <DocumentItem> doc;
    in property <bool> selected: false;
    in property <int> index: 0;
    in property <image> icon-invoice;
    in property <image> icon-act;
    in property <image> icon-waybill;
    in property <image> icon-pdf;
    in property <image> icon-edit;
    in property <image> icon-more;
    in property <image> icon-check;
    in property <bool> chain-expanded: false;
    in property <[ChainStep]> chain-steps;
    callback chain-toggle(string);
    callback select-toggled(string, bool);
    callback row-clicked(string);
    callback pdf-clicked(string);
    callback edit-clicked(string);
    callback more-clicked(string);
    callback chain-create(string, string);

    property <bool> hovered: false;
    property <string> status-tone:
        doc.status == DocumentStatus.Issued  ? "info"    :
        doc.status == DocumentStatus.Signed  ? "success" :
        doc.status == DocumentStatus.Paid    ? "success" :
        doc.status == DocumentStatus.Overdue ? "danger"  :
        doc.status == DocumentStatus.Partial ? "warning" :
        "muted";
    property <string> status-label:
        doc.status == DocumentStatus.Draft   ? "Чернетка"  :
        doc.status == DocumentStatus.Issued  ? "Виставлено":
        doc.status == DocumentStatus.Signed  ? "Підписано" :
        doc.status == DocumentStatus.Paid    ? "Оплачено"  :
        doc.status == DocumentStatus.Overdue ? "Прострочено":
        "Частково";

    height: chain-expanded ? 136px : 46px;
    animate height { duration: 150ms; easing: ease-out; }
    background: hovered ? AppTheme.bg-subtle : (selected ? AppTheme.accent-soft : transparent);
    accessible-role: list-item;
    accessible-label: doc.number + ", " + (doc.kind == DocumentKind.Invoice ? "Рахунок" : doc.kind == DocumentKind.Act ? "Акт вик. робіт" : "Видаткова накладна") + ", " + doc.date + ", " + doc.counterparty + ", " + doc.amount-str + ", " + (doc.status == DocumentStatus.Draft ? "Чернетка" : doc.status == DocumentStatus.Issued ? "Виставлено" : doc.status == DocumentStatus.Signed ? "Підписано" : doc.status == DocumentStatus.Paid ? "Оплачено" : doc.status == DocumentStatus.Overdue ? "Прострочено" : "Частково");

    // Top hairline
    Rectangle {
        y: 0;
        width: root.width;
        height: 1px;
        background: AppTheme.border;
    }

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 0px;
        alignment: stretch;

        // Checkbox col
        Rectangle {
            width: 32px;

            Checkbox {
                checked: root.selected;
                check-icon: root.icon-check;
                toggled(v) => { root.select-toggled(root.doc.id, v); }
            }
        }

        // ID
        Text {
            text: root.doc.id;
            color: AppTheme.accent-text;
            font-family: AppTheme.font-mono;
            font-size: 12px;
            vertical-alignment: center;
            width: 150px;
        }

        // Type
        KindCell {
            kind: root.doc.kind;
            icon-invoice: root.icon-invoice;
            icon-act: root.icon-act;
            icon-waybill: root.icon-waybill;
            width: 180px;
        }

        // Date
        Text {
            text: root.doc.date;
            color: AppTheme.text-muted;
            font-size: 13px;
            font-family: AppTheme.font-sans;
            vertical-alignment: center;
            width: 100px;
        }

        // Counterparty
        Text {
            text: root.doc.counterparty;
            color: AppTheme.text;
            font-size: 13px;
            font-family: AppTheme.font-sans;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        // Status badge
        HorizontalLayout {
            spacing: 6px;
            width: 130px;

            StatusDot { tone: root.status-tone; }

            Badge {
                text: root.status-label;
                tone: root.status-tone;
            }
        }

        // Amount
        Text {
            text: root.doc.amount-str;
            color: AppTheme.text;
            font-family: AppTheme.font-mono;
            font-size: 13px;
            font-weight: 500;
            vertical-alignment: center;
            horizontal-alignment: right;
            width: 130px;
        }

        // Chain toggle button
        Rectangle {
            width: 30px; height: 30px;
            border-radius: AppTheme.radius-sm;
            background: chain-ta.has-hover ? AppTheme.bg-hover : transparent;

            Text {
                text: root.chain-expanded ? "▲" : "▼";
                color: AppTheme.text-faint;
                font-size: 9px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            chain-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.chain-toggle(root.doc.id); }
            }
        }

        // Actions
        HorizontalLayout {
            spacing: 2px;
            width: 90px;
            alignment: end;

            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: AppTheme.radius-md;
                background: pdf-hover.has-hover ? AppTheme.bg-subtle : transparent;
                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: root.icon-pdf;
                    width: 15px;
                    height: 15px;
                    colorize: AppTheme.text-muted;
                    image-fit: contain;
                }
                pdf-hover := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.pdf-clicked(root.doc.id); }
                }
            }

            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: AppTheme.radius-md;
                background: edit-hover.has-hover ? AppTheme.bg-subtle : transparent;
                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: root.icon-edit;
                    width: 15px;
                    height: 15px;
                    colorize: AppTheme.text-muted;
                    image-fit: contain;
                }
                edit-hover := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.edit-clicked(root.doc.id); }
                }
            }

            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: AppTheme.radius-md;
                background: more-hover.has-hover ? AppTheme.bg-subtle : transparent;
                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: root.icon-more;
                    width: 15px;
                    height: 15px;
                    colorize: AppTheme.text-muted;
                    image-fit: contain;
                }
                more-hover := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.more-clicked(root.doc.id); }
                }
            }
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.move) {
                root.hovered = self.has-hover;
            }
        }
        clicked => { root.row-clicked(root.doc.id); }
    }

    if chain-expanded : Rectangle {
        y: 46px;
        height: 90px;
        width: root.width;
        background: AppTheme.bg-subtle;

        Rectangle {
            y: 0; width: root.width; height: 1px;
            background: AppTheme.border;
        }

        DocChain {
            x: 18px; y: 10px;
            width: root.width - 36px;
            steps: root.chain-steps;
            create-next(t) => { root.chain-create(t, root.doc.id); }
        }
    }
}

component DraftField inherits Rectangle {
    in property <string> label;
    in property <string> placeholder;
    in-out property <string> value;

    height: 58px;

    VerticalLayout {
        spacing: 6px;

        Text {
            text: root.label;
            color: AppTheme.text-muted;
            font-size: 11px;
            font-family: AppTheme.font-sans;
            font-weight: 600;
        }

        Rectangle {
            height: 32px;
            background: AppTheme.bg;
            border-width: 1px;
            border-color: AppTheme.border;
            border-radius: AppTheme.radius-md;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;

                input := LineEdit {
                    text <=> root.value;
                    font-size: 12.5px;
                    font-family: AppTheme.font-sans;
                    accessible-label: root.label;
                }

                if root.value == "" : Text {
                    text: root.placeholder;
                    color: AppTheme.text-faint;
                    font-size: 12.5px;
                    font-family: AppTheme.font-sans;
                    vertical-alignment: center;
                    accessible-role: none;
                }
            }
        }
    }
}

component DocumentTypeTile inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> kind;
    callback picked(string);

    height: 110px;
    width: 132px;
    border-radius: AppTheme.radius-xl;
    border-width: 1px;
    border-color: tile-touch.has-hover ? AppTheme.accent : AppTheme.border;
    background: tile-touch.has-hover ? AppTheme.accent-soft : AppTheme.bg;

    VerticalLayout {
        padding: 16px;
        spacing: 6px;
        alignment: center;

        Text {
            text: root.title;
            color: AppTheme.text;
            font-size: 14px;
            font-family: AppTheme.font-sans;
            font-weight: 600;
            horizontal-alignment: center;
        }

        Text {
            text: root.subtitle;
            color: AppTheme.text-muted;
            font-size: 11.5px;
            font-family: AppTheme.font-sans;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }

    tile-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(root.kind); }
    }
}

component DocumentTypePickerOverlay {
    in-out property <bool> open;
    in property <string> counterparty-name;
    callback picked(string);

    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;

    Rectangle { background: #0a0b0d.with-alpha(0.32); }
    TouchArea { clicked => { root.open = false; } }

    FocusScope {
        width: parent.width;
        height: parent.height;
        init => { self.focus(); }
        key-pressed(e) => {
            if e.text == Key.Escape {
                root.open = false;
                accept
            } else {
                reject
            }
        }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 500px;
        height: 280px;
        background: AppTheme.bg-elevated;
        border-width: 1px;
        border-color: AppTheme.border;
        border-radius: AppTheme.radius-xl;
        drop-shadow-blur: 24px;
        drop-shadow-color: #1e1e1e.with-alpha(0.08);

        TouchArea { }

        VerticalLayout {
            padding: 20px;
            spacing: 16px;

            HorizontalLayout {
                height: 24px;
                HeadingSm { text: "Новий документ"; horizontal-stretch: 1; }
                GhostButton { text: "Закрити"; small: true; clicked => { root.open = false; } }
            }

            Text {
                text: root.counterparty-name == "" ?
                    "Оберіть тип документа." :
                    "Контрагент: " + root.counterparty-name;
                color: AppTheme.text-muted;
                font-size: 12px;
                font-family: AppTheme.font-sans;
            }

            HorizontalLayout {
                alignment: center;
                spacing: 12px;

                DocumentTypeTile {
                    title: "Рахунок";
                    subtitle: "Чернетка для виставлення оплати";
                    kind: "invoice";
                    picked(kind) => { root.picked(kind); root.open = false; }
                }
                DocumentTypeTile {
                    title: "Акт";
                    subtitle: "Чернетка акта виконаних робіт";
                    kind: "act";
                    picked(kind) => { root.picked(kind); root.open = false; }
                }
                DocumentTypeTile {
                    title: "Накладна";
                    subtitle: "Чернетка видаткової накладної";
                    kind: "waybill";
                    picked(kind) => { root.picked(kind); root.open = false; }
                }
            }
        }
    }
}

// ── Document context menu ─────────────────────────────────────────────────────
component DocContextMenu inherits Rectangle {
    in-out property <bool> open;
    in property <string> doc-id;
    in property <string> doc-status;
    callback send;
    callback archive;
    callback delete;
    callback close;

    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;

    Rectangle { background: transparent; }
    TouchArea { clicked => { root.close(); } }

    FocusScope {
        width: parent.width;
        height: parent.height;
        init => { self.focus(); }
        key-pressed(e) => {
            if e.text == Key.Escape {
                root.close();
                accept
            } else {
                reject
            }
        }
    }

    Rectangle {
        x: 150px;
        y: 100px;
        width: 200px;
        height: 140px;
        background: AppTheme.bg-elevated;
        border-width: 1px;
        border-color: AppTheme.border;
        border-radius: AppTheme.radius-lg;
        drop-shadow-blur: 12px;
        drop-shadow-color: #1e1e1e.with-alpha(0.12);

        VerticalLayout {
            padding: 4px;
            spacing: 2px;

            GhostButton {
                text: "Редагувати";
                small: true;
                clicked => { root.close(); }
            }

            Rectangle {
                height: 26px;
                opacity: root.doc-status == "Paid" || root.doc-status == "Issued" ? 0.5 : 1.0;

                GhostButton {
                    text: "Надіслати";
                    small: true;
                    clicked => { root.send(); root.close(); }
                }
            }

            GhostButton {
                text: "Архівувати";
                small: true;
                clicked => { root.archive(); root.close(); }
            }

            Rectangle { height: 1px; background: AppTheme.border; }

            GhostButton {
                text: "Видалити";
                small: true;
                clicked => { root.delete(); root.close(); }
            }
        }
    }
}

component DocumentDraftOverlay {
    in-out property <bool> open;
    in-out property <DocumentDraftForm> form;
    in property <[DocumentDraftItem]> items;
    callback saved(DocumentDraftForm);
    callback item-upserted(int, DocumentDraftItem);
    callback item-removed(int);

    private property <string> line-description: "";
    private property <string> line-unit: "";
    private property <string> line-quantity: "";
    private property <string> line-price: "";
    private property <int> edit-index: -1;

    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;

    Rectangle { background: #0a0b0d.with-alpha(0.32); }
    TouchArea { clicked => { root.open = false; } }

    FocusScope {
        width: parent.width;
        height: parent.height;
        init => { self.focus(); }
        key-pressed(e) => {
            if e.text == Key.Escape {
                root.open = false;
                accept
            } else {
                reject
            }
        }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 760px;
        height: 640px;
        background: AppTheme.bg-elevated;
        border-width: 1px;
        border-color: AppTheme.border;
        border-radius: AppTheme.radius-xl;
        drop-shadow-blur: 24px;
        drop-shadow-color: #1e1e1e.with-alpha(0.08);

        TouchArea { }

        VerticalLayout {
            padding: 20px;
            spacing: 14px;

            HorizontalLayout {
                height: 24px;
                HeadingSm { text: root.form.title; horizontal-stretch: 1; }
                GhostButton { text: "Закрити"; small: true; clicked => { root.open = false; } }
            }

            Text {
                text:
                    root.form.kind == "invoice" ? "Тип: рахунок" :
                    root.form.kind == "act" ? "Тип: акт" :
                    "Тип: накладна";
                color: AppTheme.text-faint;
                font-size: 11px;
                font-family: AppTheme.font-sans;
                font-weight: 600;
            }

            DraftField {
                label: "Контрагент";
                placeholder: "";
                value: root.form.counterparty-name;
            }

            HorizontalLayout {
                spacing: 12px;
                DraftField {
                    label: "Номер";
                    placeholder: "АКТ-2026-001";
                    value: root.form.number;
                    horizontal-stretch: 1;
                }
                DraftField {
                    label: "Дата";
                    placeholder: "дд.мм.рррр";
                    value: root.form.date;
                    horizontal-stretch: 1;
                }
            }

            DraftField {
                label: "Примітки";
                placeholder: "Короткий коментар або внутрішня нотатка";
                value: root.form.notes;
            }

            Text {
                text: "Позиції документа";
                color: AppTheme.text;
                font-size: 12.5px;
                font-family: AppTheme.font-sans;
                font-weight: 600;
            }

            Rectangle {
                border-width: 1px;
                border-color: AppTheme.border;
                border-radius: AppTheme.radius-lg;
                background: AppTheme.bg;
                min-height: 150px;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    if root.items.length == 0 : Text {
                        text: "Ще немає позицій. Додайте хоча б один рядок.";
                        color: AppTheme.text-faint;
                        font-size: 12px;
                        font-family: AppTheme.font-sans;
                    }

                    for item[i] in root.items : Rectangle {
                        border-width: 1px;
                        border-color: AppTheme.border;
                        border-radius: AppTheme.radius-md;
                        background: AppTheme.bg-elevated;
                        height: 56px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;
                            alignment: stretch;

                            Text {
                                text: item.description;
                                color: AppTheme.text;
                                font-size: 12.5px;
                                font-family: AppTheme.font-sans;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            Text {
                                text: item.quantity + " " + item.unit;
                                color: AppTheme.text-muted;
                                font-size: 11.5px;
                                font-family: AppTheme.font-mono;
                                width: 120px;
                                vertical-alignment: center;
                            }

                            Text {
                                text: item.price;
                                color: AppTheme.text;
                                font-size: 11.5px;
                                font-family: AppTheme.font-mono;
                                width: 110px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }

                            GhostButton {
                                text: "Редагувати";
                                small: true;
                                clicked => {
                                    root.edit-index = i;
                                    root.line-description = item.description;
                                    root.line-unit = item.unit;
                                    root.line-quantity = item.quantity;
                                    root.line-price = item.price;
                                }
                            }

                            GhostButton {
                                text: "Видалити";
                                small: true;
                                clicked => { root.item-removed(i); }
                            }
                        }
                    }
                }
            }

            Rectangle {
                border-width: 1px;
                border-color: AppTheme.border;
                border-radius: AppTheme.radius-lg;
                background: AppTheme.bg-subtle;

                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;

                    Text {
                        text: root.edit-index >= 0 ? "Редагування позиції" : "Нова позиція";
                        color: AppTheme.text;
                        font-size: 12.5px;
                        font-family: AppTheme.font-sans;
                        font-weight: 600;
                    }

                    DraftField {
                        label: "Опис";
                        placeholder: "Наприклад, послуги за квітень";
                        value: root.line-description;
                    }

                    HorizontalLayout {
                        spacing: 10px;

                        DraftField {
                            label: "Од.";
                            placeholder: "шт / год / посл.";
                            value: root.line-unit;
                            width: 120px;
                        }

                        DraftField {
                            label: "Кількість";
                            placeholder: "1";
                            value: root.line-quantity;
                            horizontal-stretch: 1;
                        }

                        DraftField {
                            label: "Ціна";
                            placeholder: "1000.00";
                            value: root.line-price;
                            horizontal-stretch: 1;
                        }
                    }

                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;

                        GhostButton {
                            text: "Очистити";
                            small: true;
                            clicked => {
                                root.edit-index = -1;
                                root.line-description = "";
                                root.line-unit = "";
                                root.line-quantity = "";
                                root.line-price = "";
                            }
                        }

                        PrimaryButton {
                            text: root.edit-index >= 0 ? "Оновити позицію" : "Додати позицію";
                            enabled: root.line-description != "" && root.line-quantity != "" && root.line-price != "";
                            clicked => {
                                root.item-upserted(root.edit-index, {
                                    description: root.line-description,
                                    unit: root.line-unit,
                                    quantity: root.line-quantity,
                                    price: root.line-price,
                                });
                                root.edit-index = -1;
                                root.line-description = "";
                                root.line-unit = "";
                                root.line-quantity = "";
                                root.line-price = "";
                            }
                        }
                    }
                }
            }

            Rectangle { vertical-stretch: 1; }

            HorizontalLayout {
                alignment: end;
                spacing: 8px;

                SecondaryButton { text: "Скасувати"; clicked => { root.open = false; } }
                PrimaryButton {
                    text: "Зберегти";
                    enabled: root.form.number != "" && root.form.date != "" && root.items.length > 0;
                    clicked => {
                        root.saved(root.form);
                        root.open = false;
                    }
                }
            }
        }
    }
}

// ── Documents screen ──────────────────────────────────────────────────────────
export component Documents inherits Rectangle {
    // Data from Rust
    in property <[DocumentItem]> all-docs;
    in property <[DocumentItem]> invoice-docs;
    in property <[DocumentItem]> act-docs;
    in property <[DocumentItem]> waybill-docs;

    // Selection state
    in-out property <[string]> selected-ids;

    // Search state
    in-out property <string> search-query: "";

    // Pagination
    in property <int> page: 1;
    in property <int> total-pages: 3;
    in property <int> shown-count;
    in property <int> total-count;

    // Icons
    in property <image> icon-search;
    in property <image> icon-plus;
    in property <image> icon-invoice;
    in property <image> icon-act;
    in property <image> icon-waybill;
    in property <image> icon-pdf;
    in property <image> icon-edit;
    in property <image> icon-more;
    in property <image> icon-check;
    in property <image> icon-chevron-left;
    in property <image> icon-chevron-right;
    in property <image> icon-close;
    // Callbacks
    callback tab-changed(string);   // "all" | "invoice" | "act" | "waybill"
    callback search-changed(string);
    callback row-selected(string, bool);
    callback selection-cleared;
    callback create-document;
    callback open-document(string);
    callback pdf-export(string);
    callback edit-document(string);
    callback more-actions(string);
    callback bulk-send;
    callback bulk-archive;
    callback bulk-delete;
    callback page-changed(int);

    in property <[ChainStep]> chain-steps;
    property <string> expanded-doc-id: "";
    callback chain-load(string);
    callback chain-create(string, string);
    in-out property <bool> show-type-picker: false;
    in-out property <bool> show-editor: false;
    in-out property <DocumentDraftForm> draft-form: {
        id: "",
        kind: "",
        counterparty-id: "",
        counterparty-name: "",
        title: "",
        number: "",
        date: "",
        notes: "",
    };
    in property <[DocumentDraftItem]> draft-items;
    callback create-kind-selected(string);
    callback draft-saved(DocumentDraftForm);
    callback draft-item-upserted(int, DocumentDraftItem);
    callback draft-item-removed(int);

    // Context menu state
    in-out property <bool> show-context-menu: false;
    in-out property <string> context-menu-doc-id: "";
    in-out property <string> context-menu-doc-status: "";
    callback context-send(string);
    callback context-archive(string);
    callback context-delete(string);

    // Internal tab state
    property <string> active-tab: "all";
    property <[DocumentItem]> visible-rows:
        active-tab == "invoice" ? invoice-docs :
        active-tab == "act"     ? act-docs     :
        active-tab == "waybill" ? waybill-docs :
        all-docs;

    // Pagination guards
    property <bool> can-prev-page: root.page > 1;
    property <bool> can-next-page: root.page < root.total-pages;

    background: AppTheme.bg;

    Flickable {
        VerticalLayout {
            padding: 20px;
            spacing: 16px;

            Card {
                padded: false;

                VerticalLayout {
                    // ── Bulk action bar (shown when rows selected) ─────────
                    if selected-ids.length > 0 : Rectangle {
                        height: 46px;
                        background: AppTheme.accent-soft;
                        border-radius: AppTheme.radius-xl;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 8px;
                            alignment: start;

                            // Clear selection
                            Rectangle {
                                width: 22px;
                                height: 22px;
                                border-radius: 4px;
                                background: clear-hover.has-hover ? AppTheme.accent : transparent;

                                Image {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    source: root.icon-close;
                                    width: 13px;
                                    height: 13px;
                                    colorize: AppTheme.accent-text;
                                    image-fit: contain;
                                }
                                clear-hover := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.selection-cleared(); }
                                }
                            }

                            Text {
                                text: "Вибрано: " + root.selected-ids.length;
                                color: AppTheme.accent-text;
                                font-size: 12.5px;
                                font-family: AppTheme.font-sans;
                                font-weight: 500;
                                vertical-alignment: center;
                            }

                            VDivider { height: 18px; }

                            SecondaryButton { text: "Надіслати"; small: true; clicked => { root.bulk-send(); } }
                            SecondaryButton { text: "Архів"; small: true; clicked => { root.bulk-archive(); } }
                            SecondaryButton { text: "Видалити"; small: true; clicked => { root.bulk-delete(); } }
                        }
                    }

                    // ── Tab strip + toolbar ────────────────────────────────
                    if selected-ids.length == 0 : Rectangle {
                        height: 46px;
                        border-radius: AppTheme.radius-xl;

                        // Bottom border
                        Rectangle {
                            y: parent.height - 1px;
                            width: parent.width;
                            height: 1px;
                            background: AppTheme.border;
                        }

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 2px;
                            alignment: stretch;

                            DocTab {
                                label: "Усі";
                                count: root.all-docs.length;
                                active: root.active-tab == "all";
                                clicked => {
                                    root.active-tab = "all";
                                    root.tab-changed("all");
                                }
                            }

                            DocTab {
                                label: "Рахунки";
                                count: root.invoice-docs.length;
                                active: root.active-tab == "invoice";
                                clicked => {
                                    root.active-tab = "invoice";
                                    root.tab-changed("invoice");
                                }
                            }

                            DocTab {
                                label: "Акти";
                                count: root.act-docs.length;
                                active: root.active-tab == "act";
                                clicked => {
                                    root.active-tab = "act";
                                    root.tab-changed("act");
                                }
                            }

                            DocTab {
                                label: "Видаткові накладні";
                                count: root.waybill-docs.length;
                                active: root.active-tab == "waybill";
                                clicked => {
                                    root.active-tab = "waybill";
                                    root.tab-changed("waybill");
                                }
                            }

                            Rectangle { horizontal-stretch: 1; }

                            // Toolbar
                            HorizontalLayout {
                                spacing: 6px;
                                padding: 8px;

                                SearchInput {
                                    search-icon: root.icon-search;
                                    placeholder: "Пошук № або контрагента…";
                                    value: root.search-query;
                                    width: 240px;
                                    edited(v) => { root.search-changed(v); }
                                }

                                SecondaryButton {
                                    text: "Фільтр";
                                }

                                PrimaryButton {
                                    text: "Створити";
                                    clicked => { root.create-document(); }
                                }
                            }
                        }
                    }

                    // ── Table header ───────────────────────────────────────
                    Rectangle {
                        height: 36px;
                        background: AppTheme.bg-subtle;

                        // Bottom border
                        Rectangle {
                            y: parent.height - 1px;
                            width: parent.width;
                            height: 1px;
                            background: AppTheme.border;
                        }

                        HorizontalLayout {
                            padding-left: 18px;
                            padding-right: 18px;
                            spacing: 0px;
                            alignment: stretch;

                            // Checkbox header
                            Rectangle {
                                width: 32px;

                                Rectangle {
                                    width: 14px;
                                    height: 14px;
                                    border-width: 1.5px;
                                    border-color: AppTheme.border-strong;
                                    border-radius: 3px;
                                }
                            }

                            Text { text: "НОМЕР";       color: AppTheme.text-faint; font-size: 10.5px; font-family: AppTheme.font-sans; font-weight: 600; letter-spacing: 0.8px; vertical-alignment: center; width: 150px; }
                            Text { text: "ТИП";         color: AppTheme.text-faint; font-size: 10.5px; font-family: AppTheme.font-sans; font-weight: 600; letter-spacing: 0.8px; vertical-alignment: center; width: 180px; }
                            Text { text: "ДАТА";        color: AppTheme.text-faint; font-size: 10.5px; font-family: AppTheme.font-sans; font-weight: 600; letter-spacing: 0.8px; vertical-alignment: center; width: 100px; }
                            Text { text: "КОНТРАГЕНТ";  color: AppTheme.text-faint; font-size: 10.5px; font-family: AppTheme.font-sans; font-weight: 600; letter-spacing: 0.8px; vertical-alignment: center; horizontal-stretch: 1; }
                            Text { text: "СТАТУС";      color: AppTheme.text-faint; font-size: 10.5px; font-family: AppTheme.font-sans; font-weight: 600; letter-spacing: 0.8px; vertical-alignment: center; width: 130px; }
                            Text { text: "СУМА";        color: AppTheme.text-faint; font-size: 10.5px; font-family: AppTheme.font-sans; font-weight: 600; letter-spacing: 0.8px; vertical-alignment: center; horizontal-alignment: right; width: 130px; }
                            Text { text: "ДІЇ";         color: AppTheme.text-faint; font-size: 10.5px; font-family: AppTheme.font-sans; font-weight: 600; letter-spacing: 0.8px; vertical-alignment: center; horizontal-alignment: right; width: 90px; }
                        }
                    }

                    // ── Document rows ──────────────────────────────────────
                    for doc[i] in visible-rows : DocRow {
                        doc: doc;
                        index: i;
                        selected: doc.selected;
                        icon-invoice: root.icon-invoice;
                        icon-act: root.icon-act;
                        icon-waybill: root.icon-waybill;
                        icon-pdf: root.icon-pdf;
                        icon-edit: root.icon-edit;
                        icon-more: root.icon-more;
                        icon-check: root.icon-check;
                        select-toggled(id, v) => { root.row-selected(id, v); }
                        row-clicked(id) => { root.open-document(id); }
                        pdf-clicked(id) => { root.pdf-export(id); }
                        edit-clicked(id) => { root.edit-document(id); }
                        more-clicked(id) => {
                            root.context-menu-doc-id = id;
                            root.context-menu-doc-status =
                                doc.status == DocumentStatus.Draft ? "Draft" :
                                doc.status == DocumentStatus.Issued ? "Issued" :
                                doc.status == DocumentStatus.Signed ? "Signed" :
                                doc.status == DocumentStatus.Paid ? "Paid" :
                                doc.status == DocumentStatus.Overdue ? "Overdue" :
                                "Partial";
                            root.show-context-menu = true;
                        }
                        chain-expanded: doc.id == root.expanded-doc-id;
                        chain-steps: root.chain-steps;
                        chain-toggle(id) => {
                            if (root.expanded-doc-id == id) {
                                root.expanded-doc-id = "";
                            } else {
                                root.expanded-doc-id = id;
                                root.chain-load(id);
                            }
                        }
                    }

                    // ── Pagination footer ──────────────────────────────────
                    Rectangle {
                        height: 44px;
                        border-radius: AppTheme.radius-xl;

                        // Top border
                        Rectangle {
                            y: 0;
                            width: root.width;
                            height: 1px;
                            background: AppTheme.border;
                        }

                        HorizontalLayout {
                            padding-left: 18px;
                            padding-right: 18px;
                            spacing: 6px;
                            alignment: stretch;

                            Text {
                                text: "Показано " + root.shown-count + " з " + root.total-count;
                                color: AppTheme.text-muted;
                                font-size: 12px;
                                font-family: AppTheme.font-sans;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: AppTheme.radius-md;
                                opacity: root.can-prev-page ? 1.0 : 0.5;
                                background: (root.can-prev-page && prev-hover.has-hover) ? AppTheme.bg-hover : transparent;
                                Image { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; source: root.icon-chevron-left; width: 15px; height: 15px; colorize: AppTheme.text-muted; image-fit: contain; }
                                prev-hover := TouchArea {
                                    mouse-cursor: root.can-prev-page ? pointer : default;
                                    clicked => {
                                        if (root.can-prev-page) {
                                            root.page-changed(root.page - 1);
                                        }
                                    }
                                }
                            }

                            Text {
                                text: root.page + " / " + root.total-pages;
                                color: AppTheme.text-muted;
                                font-size: 12px;
                                font-family: AppTheme.font-sans;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                                width: 50px;
                            }

                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: AppTheme.radius-md;
                                opacity: root.can-next-page ? 1.0 : 0.5;
                                background: (root.can-next-page && next-hover.has-hover) ? AppTheme.bg-hover : transparent;
                                Image { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; source: root.icon-chevron-right; width: 15px; height: 15px; colorize: AppTheme.text-muted; image-fit: contain; }
                                next-hover := TouchArea {
                                    mouse-cursor: root.can-next-page ? pointer : default;
                                    clicked => {
                                        if (root.can-next-page) {
                                            root.page-changed(root.page + 1);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.show-type-picker : DocumentTypePickerOverlay {
        open <=> root.show-type-picker;
        counterparty-name: root.draft-form.counterparty-name;
        picked(kind) => { root.create-kind-selected(kind); }
    }

    if root.show-editor : DocumentDraftOverlay {
        open <=> root.show-editor;
        form <=> root.draft-form;
        items: root.draft-items;
        saved(form) => { root.draft-saved(form); }
        item-upserted(index, item) => { root.draft-item-upserted(index, item); }
        item-removed(index) => { root.draft-item-removed(index); }
    }

    if root.show-context-menu : DocContextMenu {
        open <=> root.show-context-menu;
        doc-id: root.context-menu-doc-id;
        doc-status: root.context-menu-doc-status;
        send => { root.context-send(root.context-menu-doc-id); }
        archive => { root.context-archive(root.context-menu-doc-id); }
        delete => { root.context-delete(root.context-menu-doc-id); }
        close => { root.show-context-menu = false; }
    }
}
