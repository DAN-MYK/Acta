// Acta — Settings screen
// Left nav (6 sections) + right content area.
// Sections: Appearance, Company, Numbering, Integrations, Team, Backup.

import { AppTheme } from "design-tokens.slint";
import { CompanyInfo, IntegrationItem, TeamMember, NumberingRow } from "types.slint";
import {
    Card, HDivider, VDivider, Badge, StatusDot,
    GhostButton, SecondaryButton, PrimaryButton,
    HeadingSm, SectionLabel, ThemePreviewCard
} from "components.slint";

// ── Settings nav item ─────────────────────────────────────────────────────────
component SettingsNavItem inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked;

    height: 34px;
    border-radius: AppTheme.radius-sm;
    background: active ? AppTheme.accent-soft : transparent;

    Text {
        text: root.label;
        color: root.active ? AppTheme.accent-text : AppTheme.text-muted;
        font-size: 13px;
        font-family: AppTheme.font-sans;
        font-weight: root.active ? 500 : 400;
        x: 12px;
        width: root.width - 12px;
        vertical-alignment: center;
        horizontal-alignment: left;
    }

    TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// ── Field row (label + hint + content) ───────────────────────────────────────
component FieldRow inherits Rectangle {
    in property <string> label;
    in property <string> hint: "";

    height: self.preferred-height;

    HorizontalLayout {
        spacing: 24px;
        alignment: stretch;
        padding-bottom: 16px;

        VerticalLayout {
            width: 200px;
            spacing: 4px;

            Text {
                text: root.label;
                color: AppTheme.text;
                font-size: 13px;
                font-family: AppTheme.font-sans;
                font-weight: 500;
            }

            if root.hint != "" : Text {
                text: root.hint;
                color: AppTheme.text-muted;
                font-size: 11.5px;
                font-family: AppTheme.font-sans;
                wrap: word-wrap;
            }
        }

        @children
    }
}

// ── Keyboard shortcut row ─────────────────────────────────────────────────────
component KbdRow inherits Rectangle {
    in property <string> keys;
    in property <string> action;

    height: 36px;

    HorizontalLayout {
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 12px;
        alignment: start;

        Rectangle {
            width: 72px;
            height: 22px;
            background: AppTheme.bg-subtle;
            border-width: 1px;
            border-color: AppTheme.border;
            border-radius: 3px;

            Text {
                text: root.keys;
                color: AppTheme.text-muted;
                font-size: 11.5px;
                font-family: AppTheme.font-mono;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }

        Text {
            text: root.action;
            color: AppTheme.text-muted;
            font-size: 12.5px;
            font-family: AppTheme.font-sans;
            vertical-alignment: center;
        }
    }
}

// ── Density option button ─────────────────────────────────────────────────────
component DensityBtn inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked;

    height: 32px;
    min-width: lbl.preferred-width + 28px;
    background: active ? AppTheme.bg : transparent;
    border-radius: 4px;
    border-width: active ? 1px : 0px;
    border-color: AppTheme.border;

    lbl := Text {
        text: root.label;
        color: root.active ? AppTheme.text : AppTheme.text-muted;
        font-size: 12px;
        font-family: AppTheme.font-sans;
        font-weight: root.active ? 500 : 400;
        vertical-alignment: center;
        horizontal-alignment: center;
    }

    TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// ── Integration row ───────────────────────────────────────────────────────────
component IntegrationRow inherits Rectangle {
    in property <IntegrationItem> item;
    callback configure(string);

    height: 64px;

    Rectangle { y: 0; width: root.width; height: 1px; background: AppTheme.border; }

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        spacing: 16px;
        alignment: stretch;

        // Tag badge
        Rectangle {
            width: 52px;
            height: 32px;
            border-width: 1px;
            border-color: AppTheme.border;
            border-radius: AppTheme.radius-sm;

            Text {
                text: root.item.tag;
                color: AppTheme.text-muted;
                font-size: 11px;
                font-family: AppTheme.font-mono;
                font-weight: 500;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }

        // Label + desc
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            alignment: center;

            Text {
                text: root.item.label;
                color: AppTheme.text;
                font-size: 13px;
                font-family: AppTheme.font-sans;
                font-weight: 500;
            }

            Text {
                text: root.item.description;
                color: AppTheme.text-muted;
                font-size: 11.5px;
                font-family: AppTheme.font-sans;
            }
        }

        // Status + button
        HorizontalLayout {
            spacing: 12px;
            alignment: center;

            HorizontalLayout {
                spacing: 6px;
                alignment: center;

                StatusDot { tone: root.item.enabled ? "success" : "muted"; }
                Text {
                    text: root.item.enabled ? "Активно" : "Вимкнено";
                    color: root.item.enabled ? AppTheme.success : AppTheme.text-faint;
                    font-size: 12px;
                    font-family: AppTheme.font-mono;
                    vertical-alignment: center;
                }
            }

            SecondaryButton {
                text: root.item.enabled ? "Налаштувати" : "Підключити";
                small: true;
                clicked => { root.configure(root.item.label); }
            }
        }
    }
}

// ── Team member row ───────────────────────────────────────────────────────────
component TeamMemberRow inherits Rectangle {
    in property <TeamMember> member;
    in property <image> icon-more;

    height: 60px;

    Rectangle { y: 0; width: root.width; height: 1px; background: AppTheme.border; }

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        spacing: 0px;
        alignment: stretch;

        // Name + email
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 3px;
            alignment: center;

            Text {
                text: root.member.name;
                color: AppTheme.text;
                font-size: 13px;
                font-family: AppTheme.font-sans;
                font-weight: 500;
            }
            Text {
                text: root.member.email;
                color: AppTheme.text-faint;
                font-size: 11.5px;
                font-family: AppTheme.font-mono;
            }
        }

        // Role badge
        Rectangle {
            width: 120px;

            Rectangle {
                height: 22px;
                width: role-lbl.preferred-width + 16px;
                background: AppTheme.bg-subtle;
                border-width: 1px;
                border-color: AppTheme.border;
                border-radius: 3px;

                role-lbl := Text {
                    text: root.member.role;
                    color: AppTheme.text-muted;
                    font-size: 12px;
                    font-family: AppTheme.font-sans;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
        }

        // Last active
        Text {
            width: 160px;
            text: root.member.last-active;
            color: AppTheme.text-faint;
            font-size: 12px;
            font-family: AppTheme.font-sans;
            vertical-alignment: center;
        }

        // More button
        Rectangle {
            width: 28px;
            height: 28px;
            border-radius: AppTheme.radius-md;
            background: more-h.has-hover ? AppTheme.bg-hover : transparent;

            Image { source: root.icon-more; width: 14px; height: 14px; colorize: AppTheme.text-muted; image-fit: contain; }
            more-h := TouchArea { mouse-cursor: pointer; }
        }
    }
}

// ── Settings screen ───────────────────────────────────────────────────────────
export component Settings inherits Rectangle {
    // Data
    in property <CompanyInfo> company;
    in property <[IntegrationItem]> integrations;
    in property <[TeamMember]> team;
    in property <[NumberingRow]> numbering;

    // State
    in-out property <string> section: "appearance";  // appearance|company|numbering|integrations|team|backup
    in-out property <bool> dark-mode;
    in-out property <int> density: 1;   // 0=compact 1=comfortable 2=spacious

    // Backup info (pre-formatted)
    in property <string> last-backup-label;   // "Сьогодні 03:00"
    in property <string> last-backup-file;    // "acta-backup-20260420-0300.sqlite.gz · 12.4 MB"

    // Icons
    in property <image> icon-more;
    in property <image> icon-plus;
    in property <image> icon-check;

    // Callbacks
    callback section-changed(string);
    callback dark-mode-toggled(bool);
    callback density-changed(int);
    callback company-saved(CompanyInfo);
    callback integration-configure(string);
    callback team-invite;
    callback backup-now;
    callback backup-download;

    background: AppTheme.bg;

    HorizontalLayout {
        padding: 20px;
        spacing: 24px;
        alignment: start;

        // ── Left nav ───────────────────────────────────────────────────────
        VerticalLayout {
            width: 220px;
            spacing: 2px;

            SettingsNavItem {
                label: "Зовнішній вигляд";
                active: root.section == "appearance";
                clicked => { root.section = "appearance"; root.section-changed("appearance"); }
            }
            SettingsNavItem {
                label: "Компанія";
                active: root.section == "company";
                clicked => { root.section = "company"; root.section-changed("company"); }
            }
            SettingsNavItem {
                label: "Нумерація";
                active: root.section == "numbering";
                clicked => { root.section = "numbering"; root.section-changed("numbering"); }
            }
            SettingsNavItem {
                label: "Інтеграції";
                active: root.section == "integrations";
                clicked => { root.section = "integrations"; root.section-changed("integrations"); }
            }
            SettingsNavItem {
                label: "Команда";
                active: root.section == "team";
                clicked => { root.section = "team"; root.section-changed("team"); }
            }
            SettingsNavItem {
                label: "Резервні копії";
                active: root.section == "backup";
                clicked => { root.section = "backup"; root.section-changed("backup"); }
            }
        }

        // ── Right content ──────────────────────────────────────────────────
        Flickable {
            horizontal-stretch: 1;

            VerticalLayout {
                // ── Appearance ─────────────────────────────────────────────
                if root.section == "appearance" : Card {
                    VerticalLayout {
                        spacing: 0px;

                        HeadingSm { text: "Зовнішній вигляд"; }
                        Text {
                            text: "Застосовується лише на цьому пристрої.";
                            color: AppTheme.text-muted;
                            font-size: 12.5px;
                            font-family: AppTheme.font-sans;
                        }

                        // Theme selector
                        HDivider { }

                        FieldRow {
                            label: "Тема";
                            hint: "Світла для дня, темна — для вечора.";

                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;

                                // Light theme
                                ThemePreviewCard {
                                    label: "Світла";
                                    active: !root.dark-mode;
                                    icon-check: root.icon-check;
                                    preview-bg: #F6F5F1;
                                    preview-sidebar: #F0EEE8;
                                    preview-surface: #FFFFFF;
                                    preview-line-a: #D6D2C3;
                                    preview-line-b: #E5E2D8;
                                    clicked => { root.dark-mode = false; root.dark-mode-toggled(false); }
                                }

                                // Dark theme
                                ThemePreviewCard {
                                    label: "Темна";
                                    active: root.dark-mode;
                                    icon-check: root.icon-check;
                                    preview-bg: #262931;
                                    preview-sidebar: #2D3039;
                                    preview-surface: #31353E;
                                    preview-line-a: #464C58;
                                    preview-line-b: #3A3F49;
                                    clicked => { root.dark-mode = true; root.dark-mode-toggled(true); }
                                }
                            }
                        }

                        HDivider { }

                        // Density
                        FieldRow {
                            label: "Щільність";
                            hint: "Comfortable — більше повітря;\nCompact — більше рядків.";

                            Rectangle {
                                height: 38px;
                                width: 280px;
                                background: AppTheme.bg-elevated;
                                border-width: 1px;
                                border-color: AppTheme.border;
                                border-radius: AppTheme.radius-md;

                                HorizontalLayout {
                                    padding: 3px;
                                    spacing: 0px;

                                    DensityBtn {
                                        label: "Compact";
                                        active: root.density == 0;
                                        clicked => { root.density = 0; root.density-changed(0); }
                                    }
                                    DensityBtn {
                                        label: "Comfortable";
                                        active: root.density == 1;
                                        clicked => { root.density = 1; root.density-changed(1); }
                                    }
                                    DensityBtn {
                                        label: "Spacious";
                                        active: root.density == 2;
                                        clicked => { root.density = 2; root.density-changed(2); }
                                    }
                                }
                            }
                        }

                        HDivider { }

                        // Keyboard shortcuts
                        HorizontalLayout {
                            spacing: 24px;

                            Text {
                                width: 200px;
                                text: "Клавіатурні скорочення";
                                color: AppTheme.text;
                                font-size: 13px;
                                font-family: AppTheme.font-sans;
                                font-weight: 500;
                            }

                            VerticalLayout {
                                spacing: 0px;

                                KbdRow { keys: "⌘ K";   action: "Відкрити швидкі дії"; }
                                Rectangle { height: 1px; background: AppTheme.border; }
                                KbdRow { keys: "⌘ N";   action: "Новий документ"; }
                                Rectangle { height: 1px; background: AppTheme.border; }
                                KbdRow { keys: "G → D"; action: "Перейти на Головну"; }
                                Rectangle { height: 1px; background: AppTheme.border; }
                                KbdRow { keys: "G → I"; action: "Перейти на Документи"; }
                            }
                        }
                    }
                }

                // ── Company ────────────────────────────────────────────────
                if root.section == "company" : Card {
                    VerticalLayout {
                        spacing: 0px;

                        HeadingSm { text: "Реквізити компанії"; }
                        Text {
                            text: "Відображаються в усіх документах (рахунках, актах, видаткових).";
                            color: AppTheme.text-muted;
                            font-size: 12.5px;
                            font-family: AppTheme.font-sans;
                        }

                        // Field rows — read-only display (editable in Rust via dialog)
                        for i in [
                            { l: "Повна назва",     v: root.company.full-name,   mono: false },
                            { l: "Скорочена",       v: root.company.short-name,  mono: false },
                            { l: "ЄДРПОУ",          v: root.company.edrpou,      mono: true },
                            { l: "ІПН",             v: root.company.ipn,         mono: true },
                            { l: "Юридична адреса", v: root.company.address,     mono: false },
                            { l: "Директор",        v: root.company.director,    mono: false },
                            { l: "IBAN",            v: root.company.iban,        mono: true },
                            { l: "Банк",            v: root.company.bank,        mono: false },
                            { l: "Платник ПДВ",     v: root.company.vat-cert,    mono: false },
                        ] : Rectangle {
                            height: 46px;

                            Rectangle { y: 0; width: root.width; height: 1px; background: AppTheme.border; }

                            HorizontalLayout {
                                padding-top: 12px;
                                padding-bottom: 12px;
                                spacing: 24px;
                                alignment: stretch;

                                Text {
                                    width: 200px;
                                    text: i.l;
                                    color: AppTheme.text-muted;
                                    font-size: 13px;
                                    font-family: AppTheme.font-sans;
                                    vertical-alignment: center;
                                }

                                Text {
                                    horizontal-stretch: 1;
                                    text: i.v;
                                    color: AppTheme.text;
                                    font-size: i.mono ? 12.5px : 13px;
                                    font-family: i.mono ? AppTheme.font-mono : AppTheme.font-sans;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }

                        HorizontalLayout {
                            alignment: end;
                            spacing: 8px;

                            GhostButton { text: "Скасувати"; }
                            PrimaryButton { text: "Зберегти зміни"; clicked => { root.company-saved(root.company); } }
                        }
                    }
                }

                // ── Numbering ──────────────────────────────────────────────
                if root.section == "numbering" : Card {
                    VerticalLayout {
                        spacing: 0px;

                        HeadingSm { text: "Нумерація документів"; }
                        Text {
                            text: "Шаблон підтримує {YYYY}, {MM}, {NNNN}.";
                            color: AppTheme.text-muted;
                            font-size: 12.5px;
                            font-family: AppTheme.font-mono;
                        }

                        // Table header
                        Rectangle {
                            height: 36px;
                            background: AppTheme.bg-subtle;
                            border-radius: AppTheme.radius-sm;

                            HorizontalLayout {
                                padding-left: 0px;
                                padding-right: 0px;
                                spacing: 0px;
                                alignment: stretch;

                                Text { text: "ТИП";             color: AppTheme.text-faint; font-size: 10.5px; font-family: AppTheme.font-sans; font-weight: 600; letter-spacing: 1.2px; vertical-alignment: center; width: 120px; }
                                Text { text: "ШАБЛОН";          color: AppTheme.text-faint; font-size: 10.5px; font-family: AppTheme.font-sans; font-weight: 600; letter-spacing: 1.2px; vertical-alignment: center; horizontal-stretch: 1; }
                                Text { text: "ПРИКЛАД";         color: AppTheme.text-faint; font-size: 10.5px; font-family: AppTheme.font-sans; font-weight: 600; letter-spacing: 1.2px; vertical-alignment: center; horizontal-stretch: 1; }
                                Text { text: "НАСТУПНИЙ №";     color: AppTheme.text-faint; font-size: 10.5px; font-family: AppTheme.font-sans; font-weight: 600; letter-spacing: 1.2px; vertical-alignment: center; horizontal-alignment: right; width: 130px; }
                            }
                        }

                        for row in root.numbering : Rectangle {
                            height: 52px;

                            Rectangle { y: 0; width: root.width; height: 1px; background: AppTheme.border; }

                            HorizontalLayout {
                                spacing: 0px;
                                alignment: stretch;

                                Text {
                                    width: 120px;
                                    text: row.doc-type;
                                    color: AppTheme.text;
                                    font-size: 13px;
                                    font-family: AppTheme.font-sans;
                                    vertical-alignment: center;
                                }

                                // Template (display only)
                                Rectangle {
                                    horizontal-stretch: 1;

                                    Text {
                                        text: row.template;
                                        color: AppTheme.text-muted;
                                        font-size: 12px;
                                        font-family: AppTheme.font-mono;
                                        vertical-alignment: center;
                                    }
                                }

                                // Example
                                Text {
                                    horizontal-stretch: 1;
                                    text: row.example;
                                    color: AppTheme.accent-text;
                                    font-size: 12px;
                                    font-family: AppTheme.font-mono;
                                    vertical-alignment: center;
                                }

                                // Next number
                                Text {
                                    width: 130px;
                                    text: row.next-number;
                                    color: AppTheme.text;
                                    font-size: 12px;
                                    font-family: AppTheme.font-mono;
                                    vertical-alignment: center;
                                    horizontal-alignment: right;
                                }
                            }
                        }
                    }
                }

                // ── Integrations ───────────────────────────────────────────
                if root.section == "integrations" : Card {
                    padded: false;

                    VerticalLayout {
                        Rectangle {
                            height: 72px;

                            VerticalLayout {
                                alignment: center;
                                padding-left: 20px;
                                padding-right: 20px;
                                spacing: 4px;
                                HeadingSm { text: "Інтеграції"; }
                                Text {
                                    text: "Імпорт/експорт даних та синхронізація з банками.";
                                    color: AppTheme.text-muted;
                                    font-size: 12.5px;
                                    font-family: AppTheme.font-sans;
                                }
                            }

                            Rectangle { y: root.height - 1px; width: root.width; height: 1px; background: AppTheme.border; }
                        }

                        for item in root.integrations : IntegrationRow {
                            item: item;
                            configure(label) => { root.integration-configure(label); }
                        }
                    }
                }

                // ── Team ───────────────────────────────────────────────────
                if root.section == "team" : Card {
                    padded: false;

                    VerticalLayout {
                        // Header
                        HorizontalLayout {
                            padding-left: 20px;
                            padding-right: 20px;
                            padding-top: 16px;
                            padding-bottom: 14px;
                            alignment: stretch;
                            height: 70px;

                            VerticalLayout {
                                spacing: 4px;
                                alignment: center;
                                HeadingSm { text: "Команда"; }
                                Text {
                                    text: root.team.length + " користувачі · план «Бізнес»";
                                    color: AppTheme.text-muted;
                                    font-size: 12.5px;
                                    font-family: AppTheme.font-sans;
                                }
                            }

                            Rectangle { horizontal-stretch: 1; }

                            PrimaryButton {
                                text: "Запросити";
                                clicked => { root.team-invite(); }
                            }
                        }

                        // Table header
                        Rectangle {
                            height: 36px;
                            background: AppTheme.bg-subtle;

                            Rectangle { y: 0; width: root.width; height: 1px; background: AppTheme.border; }

                            HorizontalLayout {
                                padding-left: 20px;
                                padding-right: 20px;
                                spacing: 0px;
                                alignment: stretch;

                                Text { text: "КОРИСТУВАЧ";        color: AppTheme.text-faint; font-size: 10.5px; font-family: AppTheme.font-sans; font-weight: 600; letter-spacing: 1.2px; vertical-alignment: center; horizontal-stretch: 1; }
                                Text { text: "РОЛЬ";               color: AppTheme.text-faint; font-size: 10.5px; font-family: AppTheme.font-sans; font-weight: 600; letter-spacing: 1.2px; vertical-alignment: center; width: 120px; }
                                Text { text: "ОСТАННЯ АКТИВНІСТЬ"; color: AppTheme.text-faint; font-size: 10.5px; font-family: AppTheme.font-sans; font-weight: 600; letter-spacing: 1.2px; vertical-alignment: center; width: 160px; }
                                Rectangle { width: 48px; }
                            }
                        }

                        for member in root.team : TeamMemberRow {
                            member: member;
                            icon-more: root.icon-more;
                        }
                    }
                }

                // ── Backup ─────────────────────────────────────────────────
                if root.section == "backup" : Card {
                    VerticalLayout {
                        spacing: 0px;

                        HeadingSm { text: "Резервні копії"; }
                        Text {
                            text: "Автоматичне резервне копіювання бази даних.";
                            color: AppTheme.text-muted;
                            font-size: 12.5px;
                            font-family: AppTheme.font-sans;
                        }

                        // Last backup status card
                        Rectangle {
                            height: 68px;
                            border-width: 1px;
                            border-color: AppTheme.border;
                            border-radius: AppTheme.radius-md;

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                spacing: 14px;
                                alignment: stretch;

                                StatusDot { tone: "success"; }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 3px;
                                    alignment: center;

                                    Text {
                                        text: "Остання копія · " + root.last-backup-label;
                                        color: AppTheme.text;
                                        font-size: 13px;
                                        font-family: AppTheme.font-sans;
                                        font-weight: 500;
                                    }
                                    Text {
                                        text: root.last-backup-file;
                                        color: AppTheme.text-muted;
                                        font-size: 11.5px;
                                        font-family: AppTheme.font-mono;
                                    }
                                }

                                SecondaryButton {
                                    text: "Завантажити";
                                    small: true;
                                    clicked => { root.backup-download(); }
                                }
                                PrimaryButton {
                                    text: "Створити зараз";
                                    clicked => { root.backup-now(); }
                                }
                            }
                        }

                        HDivider { }

                        HorizontalLayout {
                            spacing: 24px;
                            padding-bottom: 16px;

                            VerticalLayout {
                                width: 200px;
                                spacing: 4px;

                                Text { text: "Розклад"; color: AppTheme.text; font-size: 13px; font-family: AppTheme.font-sans; font-weight: 500; }
                                Text { text: "Щодня у визначений час."; color: AppTheme.text-muted; font-size: 11.5px; font-family: AppTheme.font-sans; }
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;

                                Rectangle {
                                    height: 34px;
                                    width: 160px;
                                    border-radius: AppTheme.radius-sm;
                                    border-width: 1px;
                                    border-color: AppTheme.border;
                                    background: AppTheme.bg-elevated;

                                    Text {
                                        text: "Щодня";
                                        color: AppTheme.text;
                                        font-size: 13px;
                                        font-family: AppTheme.font-sans;
                                        x: 11px;
                                        width: parent.width - 11px;
                                        vertical-alignment: center;
                                        horizontal-alignment: left;
                                    }
                                }

                                Rectangle {
                                    height: 34px;
                                    width: 100px;
                                    border-radius: AppTheme.radius-sm;
                                    border-width: 1px;
                                    border-color: AppTheme.border;
                                    background: AppTheme.bg-elevated;

                                    Text {
                                        text: "03:00";
                                        color: AppTheme.text;
                                        font-size: 13px;
                                        font-family: AppTheme.font-mono;
                                        x: 11px;
                                        width: parent.width - 11px;
                                        vertical-alignment: center;
                                        horizontal-alignment: left;
                                    }
                                }
                            }
                        }

                        HDivider { }

                        HorizontalLayout {
                            spacing: 24px;
                            padding-bottom: 16px;

                            VerticalLayout {
                                width: 200px;
                                spacing: 4px;

                                Text { text: "Зберігати копій"; color: AppTheme.text; font-size: 13px; font-family: AppTheme.font-sans; font-weight: 500; }
                                Text { text: "Старіші видаляються автоматично."; color: AppTheme.text-muted; font-size: 11.5px; font-family: AppTheme.font-sans; }
                            }

                            Rectangle {
                                height: 34px;
                                width: 100px;
                                border-radius: AppTheme.radius-sm;
                                border-width: 1px;
                                border-color: AppTheme.border;
                                background: AppTheme.bg-elevated;

                                Text {
                                    text: "30";
                                    color: AppTheme.text;
                                    font-size: 13px;
                                    font-family: AppTheme.font-mono;
                                    vertical-alignment: center;
                                    horizontal-alignment: right;
                                }
                            }
                        }

                        HDivider { }

                        HorizontalLayout {
                            spacing: 24px;

                            Text {
                                width: 200px;
                                text: "Хмарне копіювання";
                                color: AppTheme.text;
                                font-size: 13px;
                                font-family: AppTheme.font-sans;
                                font-weight: 500;
                                vertical-alignment: center;
                            }

                            Text {
                                text: "Не підключено. Налаштувати Google Drive →";
                                color: AppTheme.text-muted;
                                font-size: 12.5px;
                                font-family: AppTheme.font-sans;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}
