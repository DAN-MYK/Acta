// Acta — Main application window
//
// AppWindow — root component який:
//   1. Тримає навігацію (NavScreen)
//   2. Передає дані з Rust у дочірні екрани
//   3. Пробрасує callbacks з екранів у Rust
//
// Кожен екран має власний .slint файл — тут ТІЛЬКИ wiring.

import { AppTheme } from "design-tokens.slint";
import { Icons } from "icons.slint";
import { Shell } from "shell.slint";
import { Dashboard } from "dashboard.slint";
import { Documents } from "documents.slint";
import { Counterparties } from "counterparties.slint";
import { Payments } from "payments.slint";
import { Reports } from "reports.slint";
import { Tasks } from "tasks.slint";
import { Settings } from "settings.slint";
import {
    NavScreen,
    ShellChrome, DashboardViewData, DocumentsViewData, CounterpartiesViewData,
    PaymentsViewData, ReportsViewData, TasksViewData, SettingsViewData,
    CompanyInfo, PaletteItemData,
} from "types.slint";

// ── AppWindow ─────────────────────────────────────────────────────────────────
export component AppWindow inherits Window {
    title: "Acta";
    preferred-width: 1440px;
    preferred-height: 900px;
    min-width: 1440px;
    min-height: 900px;
    background: AppTheme.bg;

    // ── Navigation ───────────────────────────────────────────────────────
    in-out property <NavScreen> current-screen: NavScreen.Dashboard;
    callback nav-changed(NavScreen);

    // ── Shell info ───────────────────────────────────────────────────────
    in property <ShellChrome> shell;

    // ── Screen contracts ────────────────────────────────────────────────
    in property <DashboardViewData> dashboard;
    in property <DocumentsViewData> documents;
    in property <CounterpartiesViewData> counterparties-screen;
    in property <PaymentsViewData> payments-screen;
    in property <ReportsViewData> reports-screen;
    in property <TasksViewData> tasks-screen;
    in property <SettingsViewData> settings-screen;

    // ── Screen callbacks ────────────────────────────────────────────────
    callback inbox-action(string, string);
    in-out property <int> docs-page: 1;
    callback doc-search-changed(string);
    callback doc-tab-changed(string);
    callback doc-toggled(string, bool);
    callback doc-selection-cleared;
    callback doc-open(string);
    callback doc-edit(string);
    callback doc-send(string);
    callback doc-more-actions(string);
    callback doc-bulk-send;
    callback doc-bulk-archive;
    callback doc-bulk-delete;
    callback doc-delete(string);
    callback doc-new;
    callback doc-page-changed(int);
    callback doc-chain-load(string);
    callback doc-chain-create(string, string);
    callback cp-selected(string);
    callback cp-search-changed(string);
    callback cp-new;
    callback cp-create-doc(string);
    callback cp-tab-changed(string);
    callback pay-import-csv;
    callback pay-sync-bank;
    callback pay-new;
    callback pay-link(string);
    callback rep-period-changed(int);
    callback rep-category-drilled(string);
    callback rep-export-csv;
    callback rep-export-pdf;
    callback task-toggled(string, bool);
    callback task-more(string);
    callback task-new;
    callback task-filter-changed(string);
    callback settings-section-changed(string);
    callback settings-dark-mode-toggled(bool);
    callback settings-density-changed(int);
    callback settings-company-saved(CompanyInfo);
    callback settings-integration-configure(string);
    callback settings-team-invite;
    callback settings-backup-now;
    callback settings-backup-download;

    // ── Command palette ──────────────────────────────────────────────────
    in property <[PaletteItemData]> palette-items;
    callback palette-query-changed(string);
    callback palette-item-activated(string);

    // ── Tasks form ───────────────────────────────────────────────────────
    callback task-save(string, string, string, string);

    // ── Internal state (UI-only, not exposed to Rust) ────────────────────
    private property <string> docs-tab-state: "all";
    private property <string> docs-search-state: "";
    private property <string> tasks-filter-state: "open";
    private property <string> rep-drill-state: "";
    private property <int> rep-period-state: 1;
    in-out property <string> cp-selected-id: "";
    in-out property <string> cp-search: "";
    private property <string> cp-detail-tab-state: "docs";
    private property <string> settings-section-state: "appearance";
    private property <bool> palette-open: false;

    // ── Shell ────────────────────────────────────────────────────────────
    Shell {
        width: root.width;
        height: root.height;

        current-screen: root.current-screen;
        company-name: root.shell.company-name;
        user-name: root.shell.user-name;
        user-initials: root.shell.user-initials;
        user-role: root.shell.user-role;
        documents-badge: root.shell.documents-badge;
        tasks-badge: root.shell.tasks-badge;
        is-dark: AppTheme.is-dark;
        cmd-palette-open: root.palette-open;
        cmd-palette-items: root.palette-items;

        // Icons from Icons global
        icon-home:           Icons.home;
        icon-documents:      Icons.documents;
        icon-counterparties: Icons.counterparties;
        icon-payments:       Icons.payments;
        icon-reports:        Icons.reports;
        icon-tasks:          Icons.tasks;
        icon-settings:       Icons.settings;
        icon-search:         Icons.search;
        icon-close:          Icons.close;
        icon-plus:           Icons.plus;
        icon-more:           Icons.more;
        icon-bell:           Icons.search;      // TODO: додати Bell.svg
        icon-sun:            Icons.uah;          // TODO: додати Sun.svg
        icon-moon:           Icons.uah;          // TODO: додати Moon.svg
        icon-chevron-down:   Icons.sort;         // TODO: додати ChevronDown.svg
        icon-star:           Icons.uah;          // TODO: додати Star.svg
        icon-enter:          Icons.arrow-right;
        logo:                Icons.home;

        navigate(screen) => {
            root.current-screen = screen;
            root.nav-changed(screen);
        }
        toggle-theme => {
            AppTheme.is-dark = !AppTheme.is-dark;
            root.settings-dark-mode-toggled(AppTheme.is-dark);
        }
        open-cmd-palette => { root.palette-open = true; }
        close-cmd-palette => { root.palette-open = false; }
        cmd-palette-query-changed(q) => { root.palette-query-changed(q); }
        cmd-palette-item-activated(p) => { root.palette-item-activated(p); }

        // ═══════════════════════════════════════════════════════════════
        // Screen routing — кожен екран отримує свої дані та callbacks
        // ═══════════════════════════════════════════════════════════════

        if root.current-screen == NavScreen.Dashboard : Dashboard {
            width: 100%;
            height: 100%;

            metrics: root.dashboard.metrics;
            chart-bars: root.dashboard.chart-bars;
            journal: root.dashboard.journal;
            accounts: root.dashboard.accounts;
            accounts-total: root.dashboard.accounts-total;
            tasks: root.dashboard.tasks;
            open-task-count: root.dashboard.tasks.length;
            revenue-str: root.dashboard.revenue-str;
            expenses-str: root.dashboard.expenses-str;
            net-str: root.dashboard.net-str;
            outstanding-str: root.dashboard.outstanding-str;
            overdue-str: root.dashboard.overdue-str;
            delta-revenue-str: root.dashboard.delta-revenue-str;
            delta-expenses-str: root.dashboard.delta-expenses-str;
            delta-net-str: root.dashboard.delta-net-str;
            ytd-total-str: root.dashboard.ytd-total-str;
            ytd-revenue-str: root.dashboard.ytd-revenue-str;
            ytd-expenses-str: root.dashboard.ytd-expenses-str;
            spark-revenue: root.dashboard.spark-revenue;
            spark-expenses: root.dashboard.spark-expenses;

            icon-check: Icons.check;
            icon-plus: Icons.plus;
            icon-arrow-right: Icons.arrow-right;
            icon-chevron-down: Icons.sort;

            inbox: root.dashboard.inbox;
            inbox-action(id, kind) => { root.inbox-action(id, kind); }
            task-toggled(id, done) => { root.task-toggled(id, done); }
            new-task => { root.task-new(); }
        }

        if root.current-screen == NavScreen.Documents : Documents {
            width: 100%;
            height: 100%;

            all-docs: root.documents.items;
            invoice-docs: root.documents.invoice-items;
            act-docs: root.documents.act-items;
            waybill-docs: root.documents.waybill-items;
            search-query: root.docs-search-state;
            selected-ids: root.documents.selected-ids;
            total-count: root.documents.total-count;
            page: root.docs-page;
            total-pages: root.documents.page-count;

            icon-search: Icons.search;
            icon-more: Icons.more;
            icon-plus: Icons.plus;
            icon-pdf: Icons.pdf;
            icon-invoice: Icons.documents;
            icon-act: Icons.documents;
            icon-waybill: Icons.documents;
            icon-edit: Icons.edit;
            icon-check: Icons.check;
            icon-chevron-left: Icons.arrow-left;
            icon-chevron-right: Icons.arrow-right;
            icon-close: Icons.close;
            chain-steps: root.documents.chain-steps;

            search-changed(q) => { root.docs-search-state = q; root.doc-search-changed(q); }
            tab-changed(t) => { root.docs-tab-state = t; root.doc-tab-changed(t); }
            row-selected(id, sel) => { root.doc-toggled(id, sel); }
            selection-cleared => { root.doc-selection-cleared(); }
            open-document(id) => { root.doc-open(id); }
            pdf-export(id) => { root.doc-send(id); }
            edit-document(id) => { root.doc-edit(id); }
            more-actions(id) => { root.doc-more-actions(id); }
            bulk-send => { root.doc-bulk-send(); }
            bulk-archive => { root.doc-bulk-archive(); }
            bulk-delete => { root.doc-bulk-delete(); }
            create-document => { root.doc-new(); }
            page-changed(p) => { root.docs-page = p; root.doc-page-changed(p); }
            chain-load(id) => { root.doc-chain-load(id); }
            chain-create(t, id) => { root.doc-chain-create(t, id); }
        }

        if root.current-screen == NavScreen.Counterparties : Counterparties {
            width: 100%;
            height: 100%;

            list: root.counterparties-screen.items;
            detail: root.counterparties-screen.detail;
            detail-docs: root.counterparties-screen.documents;
            detail-payments: root.counterparties-screen.payments;
            selected-id: root.cp-selected-id;
            search-query: root.cp-search;
            active-tab: root.cp-detail-tab-state;
            detail-balance-str: self.detail.balance-str;
            detail-balance-is-negative: self.detail.balance-is-negative;
            detail-overdue-str: self.detail.overdue-amount-str;

            icon-search: Icons.search;
            icon-plus: Icons.plus;
            icon-more: Icons.more;
            icon-edit: Icons.edit;

            doc-chains: root.documents.cp-doc-chains;

            select(id) => { root.cp-selected-id = id; root.cp-selected(id); }
            search-changed(q) => { root.cp-search = q; root.cp-search-changed(q); }
            tab-changed(t) => { root.cp-detail-tab-state = t; root.cp-tab-changed(t); }
            edit-cp(id) => { root.cp-selected(id); }
            create-doc(id) => { root.cp-create-doc(id); }
            chain-create(t, id) => { root.doc-chain-create(t, id); }
        }

        if root.current-screen == NavScreen.Payments : Payments {
            width: 100%;
            height: 100%;

            payments: root.payments-screen.items;
            incoming-str: root.payments-screen.incoming-str;
            outgoing-str: root.payments-screen.outgoing-str;
            net-str: root.payments-screen.net-str;
            unmatched-str: root.payments-screen.unmatched-str;
            incoming-sub: root.payments-screen.incoming-sub;
            outgoing-sub: root.payments-screen.outgoing-sub;
            unmatched-count: root.payments-screen.unmatched-count;

            icon-plus: Icons.plus;
            icon-link: Icons.link;

            import-csv => { root.pay-import-csv(); }
            sync-bank => { root.pay-sync-bank(); }
            new-payment => { root.pay-new(); }
            link-payment(id) => { root.pay-link(id); }
        }

        if root.current-screen == NavScreen.Reports : Reports {
            width: 100%;
            height: 100%;

            metrics: root.reports-screen.metrics;
            chart-bars: root.reports-screen.chart-bars;
            categories: root.reports-screen.categories;
            drill-rows: root.reports-screen.drill-rows;
            drill-category: root.rep-drill-state;
            period: root.rep-period-state;

            icon-calendar: Icons.calendar;
            icon-pdf: Icons.pdf;
            icon-close: Icons.close;

            period-changed(p) => { root.rep-period-state = p; root.rep-period-changed(p); }
            category-drilled(cat) => { root.rep-drill-state = cat; root.rep-category-drilled(cat); }
            export-csv => { root.rep-export-csv(); }
            export-pdf => { root.rep-export-pdf(); }
        }

        if root.current-screen == NavScreen.Tasks : Tasks {
            width: 100%;
            height: 100%;

            open-tasks: root.tasks-screen.open;
            done-tasks: root.tasks-screen.done;
            all-tasks: root.tasks-screen.all;
            day-events: root.tasks-screen.day-events;
            open-count: root.tasks-screen.open-count;
            high-count: root.tasks-screen.high-count;
            done-count: root.tasks-screen.done-count;
            today-label: root.tasks-screen.today-label;
            filter: root.tasks-filter-state;

            icon-check: Icons.check;
            icon-calendar: Icons.calendar;
            icon-more: Icons.more;
            icon-plus: Icons.plus;

            filter-changed(f) => { root.tasks-filter-state = f; root.task-filter-changed(f); }
            task-toggled(id, done) => { root.task-toggled(id, done); }
            task-more(id) => { root.task-more(id); }
            new-task => { root.task-new(); }
            task-save(t, p, d, r) => { root.task-save(t, p, d, r); }
        }

        if root.current-screen == NavScreen.Settings : Settings {
            width: 100%;
            height: 100%;

            company: root.settings-screen.company-info;
            integrations: root.settings-screen.integrations;
            team: root.settings-screen.team-members;
            numbering: root.settings-screen.numbering-rows;
            section: root.settings-section-state;
            dark-mode: AppTheme.is-dark;
            last-backup-label: root.settings-screen.last-backup-label;
            last-backup-file: root.settings-screen.last-backup-file;

            icon-more: Icons.more;
            icon-plus: Icons.plus;
            icon-check: Icons.check;

            section-changed(s) => { root.settings-section-state = s; root.settings-section-changed(s); }
            dark-mode-toggled(dark) => {
                AppTheme.is-dark = dark;
                root.settings-dark-mode-toggled(dark);
            }
            density-changed(d) => { root.settings-density-changed(d); }
            company-saved(c) => { root.settings-company-saved(c); }
            integration-configure(label) => { root.settings-integration-configure(label); }
            team-invite => { root.settings-team-invite(); }
            backup-now => { root.settings-backup-now(); }
            backup-download => { root.settings-backup-download(); }
        }
    }
}
