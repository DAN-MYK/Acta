                waybill-edit-id:        root.waybill-form-edit-id;
                total-amount:           root.waybill-form-total;
                is-edit-mode:           root.waybill-form-is-edit;
                counterparty-names:     root.waybill-form-cp-names;
                counterparty-ids:       root.waybill-form-cp-ids;
                items:                  root.waybill-form-items;
                category-names:         root.waybill-form-category-names;
                category-ids:           root.waybill-form-category-ids;
                waybill-category-index: root.waybill-form-category-index;
                contract-names:         root.waybill-form-contract-names;
                contract-ids:           root.waybill-form-contract-ids;
                waybill-contract-index: root.waybill-form-contract-index;

                save(n, d, c, notes, cat, con)   => { root.waybill-form-save(n, d, c, notes, cat, con); }
                update(n, d, c, notes, cat, con) => { root.waybill-form-update(n, d, c, notes, cat, con); }
                cancel                      => { root.waybill-form-cancel(); }
                add-item                    => { root.waybill-form-add-item(); }
                remove-item(i)              => { root.waybill-form-remove-item(i); }
                item-changed(idx, fld, val) => { root.waybill-form-item-changed(idx, fld, val); }
            }
        }
    }

    // ── Company Picker overlay ──────────────────────────────────────────────────
    // Показується при старті якщо компаній > 1 і не відомо яку обрати.
    // Rust встановлює show-company-picker=true, user обирає → callback company-select-clicked.
    if root.show-counterparty-card : Rectangle {
        background: Theme.overlay;

        Rectangle {
            width: parent.width - 80px;
            height: parent.height - 80px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 18px;
            background: Theme.bg-card;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;

            CounterpartyCard {
                width: parent.width;
                height: parent.height;
                cp-name: root.counterparty-card-name;
                cp-edrpou: root.counterparty-card-edrpou;
                cp-ipn: root.counterparty-card-ipn;
                cp-iban: root.counterparty-card-iban;
                cp-phone: root.counterparty-card-phone;
                cp-email: root.counterparty-card-email;
                cp-address: root.counterparty-card-address;
                stat-acts: root.counterparty-card-stat-acts;
                stat-invoices: root.counterparty-card-stat-invoices;
                stat-payments: root.counterparty-card-stat-payments;
                stat-contracts: root.counterparty-card-stat-contracts;
                acts: root.counterparty-card-acts;
                invoices: root.counterparty-card-invoices;
                payments: root.counterparty-card-payments;
                contracts: root.counterparty-card-contracts;
                tasks: root.counterparty-card-tasks;

                close-clicked => { root.counterparty-card-close-clicked(); }
                edit-clicked => { root.counterparty-card-edit-clicked(root.counterparty-card-id); }
            }
        }
    }

    // ── Overlay: картка акту ──────────────────────────────────────────────────
    if root.show-act-card : Rectangle {
        background: Theme.overlay;

        Rectangle {
            width: parent.width - 80px;
            height: parent.height - 80px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 18px;
            background: Theme.bg-card;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;

            ActCard {
                act-number:           root.act-card-number;
                act-date:             root.act-card-date;
                act-status:           root.act-card-status;
                act-status-label:     root.act-card-status-label;
                act-counterparty:     root.act-card-counterparty;
                act-total:            root.act-card-total;
                act-expected-payment: root.act-card-expected-payment;
                act-notes:            root.act-card-notes;
                act-items:            root.act-card-items;
                act-tasks:            root.act-card-tasks;

                close-clicked           => { root.act-card-close-clicked(); }
                edit-clicked            => { root.act-card-edit-clicked(root.act-card-id); }
                pdf-clicked             => { root.act-card-pdf-clicked(root.act-card-id); }
                advance-status-clicked(new-status)  => { root.act-card-advance-status-clicked(root.act-card-id, new-status); }
            }
        }
    }

    // ── Overlay: форма контрагента ────────────────────────────────────────────
    if root.show-cp-form : Rectangle {
        background: Theme.overlay;

        Rectangle {
            width: min(parent.width - 80px, 860px);
            height: parent.height - 80px;
            x: (parent.width  - self.width)  / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 18px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;

            CounterpartyForm {
                width: parent.width;
                height: parent.height;
                is-edit-mode: root.cp-form-is-edit;
                cp-edit-id:   root.cp-form-edit-id;
                cp-name:      root.cp-form-name;
                cp-edrpou:    root.cp-form-edrpou;
                cp-ipn:       root.cp-form-ipn;
                cp-iban:      root.cp-form-iban;
                cp-phone:     root.cp-form-phone;
                cp-email:     root.cp-form-email;
                cp-address:   root.cp-form-address;
                cp-notes:     root.cp-form-notes;

                save(nm, ed, ip, ib, ph, em, ad, nt)   => { root.cp-form-save(nm, ed, ip, ib, ph, em, ad, nt); }
                update(nm, ed, ip, ib, ph, em, ad, nt)  => { root.cp-form-update(nm, ed, ip, ib, ph, em, ad, nt); }
                cancel                               => { root.cp-form-cancel(); }
            }
        }
    }

    if root.show-company-picker : Rectangle {
        background: Theme.overlay;

        Rectangle {
            width: 680px;
            height: 700px;
            x: (parent.width  - self.width)  / 2;
            y: 100px;
            border-radius: 16px;
            background: Theme.bg-card;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 32px;
            drop-shadow-color: #00000033;

            VerticalLayout {
                padding: 32px;
                spacing: 16px;

                VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: "Acta";
                        font-size: 32px;
                        font-weight: 700;
                        color: Theme.text-primary;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Управлінський облік";
                        font-size: 14px;
                        color: Theme.text-muted;
                        horizontal-alignment: center;
                    }
                }

                VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: "Оберіть компанію";
                        font-size: 24px;
                        font-weight: 700;
                        color: Theme.text-primary;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "для продовження роботи";
                        font-size: 14px;
                        color: Theme.text-second;
                        horizontal-alignment: center;
                    }
                }

                Rectangle {
                    height: 44px;
                    background: Theme.bg-card;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: 10px;

                    Text {
                        x: 14px;
                        height: parent.height;
                        text: "🔍  Пошук компанії...";
                        color: Theme.text-muted;
                        font-size: 14px;
                        vertical-alignment: center;
                    }
                }

                ListView {
                    vertical-stretch: 1;

                    for c in root.company-rows : Rectangle {
                        height: 60px;
                        border-radius: 10px;
                        background: pick-touch.has-hover ? Theme.bg-hover : Theme.bg-card;
                        border-width: 1px;
                        border-color: Theme.border;

                        animate background { duration: 100ms; }

                        pick-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.show-company-picker = false;
                                root.company-select-clicked(c.id);
                            }

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 16px;
                                spacing: 12px;
                                alignment: start;

                                Rectangle {
                                    width: 36px;
                                    height: 36px;
                                    border-radius: 18px;
                                    background: Theme.bg-primary;

                                    Text {
                                        text: c.initials;
                                        color: Theme.primary;
                                        font-size: 12px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 2px;
                                    Text {
                                        text: c.name;
                                        font-size: 14px;
                                        font-weight: 600;
                                        color: Theme.text-primary;
                                    }
                                    Text {
                                        text: c.edrpou != "" ? "ЄДРПОУ: " + c.edrpou : "";
                                        font-size: 12px;
                                        color: Theme.text-second;
                                    }
                                }

                                if root.active-company-id == c.id : Text {
                                    text: "✓";
                                    font-size: 16px;
                                    color: Theme.primary;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                Text {
                    text: "+ Додати нову компанію";
                    color: Theme.primary;
                    font-size: 14px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }

                Rectangle {
                    height: 44px;
                    background: Theme.bg-primary;
                    border-radius: 10px;

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.show-company-picker = false;
                            AppState.current-feature = "companies";
                        }

                        Text {
                            text: "⚙️  Управління компаніями";
                            font-size: 14px;
                            font-weight: 600;
                            color: Theme.primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    // ── Toast overlay (fixed bottom-right) ───────────────────────────────────
    // Toast читає AppState напряму. Завжди рендериться — opacity керує видимістю.
    // «lift from below» анімація: slide up 16px + fade 200ms при появі.
    Toast {
        host-width: root.width;
        host-height: root.height;
    }
    }
}

