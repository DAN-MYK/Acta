// counterparty_list.slint — Master-Detail layout контрагентів
//
// ┌────────────┬──────────────────────────────────────────┐
// │  Список    │  Деталі контрагента                      │
// │  (280px)   │                                          │
// │  ◉ Альфа   │  ТОВ "Альфа-Бізнес"  [Редагувати]      │
// │  ○ Бета    │  ЄДРПОУ: 12345678  •  Активний          │
// │            │  ─────────────────────────────────────── │
// │            │  [Акти] [Рахунки] [Платежі] [Дії] ...   │
// └────────────┴──────────────────────────────────────────┘

import { Theme } from "../theme.slint";
import { ProgressIndicator, ListView, ScrollView } from "std-widgets.slint";
import { StatusBadge } from "../components/status_badge.slint";
import { Icons } from "../components/icons.slint";
import { DocChain } from "../components/DocChain.slint";
import { CounterpartyDocSummary, CounterpartyPaymentSummary,
         CounterpartyContractSummary, CounterpartyTaskSummary } from "counterparty_card.slint";
import { CounterpartyActivityItem, ChainStep } from "../structs.slint";

export component CounterpartyList {
    // ── Список ────────────────────────────────────────────────────────────────
    in property <[[StandardListViewItem]]> rows;
    in property <[string]>                 row-ids;
    in property <[bool]>                   row-archived;
    in property <bool>                     loading: false;
    in property <int>                      total-count: 0;
    in property <int>                      active-count: 0;
    in property <int>                      archived-count: 0;
    in property <bool>                     show-archived: false;
    in property <string>                   pagination-text: "";
    in property <int>                      current-page: 1;
    in property <int>                      total-pages: 1;

    // ── Деталі (right panel) ──────────────────────────────────────────────────
    in property <string> detail-name:    "";
    in property <string> detail-edrpou:  "";
    in property <string> detail-ipn:     "";
    in property <string> detail-iban:    "";
    in property <string> detail-phone:   "";
    in property <string> detail-email:   "";
    in property <string> detail-address: "";
    in property <string> detail-stat-acts:      "0";
    in property <string> detail-stat-invoices:  "0";
    in property <string> detail-stat-payments:  "0";
    in property <string> detail-stat-contracts: "0";
    in property <[CounterpartyDocSummary]>      detail-acts:      [];
    in property <[CounterpartyDocSummary]>      detail-invoices:  [];
    in property <[CounterpartyPaymentSummary]>  detail-payments:  [];
    in property <[CounterpartyContractSummary]> detail-contracts: [];
    in property <[CounterpartyTaskSummary]>     detail-tasks:     [];
    in property <[CounterpartyActivityItem]>    detail-activity:  [];
    in property <[ChainStep]>                   detail-chain:     [];

    // ── Колбеки ───────────────────────────────────────────────────────────────
    callback search-changed(string);
    callback row-selected(string);
    callback edit-clicked(string);
    callback create-clicked();
    callback archive-clicked(string);
    callback filter-clicked();
    callback prev-page-clicked();
    callback next-page-clicked();
    callback chain-create-next(string);

    // ── Стан ──────────────────────────────────────────────────────────────────
    private property <int>    selected-row: -1;
    private property <string> selected-id:  "";
    private property <int>    detail-tab:   0;

    min-width: 600px;
    min-height: 400px;

    HorizontalLayout {
        spacing: 0;

        // ════════════════════════════════════════════════════════════════════
        // ЛІВА ПАНЕЛЬ — список (280px)
        // ════════════════════════════════════════════════════════════════════
        Rectangle {
            width: 280px;
            background: Theme.sidebar-bg;

            // Права межа
            Rectangle {
                x: parent.width - 1px; y: 0;
                width: 1px; height: parent.height;
                background: Theme.border;
            }

            VerticalLayout {
                spacing: 0;

                // ── Заголовок + кнопка ─────────────────────────────────────
                Rectangle {
                    height: Theme.topbar-height;
                    background: Theme.bg-card;
                    vertical-stretch: 0;

                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px; background: Theme.border;
                    }

                    HorizontalLayout {
                        padding-left: Theme.space-4;
                        padding-right: Theme.space-3;
                        spacing: Theme.space-2;
                        alignment: center;

                        Text {
                            text: "Контрагенти";
                            font-size: Theme.font-lg;
                            font-weight: 600;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        Rectangle {
                            width: 28px; height: 28px;
                            border-radius: Theme.radius-md;
                            background: new-ta.has-hover ? Theme.primary-hover : Theme.primary;
                            animate background { duration: 120ms; easing: ease; }

                            Image {
                                x: 7px; y: 7px;
                                width: 14px; height: 14px;
                                source: Icons.new-doc;
                                image-fit: contain;
                                colorize: Theme.text-white;
                            }

                            new-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.create-clicked(); }
                            }
                        }
                    }
                }

                // ── Пошук ─────────────────────────────────────────────────
                Rectangle {
                    height: Theme.input-height;
                    vertical-stretch: 0;
                    background: Theme.bg-card;

                    Rectangle {
                        x: Theme.space-3;
                        y: (parent.height - 28px) / 2;
                        width: parent.width - Theme.space-3 * 2;
                        height: 28px;
                        border-radius: Theme.radius-sm;
                        background: Theme.bg-page;
                        border-width: 1px;
                        border-color: Theme.border;
                        clip: true;

                        Image {
                            x: 8px;
                            y: (parent.height - 13px) / 2;
                            width: 13px; height: 13px;
                            source: Icons.search;
                            image-fit: contain;
                            colorize: Theme.text-muted;
                        }

                        HorizontalLayout {
                            padding-left: 28px;
                            padding-right: 8px;

                            search-input := TextInput {
                                accessible-label: "Пошук контрагентів";
                                vertical-alignment: center;
                                font-size: Theme.font-sm;
                                color: Theme.text-primary;
                                edited => { root.search-changed(search-input.text); }
                            }
                        }

                        if search-input.text == "" : Text {
                            x: 28px;
                            height: parent.height;
                            width: parent.width - 36px;
                            text: "Пошук...";
                            color: Theme.text-muted;
                            font-size: Theme.font-sm;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px; background: Theme.border;
                    }
                }

                // ── Лічильники (Всього / Активних / Архів) ────────────────
                Rectangle {
                    height: 36px;
                    vertical-stretch: 0;
                    background: Theme.table-header;

                    HorizontalLayout {
                        padding-left: Theme.space-3;
                        padding-right: Theme.space-3;
                        spacing: 0;
                        alignment: start;

                        Text {
                            text: "\{root.total-count} всього";
                            font-size: Theme.font-xs;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        // Перемикач Активні / Архів
                        Rectangle {
                            width: 68px; height: 24px;
                            border-radius: Theme.radius-sm;
                            background: filter-ta.has-hover ? Theme.bg-hover : Theme.bg-gray;
                            border-width: 1px;
                            border-color: Theme.border;
                            y: (parent.height - self.height) / 2;

                            Text {
                                x: 0; y: 0;
                                width: parent.width; height: parent.height;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                text: root.show-archived ? "Активні" : "Архів";
                                font-size: Theme.font-xs;
                                font-weight: 500;
                                color: Theme.text-second;
                            }

                            filter-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.filter-clicked(); }
                            }
                        }
                    }

                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px; background: Theme.border;
                    }
                }

                // ── Список рядків ─────────────────────────────────────────
                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.bg-card;

                    if root.loading : ProgressIndicator {
                        indeterminate: true;
                        vertical-stretch: 0;
                    }

                    if !root.loading && root.rows.length == 0 : VerticalLayout {
                        alignment: center;
                        spacing: Theme.space-2;
                        padding: Theme.space-4;

                        Text {
                            text: root.show-archived ? "В архіві нікого немає" : "Нічого не знайдено";
                            font-size: Theme.font-base;
                            font-weight: 600;
                            color: Theme.text-second;
                            horizontal-alignment: center;
                        }
                    }

                    ListView {
                        vertical-stretch: 1;

                        for row[i] in root.rows : Rectangle {
                            accessible-role: list-item;
                            accessible-label: "\{row[0].text}, \{row[1].text}";

                            property <bool> is-archived: i < root.row-archived.length && root.row-archived[i];

                            height: 52px;
                            background: root.selected-row == i
                                ? Theme.row-selected
                                : (item-ta.has-hover ? Theme.row-hover : Theme.bg-card);
                            border-width: 1px;
                            border-color: Theme.border;
                            animate background { duration: 80ms; easing: ease; }

                            // Активна смужка
                            if root.selected-row == i : Rectangle {
                                x: 0; y: 0; width: 3px; height: parent.height;
                                background: Theme.primary;
                                border-radius: 1px;
                            }

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 10px;
                                spacing: Theme.space-2;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: Theme.space-1;
                                    horizontal-stretch: 1;

                                    Text {
                                        text: row[0].text;
                                        color: Theme.text-primary;
                                        font-size: Theme.font-base;
                                        font-weight: root.selected-row == i ? 600 : 400;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: row[1].text != "" ? row[1].text : "—";
                                        color: Theme.text-muted;
                                        font-size: Theme.font-xs;
                                        overflow: elide;
                                    }
                                }

                                if is-archived : Rectangle {
                                    width: 44px; height: 18px;
                                    border-radius: Theme.radius-sm;
                                    background: Theme.bg-gray;
                                    y: (parent.height - self.height) / 2;

                                    Text {
                                        x: 0; y: 0;
                                        width: parent.width; height: parent.height;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        text: "архів";
                                        font-size: Theme.font-xs;
                                        color: Theme.text-muted;
                                    }
                                }
                            }

                            item-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.selected-row = i;
                                    root.detail-tab   = 0;
                                    if i < root.row-ids.length {
                                        root.selected-id = root.row-ids[i];
                                        root.row-selected(root.row-ids[i]);
                                    }
                                }
                            }
                        }
                    }
                }

                // ── Пагінація ─────────────────────────────────────────────
                Rectangle {
                    height: 36px;
                    vertical-stretch: 0;
                    background: Theme.bg-card;

                    Rectangle {
                        y: 0; height: 1px;
                        background: Theme.border;
                    }

                    HorizontalLayout {
                        padding-left: Theme.space-3;
                        padding-right: Theme.space-3;
                        spacing: Theme.space-1;
                        alignment: center;

                        Text {
                            text: root.pagination-text;
                            color: Theme.text-muted;
                            font-size: Theme.font-xs;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        Rectangle {
                            width: 56px; height: 24px;
                            border-radius: Theme.radius-sm;
                            background: prev-ta.has-hover && root.current-page > 1
                                ? Theme.bg-hover : transparent;

                            Text {
                                x: 0; y: 0;
                                width: parent.width; height: parent.height;
                                horizontal-alignment: center; vertical-alignment: center;
                                text: "← Назад";
                                color: root.current-page > 1 ? Theme.text-second : Theme.text-muted;
                                font-size: Theme.font-xs;
                            }

                            prev-ta := TouchArea {
                                enabled: root.current-page > 1;
                                mouse-cursor: self.enabled ? pointer : default;
                                clicked => { root.prev-page-clicked(); }
                            }
                        }

                        Text {
                            text: root.current-page + "/" + root.total-pages;
                            color: Theme.text-muted;
                            font-size: Theme.font-xs;
                            vertical-alignment: center;
                            width: 36px;
                            horizontal-alignment: center;
                        }

                        Rectangle {
                            width: 48px; height: 24px;
                            border-radius: Theme.radius-sm;
                            background: next-ta.has-hover && root.current-page < root.total-pages
                                ? Theme.bg-hover : transparent;

                            Text {
                                x: 0; y: 0;
                                width: parent.width; height: parent.height;
                                horizontal-alignment: center; vertical-alignment: center;
                                text: "Далі →";
                                color: root.current-page < root.total-pages ? Theme.text-second : Theme.text-muted;
                                font-size: Theme.font-xs;
                            }

                            next-ta := TouchArea {
                                enabled: root.current-page < root.total-pages;
                                mouse-cursor: self.enabled ? pointer : default;
                                clicked => { root.next-page-clicked(); }
                            }
                        }
                    }
                }
            }
        }

        // ════════════════════════════════════════════════════════════════════
        // ПРАВА ПАНЕЛЬ — деталі контрагента
        // ════════════════════════════════════════════════════════════════════
        Rectangle {
            horizontal-stretch: 1;
            background: Theme.bg-page;

            // Заглушка коли нічого не вибрано
            if root.detail-name == "" : VerticalLayout {
                alignment: center;
                spacing: Theme.space-3;
                padding: Theme.space-8;

                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 64px; height: 64px;
                        border-radius: 32px;
                        background: Theme.bg-gray;
                        Image {
                            x: 16px; y: 16px;
                            width: 32px; height: 32px;
                            source: Icons.counterparties;
                            image-fit: contain;
                            colorize: Theme.text-muted;
                        }
                    }
                }

                Text {
                    text: "Оберіть контрагента зі списку";
                    font-size: Theme.font-lg;
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Деталі, документи та платежі відображаються тут";
                    font-size: Theme.font-md;
                    color: Theme.text-disabled;
                    horizontal-alignment: center;
                }
            }

            // Деталі вибраного контрагента
            if root.detail-name != "" : VerticalLayout {
                spacing: 0;

                // ── Topbar деталей ───────────────────────────────────────
                Rectangle {
                    height: Theme.topbar-height;
                    background: Theme.bg-card;
                    vertical-stretch: 0;

                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px; background: Theme.border;
                    }

                    HorizontalLayout {
                        padding-left: Theme.space-6;
                        padding-right: Theme.space-6;
                        spacing: Theme.space-3;
                        alignment: center;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: Theme.space-1;

                            Text {
                                text: root.detail-name;
                                font-size: Theme.font-xl;
                                font-weight: 700;
                                color: Theme.text-primary;
                                overflow: elide;
                            }
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                alignment: start;

                                if root.detail-edrpou != "" : Text {
                                    text: "ЄДРПОУ " + root.detail-edrpou;
                                    font-size: Theme.font-sm;
                                    color: Theme.text-second;
                                }
                                if root.detail-ipn != "" : Text {
                                    text: "ІПН " + root.detail-ipn;
                                    font-size: Theme.font-sm;
                                    color: Theme.text-second;
                                }
                            }
                        }

                        // Архівувати
                        Rectangle {
                            width: 88px; height: Theme.btn-sm-height;
                            border-radius: Theme.radius-sm;
                            background: arch-ta.has-hover ? Theme.bg-danger : Theme.bg-gray;
                            border-width: 1px;
                            border-color: Theme.border;
                            animate background { duration: 120ms; easing: ease; }

                            Text {
                                x: 0; y: 0;
                                width: parent.width; height: parent.height;
                                horizontal-alignment: center; vertical-alignment: center;
                                text: "В архів";
                                font-size: Theme.font-sm;
                                color: arch-ta.has-hover ? Theme.danger : Theme.text-second;
                                animate color { duration: 120ms; easing: ease; }
                            }

                            arch-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    if root.selected-id != "" {
                                        root.archive-clicked(root.selected-id);
                                    }
                                }
                            }
                        }

                        // Редагувати
                        Rectangle {
                            width: 108px; height: Theme.btn-sm-height;
                            border-radius: Theme.radius-sm;
                            background: edit-ta.has-hover ? Theme.primary-hover : Theme.primary;
                            animate background { duration: 120ms; easing: ease; }

                            Text {
                                x: 0; y: 0;
                                width: parent.width; height: parent.height;
                                horizontal-alignment: center; vertical-alignment: center;
                                text: "Редагувати";
                                font-size: Theme.font-sm;
                                font-weight: 600;
                                color: Theme.text-white;
                            }

                            edit-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    if root.selected-id != "" {
                                        root.edit-clicked(root.selected-id);
                                    }
                                }
                            }
                        }
                    }
                }

                // ── MetricStrip мінімальний ──────────────────────────────
                Rectangle {
                    height: 52px;
                    background: Theme.bg-card;
                    vertical-stretch: 0;

                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px; background: Theme.border;
                    }

                    HorizontalLayout {
                        padding-left: Theme.space-6;
                        padding-right: Theme.space-6;

                        for item[i] in [
                            { label: "Акти",     value: root.detail-stat-acts,      accent: Theme.primary },
                            { label: "Рахунки",  value: root.detail-stat-invoices,  accent: Theme.purple  },
                            { label: "Платежі",  value: root.detail-stat-payments,  accent: Theme.success },
                            { label: "Договори", value: root.detail-stat-contracts, accent: Theme.warning },
                        ]: Rectangle {
                            horizontal-stretch: 1;
                            background: transparent;

                            if i > 0 : Rectangle {
                                x: 0; y: (parent.height - 28px) / 2;
                                width: 1px; height: 28px;
                                background: Theme.border;
                            }

                            HorizontalLayout {
                                alignment: center;
                                padding-left: i > 0 ? 16px : 0px;
                                spacing: Theme.space-2;

                                Text {
                                    text: item.label + ":";
                                    font-size: Theme.font-sm;
                                    color: Theme.text-muted;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: item.value;
                                    font-size: Theme.font-md;
                                    font-weight: 700;
                                    color: item.accent;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // ── Вкладки ───────────────────────────────────────────────
                Rectangle {
                    height: 40px;
                    background: Theme.bg-card;
                    vertical-stretch: 0;

                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px; background: Theme.border;
                    }

                    HorizontalLayout {
                        padding-left: Theme.space-6;
                        padding-right: Theme.space-6;
                        spacing: Theme.space-1;
                        alignment: start;

                        for lbl[i] in ["Акти", "Рахунки", "Платежі", "Договори", "Інформація", "Задачі", "Дії"]: Rectangle {
                            height: 32px;
                            width: max(64px, tab-text.preferred-width + 20px);

                            // Активна підчеркна лінія
                            if root.detail-tab == i : Rectangle {
                                x: 0; y: parent.height - 2px;
                                width: parent.width; height: 2px;
                                background: Theme.primary;
                            }

                            tab-text := Text {
                                x: 0; y: 0;
                                width: parent.width; height: parent.height;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                text: lbl;
                                font-size: Theme.font-base;
                                font-weight: root.detail-tab == i ? 600 : 400;
                                color: root.detail-tab == i ? Theme.primary : Theme.text-second;
                            }

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.detail-tab = i; }
                            }
                        }
                    }
                }

                // ── Вміст вкладки ─────────────────────────────────────────
                ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding: Theme.space-6;
                        spacing: Theme.space-3;
                        alignment: start;

                        // Вкладка 0 — Акти
                        if root.detail-tab == 0 : VerticalLayout {
                            spacing: Theme.space-2;

                            // Ланцюжок документів (якщо є дані)
                            if root.detail-chain.length > 0 : DocChain {
                                steps: root.detail-chain;
                                create-next(t) => { root.chain-create-next(t); }
                            }

                            for row in root.detail-acts : Rectangle {
                                height: 40px;
                                border-radius: Theme.radius-sm;
                                background: Theme.bg-card;
                                border-width: 1px;
                                border-color: Theme.border;

                                HorizontalLayout {
                                    padding-left: Theme.space-3;
                                    padding-right: Theme.space-3;
                                    spacing: Theme.space-2;

                                    Text { text: row.number; width: 140px; font-size: Theme.font-base; color: Theme.primary; font-weight: 500; vertical-alignment: center; }
                                    Text { text: row.date; width: 90px; font-size: Theme.font-sm; color: Theme.text-second; vertical-alignment: center; }
                                    Text { text: row.amount; horizontal-stretch: 1; font-size: Theme.font-base; color: Theme.text-primary; font-weight: 600; vertical-alignment: center; }
                                    Text { text: row.status; font-size: Theme.font-sm; color: Theme.text-second; vertical-alignment: center; }
                                }
                            }

                            if root.detail-acts.length == 0 : Text {
                                text: "Актів немає";
                                font-size: Theme.font-md;
                                color: Theme.text-muted;
                                horizontal-alignment: center;
                            }
                        }

                        // Вкладка 1 — Рахунки
                        if root.detail-tab == 1 : VerticalLayout {
                            spacing: Theme.space-2;

                            for row in root.detail-invoices : Rectangle {
                                height: 40px;
                                border-radius: Theme.radius-sm;
                                background: Theme.bg-card;
                                border-width: 1px;
                                border-color: Theme.border;

                                HorizontalLayout {
                                    padding-left: Theme.space-3;
                                    padding-right: Theme.space-3;
                                    spacing: Theme.space-2;
                                    Text { text: row.number; width: 140px; font-size: Theme.font-base; color: Theme.primary; font-weight: 500; vertical-alignment: center; }
                                    Text { text: row.date; width: 90px; font-size: Theme.font-sm; color: Theme.text-second; vertical-alignment: center; }
                                    Text { text: row.amount; horizontal-stretch: 1; font-size: Theme.font-base; color: Theme.text-primary; font-weight: 600; vertical-alignment: center; }
                                    Text { text: row.status; font-size: Theme.font-sm; color: Theme.text-second; vertical-alignment: center; }
                                }
                            }

                            if root.detail-invoices.length == 0 : Text {
                                text: "Рахунків немає";
                                font-size: Theme.font-md;
                                color: Theme.text-muted;
                                horizontal-alignment: center;
                            }
                        }

                        // Вкладка 2 — Платежі
                        if root.detail-tab == 2 : VerticalLayout {
                            spacing: Theme.space-2;

                            for row in root.detail-payments : Rectangle {
                                height: 40px;
                                border-radius: Theme.radius-sm;
                                background: Theme.bg-card;
                                border-width: 1px;
                                border-color: Theme.border;

                                HorizontalLayout {
                                    padding-left: Theme.space-3;
                                    padding-right: Theme.space-3;
                                    spacing: Theme.space-2;
                                    Text { text: row.date; width: 90px; font-size: Theme.font-sm; color: Theme.text-second; vertical-alignment: center; }
                                    Text { text: row.direction == "income" ? "↑ Надх." : "↓ Витр."; width: 72px; font-size: Theme.font-sm; color: row.direction == "income" ? Theme.success : Theme.danger; vertical-alignment: center; }
                                    Text { text: row.amount; width: 110px; font-size: Theme.font-base; font-weight: 600; color: Theme.text-primary; vertical-alignment: center; }
                                    Text { text: row.description; horizontal-stretch: 1; font-size: Theme.font-sm; color: Theme.text-second; vertical-alignment: center; overflow: elide; }
                                }
                            }

                            if root.detail-payments.length == 0 : Text {
                                text: "Платежів немає";
                                font-size: Theme.font-md;
                                color: Theme.text-muted;
                                horizontal-alignment: center;
                            }
                        }

                        // Вкладка 3 — Договори
                        if root.detail-tab == 3 : VerticalLayout {
                            spacing: Theme.space-2;

                            for row in root.detail-contracts : Rectangle {
                                height: 40px;
                                border-radius: Theme.radius-sm;
                                background: Theme.bg-card;
                                border-width: 1px;
                                border-color: Theme.border;

                                HorizontalLayout {
                                    padding-left: Theme.space-3;
                                    padding-right: Theme.space-3;
                                    spacing: Theme.space-2;
                                    Text { text: row.number; width: 110px; font-size: Theme.font-base; color: Theme.primary; font-weight: 500; vertical-alignment: center; }
                                    Text { text: row.subject; horizontal-stretch: 1; font-size: Theme.font-sm; color: Theme.text-second; vertical-alignment: center; overflow: elide; }
                                    Text { text: row.amount; width: 100px; font-size: Theme.font-base; font-weight: 600; color: Theme.text-primary; vertical-alignment: center; }
                                    Text { text: row.status; width: 80px; font-size: Theme.font-sm; color: Theme.text-second; vertical-alignment: center; }
                                }
                            }

                            if root.detail-contracts.length == 0 : Text {
                                text: "Договорів немає";
                                font-size: Theme.font-md;
                                color: Theme.text-muted;
                                horizontal-alignment: center;
                            }
                        }

                        // Вкладка 4 — Інформація
                        if root.detail-tab == 4 : VerticalLayout {
                            spacing: Theme.space-2;

                            for item in [
                                { label: "IBAN",    value: root.detail-iban    },
                                { label: "Телефон", value: root.detail-phone   },
                                { label: "Email",   value: root.detail-email   },
                                { label: "Адреса",  value: root.detail-address },
                            ]: Rectangle {
                                height: 40px;
                                border-radius: Theme.radius-sm;
                                background: Theme.bg-card;
                                border-width: 1px;
                                border-color: Theme.border;

                                HorizontalLayout {
                                    padding-left: Theme.space-3;
                                    padding-right: Theme.space-3;
                                    spacing: Theme.space-3;
                                    Text { text: item.label; width: 80px; font-size: Theme.font-sm; color: Theme.text-muted; font-weight: 500; vertical-alignment: center; }
                                    Text { text: item.value != "" ? item.value : "—"; horizontal-stretch: 1; font-size: Theme.font-base; color: Theme.text-primary; vertical-alignment: center; overflow: elide; }
                                }
                            }
                        }

                        // Вкладка 5 — Задачі
                        if root.detail-tab == 5 : VerticalLayout {
                            spacing: Theme.space-2;

                            for row in root.detail-tasks : Rectangle {
                                height: 40px;
                                border-radius: Theme.radius-sm;
                                background: Theme.bg-card;
                                border-width: 1px;
                                border-color: Theme.border;

                                HorizontalLayout {
                                    padding-left: Theme.space-3;
                                    padding-right: Theme.space-3;
                                    spacing: Theme.space-2;
                                    Text { text: row.title; horizontal-stretch: 1; font-size: Theme.font-base; color: Theme.text-primary; vertical-alignment: center; overflow: elide; }
                                    Text { text: row.due-date; width: 100px; font-size: Theme.font-sm; color: Theme.text-second; vertical-alignment: center; }
                                    Text { text: row.status; width: 80px; font-size: Theme.font-sm; color: Theme.text-second; vertical-alignment: center; }
                                }
                            }

                            if root.detail-tasks.length == 0 : Text {
                                text: "Задач немає";
                                font-size: Theme.font-md;
                                color: Theme.text-muted;
                                horizontal-alignment: center;
                            }
                        }

                        // Вкладка 6 — Дії (Activity feed)
                        if root.detail-tab == 6 : VerticalLayout {
                            spacing: 0;

                            for item[i] in root.detail-activity : Rectangle {
                                height: 44px;
                                background: Math.mod(i, 2) == 0 ? Theme.bg-card : Theme.row-stripe;
                                border-width: 1px;
                                border-color: Theme.border;
                                border-radius: i == 0 ? Theme.radius-sm : 0px;

                                HorizontalLayout {
                                    padding-left: Theme.space-3;
                                    padding-right: Theme.space-3;
                                    spacing: Theme.space-3;

                                    Rectangle {
                                        width: 60px;
                                        Text {
                                            x: 0; y: 0;
                                            width: parent.width; height: parent.height;
                                            horizontal-alignment: left;
                                            vertical-alignment: center;
                                            text: item.date-label;
                                            font-size: Theme.font-xs;
                                            font-weight: 600;
                                            color: Theme.text-muted;
                                        }
                                    }

                                    Rectangle {
                                        width: 3px;
                                        height: 24px;
                                        border-radius: 2px;
                                        background:
                                            item.doc-type == "act"      ? Theme.primary :
                                            item.doc-type == "invoice"  ? Theme.purple  :
                                            item.doc-type == "payment"  ? Theme.success :
                                            Theme.text-muted;
                                    }

                                    Text {
                                        text: item.description;
                                        horizontal-stretch: 1;
                                        font-size: Theme.font-md;
                                        color: Theme.text-primary;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }

                            if root.detail-activity.length == 0 : Rectangle {
                                height: Theme.space-8;
                                Text {
                                    x: 0; y: 0;
                                    width: parent.width; height: parent.height;
                                    text: "Активності немає";
                                    font-size: Theme.font-md;
                                    color: Theme.text-muted;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
