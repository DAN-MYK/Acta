    out property <color> toast-success-text:  #166534;
    out property <color> toast-error-text:    #991B1B;
    out property <color> toast-success-border: #A7F3D0;
    out property <color> chart-bar-bg:         #D6DFF7;

    // ── Тіні ─────────────────────────────────────────────
    out property <color> shadow-sm: rgba(0, 0, 0, 5%);
