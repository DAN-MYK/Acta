    out property <color> sidebar-border: #E4E1D9;
    out property <color> sidebar-switcher-bg: transparent;
    out property <color> sidebar-switcher-hover: #E8E5DE;
    out property <color> sidebar-text-muted:    #8A8B92;

    // ── Типографіка ──────────────────────────────────────
    out property <length> font-xs:      10px;
