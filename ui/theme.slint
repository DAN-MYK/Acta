    out property <color> shadow-lg: rgba(0, 0, 0, 18%);
    out property <color> shadow-xl: rgba(0, 0, 0, 20%);

    // ── Пріоритети задач ─────────────────────────────────
    out property <color> priority-high:     #C77A1C;
