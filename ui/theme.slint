    out property <color> bg-hover:      #EDEBE4;
    out property <color> bg-alt:        #EEECE6;
    out property <color> bg-gray:       #EEECE6;
    out property <color> bg-gray-soft:  #F4F2EC;

    // ── Статусні фони ────────────────────────────────────
    out property <color> bg-success:    #E4F5EC;
    out property <color> bg-warning:    #F7ECD9;
