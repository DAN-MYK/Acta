    out property <color> success:       #1EB16E;
    out property <color> warning:       #C77A1C;
    out property <color> danger:        #C0433B;
    out property <color> purple:        #7e4af0;

    // ── Фони — warm paper ────────────────────────────────
    out property <color> bg-page:       #F6F5F1;
