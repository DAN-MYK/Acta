    // ── Алiaси (зворотна сумісність) ─────────────────────
    out property <color> bg:           #F6F5F1;
    out property <color> surface:      #FFFFFF;
    out property <color> hover-bg:     #EDEBE4;
    out property <color> text-main:    #1A1B1F;
    out property <color> text-sub:     #5E5F66;
    out property <color> primary-light: #E6EDFD;
    out property <color> danger-light:  #F6E3E0;
    out property <color> danger-border: #F0C4C0;
    out property <brush> overlay: rgba(16, 20, 28, 60%);
