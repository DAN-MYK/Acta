    out property <length> radius-xl:   10px;
    out property <length> radius-full: 999px;

    // ── Layout ───────────────────────────────────────────
    out property <length> sidebar-width:    224px;
    out property <length> topbar-height:    52px;
    out property <length> row-height:       48px;
    out property <length> badge-height:     22px;
    out property <length> badge-sm-height:  18px;  // компактні бейджі (sidebar nav, tab counters)
