    out property <length> action-btn-size: 30px; // кнопка редагування/видалення

    // ── Форми ─────────────────────────────────────────────
    out property <length> form-field-height: Theme.input-height;
    out property <length> form-textarea-height: 88px;
    out property <length> form-group-spacing: Theme.space-4;
    out property <length> form-label-height: 18px;

    // ── Списки документів ──────────────────────────────────
