// Acta — Icon bundle
// Loaded once at compile time via @image-url.
// Re-exported globally so any component can use Icons.name.

export global Icons {
    // Navigation icons
    out property <image> home:            @image-url("assets/icons/Home.svg");
    out property <image> documents:       @image-url("assets/icons/Documents.svg");
    out property <image> counterparties:  @image-url("assets/icons/Counterparties.svg");
    out property <image> payments:        @image-url("assets/icons/Payments.svg");
    out property <image> reports:         @image-url("assets/icons/Reports.svg");
    out property <image> tasks:           @image-url("assets/icons/To-Do.svg");
    out property <image> settings:        @image-url("assets/icons/Settings.svg");

    // Action icons
    out property <image> search:          @image-url("assets/icons/Search.svg");
    out property <image> check:           @image-url("assets/icons/Check.svg");
    out property <image> close:           @image-url("assets/icons/Close.svg");
    out property <image> more:            @image-url("assets/icons/More.svg");
    out property <image> plus:            @image-url("assets/icons/New.svg");
    out property <image> edit:            @image-url("assets/icons/Edit.svg");
    out property <image> sort:            @image-url("assets/icons/Sort.svg");
    out property <image> refresh:         @image-url("assets/icons/Refresh.svg");
    out property <image> calendar:        @image-url("assets/icons/Calendar.svg");
    out property <image> link:            @image-url("assets/icons/Archive.svg");
    out property <image> pdf:             @image-url("assets/icons/PDF-Print.svg");
    out property <image> chart-bar:       @image-url("assets/icons/Chart-Bar.svg");
    out property <image> uah:             @image-url("assets/icons/UAH.svg");

    // Status icons
    out property <image> draft:           @image-url("assets/icons/Draft.svg");
    out property <image> issued:          @image-url("assets/icons/Issued.svg");
    out property <image> signed:          @image-url("assets/icons/Signed.svg");
    out property <image> paid:            @image-url("assets/icons/Paid.svg");
    out property <image> overdue:         @image-url("assets/icons/Overdue.svg");
    out property <image> incoming:        @image-url("assets/icons/Incoming.svg");
    out property <image> outgoing:        @image-url("assets/icons/Outgoing.svg");
    out property <image> arrow-left:      @image-url("assets/icons/Arrow-Left.svg");
    out property <image> arrow-right:     @image-url("assets/icons/Arrow-Right.svg");
}
